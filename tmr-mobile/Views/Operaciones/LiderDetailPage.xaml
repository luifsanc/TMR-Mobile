<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:tmr_shared.DTOs.Lideres;assembly=tmr-shared"
    x:Class="tmr_mobile.Views.Operaciones.LiderDetailPage"
    x:DataType="dto:LiderResponse"
    Title="Ficha Completa del Líder"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}">

    <Grid>
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- CABECERA DE NAVEGACIÓN -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center" Margin="0,4,0,4">
                    <Button
                        Grid.Column="0"
                        Text="‹"
                        Clicked="OnCerrarClicked"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                        FontSize="28"
                        FontAttributes="Bold"
                        Padding="0"
                        WidthRequest="36"
                        HeightRequest="36"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="Ficha del Líder"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                        VerticalOptions="Center" />
                </Grid>

                <!-- FICHA / HEADER DEL LÍDER -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                    StrokeThickness="1"
                    Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <!-- Avatar Circular -->
                        <Border
                            WidthRequest="64"
                            HeightRequest="64"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}"
                            StrokeThickness="0"
                            HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="32" />
                            </Border.StrokeShape>
                            <Label
                                Text="{Binding Inicial}"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                                FontSize="24"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <!-- Nombre Completo -->
                        <Label
                            Text="{Binding NombreCompleto}"
                            FontSize="20"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />

                        <!-- Badges Row -->
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <!-- Tipo Badge -->
                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}"
                                Stroke="Transparent"
                                Padding="10,4"
                                HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Label
                                    Text="{Binding TipoBadge}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}"
                                    FontAttributes="Bold"
                                    FontSize="11" />
                            </Border>

                            <!-- Estado Badge -->
                            <Border
                                BackgroundColor="{Binding ColorFondoEstado}"
                                Stroke="Transparent"
                                Padding="10,4"
                                HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Label
                                    Text="{Binding EstadoTexto}"
                                    TextColor="{Binding ColorEstado}"
                                    FontAttributes="Bold"
                                    FontSize="11" />
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- DATOS DE CONTACTO E INFORMACIÓN GENERAL -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                    StrokeThickness="1"
                    Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <BoxView WidthRequest="3" HeightRequest="14" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" CornerRadius="1.5" VerticalOptions="Center" />
                            <Label Text="Información General" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="10" ColumnSpacing="12">
                            <!-- Correo Electrónico -->
                            <Label Grid.Row="0" Grid.Column="0" Text="Correo:" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}" FontSize="13" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Email, TargetNullValue='No registrado'}" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}" FontSize="13" />

                            <!-- Teléfono -->
                            <Label Grid.Row="1" Grid.Column="0" Text="Teléfono:" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}" FontSize="13" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Telefono, TargetNullValue='No registrado'}" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}" FontSize="13" />

                            <!-- Identificación -->
                            <Label Grid.Row="2" Grid.Column="0" Text="Cédula / Doc:" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}" FontSize="13" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding NumeroIdentificacion, TargetNullValue='N/A'}" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- SECCIÓN DE PROYECTOS ASIGNADOS -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                    StrokeThickness="1"
                    Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <BoxView WidthRequest="3" HeightRequest="14" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" CornerRadius="1.5" VerticalOptions="Center" />
                            <Label Text="Proyectos que Lidera" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" VerticalOptions="Center" />
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" Padding="6,2" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Proyectos.Count}" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}" />
                            </Border>
                        </HorizontalStackLayout>

                        <CollectionView ItemsSource="{Binding Proyectos}">
                            <CollectionView.EmptyView>
                                <Label Text="Este líder no tiene proyectos asignados actualmente." FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" Padding="10,0" />
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:ProyectoAsignadoDTO">
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="12"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                                        StrokeThickness="1">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>

                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                                            <Border Grid.Row="0" Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}" Padding="6,2" StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Codigo}" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                                            </Border>

                                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Nombre}" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />

                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Cliente, StringFormat='Cliente: {0}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}" />

                                            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" BackgroundColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" Padding="6,2" VerticalOptions="Center" StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Estado}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- BOTÓN CERRAR -->
                <Button
                    Text="Cerrar Ficha"
                    Clicked="OnCerrarClicked"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}"
                    TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}"
                    CornerRadius="10"
                    HeightRequest="46"
                    FontSize="14"
                    FontAttributes="Bold" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
