<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    x:Class="tmr_mobile.Views.Operaciones.ClienteFormPage"
    x:DataType="vm:ClienteFormViewModel"
    Title="{Binding TituloPagina}"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}">

    <Grid>
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- CABECERA -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center" Margin="0,4,0,4">
                    <Button
                        Grid.Column="0"
                        Text="‹"
                        Command="{Binding RegresarCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                        FontSize="28"
                        FontAttributes="Bold"
                        FontFamily="InterSemiBold"
                        Padding="0"
                        WidthRequest="36"
                        HeightRequest="36"
                        VerticalOptions="Center" />
                    
                    <Label
                        Grid.Column="1"
                        Text="{Binding TituloPagina}"
                        FontSize="22"
                        FontAttributes="Bold"
                        FontFamily="InterSemiBold"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                        VerticalOptions="Center" />
                </Grid>

                <!-- SECCIÓN 1: INFORMACIÓN GENERAL -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                    StrokeThickness="1"
                    Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <!-- Título de Sección con Barra Azul -->
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <BoxView WidthRequest="3" HeightRequest="14" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" CornerRadius="1.5" VerticalOptions="Center" />
                            <Label Text="Información General" FontSize="14" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Tipo de Identificación -->
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="12" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Tipo de Identificador" />
                                        <Span Text=" *" TextColor="{StaticResource Error}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Padding="8,0" HeightRequest="46">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Picker
                                    ItemsSource="{Binding TiposIdentificacion}"
                                    ItemDisplayBinding="{Binding Valor}"
                                    SelectedItem="{Binding TipoIdentificacionSeleccionado}"
                                    Title="Seleccione un tipo"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}"
                                    TitleColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}"
                                    FontFamily="InterRegular"
                                    FontSize="13"
                                    VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Número de Identificación -->
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="12" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Núm. Identificación" />
                                        <Span Text=" *" TextColor="{StaticResource Error}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Padding="12,0" HeightRequest="46">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry
                                    Text="{Binding NumeroIdentificacion}"
                                    Placeholder="Ej: 1712345678001"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}"
                                    FontFamily="InterRegular"
                                    FontSize="13"
                                    VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Nombre Comercial -->
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="12" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Nombre Comercial" />
                                        <Span Text=" *" TextColor="{StaticResource Error}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Padding="12,0" HeightRequest="46">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry
                                    Text="{Binding NombreComercial}"
                                    Placeholder="Ej: Mi Empresa S.A."
                                    TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}"
                                    FontFamily="InterRegular"
                                    FontSize="13"
                                    VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                        
                        <!-- Estado (Solo visible en Edición) -->
                        <VerticalStackLayout Spacing="5" IsVisible="{Binding EsEdicion}">
                            <Label Text="Estado del Cliente" FontSize="12" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Switch IsToggled="{Binding Activo}" OnColor="{StaticResource Accent}" ThumbColor="{StaticResource White}" VerticalOptions="Center" />
                                
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource DarkSuccessSurface}}" StrokeThickness="0" Padding="10,4" IsVisible="{Binding Activo}" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="•" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                                        <Label Text="Activo" FontSize="12" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}" StrokeThickness="0" Padding="10,4" IsVisible="{Binding Activo, Converter={StaticResource InverseBoolConverter}}" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="•" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" VerticalOptions="Center" />
                                        <Label Text="Inactivo" FontSize="12" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- SECCIÓN 2: DATOS DE CONTACTO -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                    StrokeThickness="1"
                    Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <!-- Título de Sección con Barra Azul -->
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <BoxView WidthRequest="3" HeightRequest="14" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" CornerRadius="1.5" VerticalOptions="Center" />
                            <Label Text="Datos de Contacto" FontSize="14" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" ColumnSpacing="12">
                            <!-- Nombres -->
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label FontSize="12" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Nombres" />
                                            <Span Text=" *" TextColor="{StaticResource Error}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Border Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Padding="12,0" HeightRequest="46">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Entry Text="{Binding Nombres}" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}" FontFamily="InterRegular" FontSize="13" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Apellidos -->
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label FontSize="12" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Apellidos" />
                                            <Span Text=" *" TextColor="{StaticResource Error}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Border Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Padding="12,0" HeightRequest="46">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Entry Text="{Binding Apellidos}" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}" FontFamily="InterRegular" FontSize="13" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" ColumnSpacing="12">
                            <!-- Correo Electrónico -->
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label FontSize="12" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Correo Electrónico" />
                                            <Span Text=" *" TextColor="{StaticResource Error}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Border Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Padding="12,0" HeightRequest="46">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Entry Text="{Binding Email}" Keyboard="Email" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}" FontFamily="InterRegular" FontSize="13" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Teléfono -->
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label FontSize="12" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Teléfono" />
                                            <Span Text=" *" TextColor="{StaticResource Error}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Border Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Padding="12,0" HeightRequest="46">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Entry Text="{Binding Telefono}" Keyboard="Telephone" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}" FontFamily="InterRegular" FontSize="13" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Dirección -->
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="12" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Dirección" />
                                        <Span Text=" *" TextColor="{StaticResource Error}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Padding="12,0" HeightRequest="46">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry Text="{Binding Direccion}" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}" FontFamily="InterRegular" FontSize="13" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>
                
                <!-- BOTÓN GUARDAR -->
                <Button
                    Text="Guardar"
                    Command="{Binding GuardarCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                    TextColor="{StaticResource White}"
                    CornerRadius="8"
                    HeightRequest="48"
                    FontSize="15"
                    FontAttributes="Bold"
                    FontFamily="InterSemiBold"
                    Margin="0,8,0,24" />

            </VerticalStackLayout>
        </ScrollView>
        
        <!-- INDICADOR DE CARGA -->
        <ActivityIndicator
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <!-- MODAL OVERLAY DE ERROR DE VALIDACIÓN -->
        <ContentView
            IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource OverlaySoft}, Dark={StaticResource DarkOverlaySoft}}"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            InputTransparent="False">
            <Border
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                Padding="24"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="320"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,4" Radius="12" Opacity="0.15" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Error de Validación" FontSize="17" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{StaticResource Error}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}" FontSize="13" FontFamily="InterRegular" HorizontalTextAlignment="Center" />
                    <Button Text="Entendido" Command="{Binding LimpiarErrorCommand}" BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" TextColor="{StaticResource White}" CornerRadius="8" FontFamily="InterSemiBold" HeightRequest="40" />
                </VerticalStackLayout>
            </Border>
        </ContentView>
    </Grid>
</ContentPage>
