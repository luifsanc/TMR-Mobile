<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.Operaciones.ProyectosFormPage"
             x:Name="page"
             x:DataType="vm:ProyectosFormViewModel"
             Title="{Binding TituloPagina}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}">

    <Grid>
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- CABECERA -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center" Margin="0,4,0,4">
                    <Button
                        Grid.Column="0"
                        Text="‹"
                        Command="{Binding RegresarCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                        FontSize="28"
                        FontAttributes="Bold"
                        Padding="0"
                        WidthRequest="36"
                        HeightRequest="36"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding TituloPagina}"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                        VerticalOptions="Center" />
                </Grid>

                <!-- SECCIÓN 1: INFORMACIÓN GENERAL -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                    StrokeThickness="1"
                    Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <!-- Título de Sección con Barra Azul -->
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <BoxView WidthRequest="3" HeightRequest="14" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" CornerRadius="1.5" VerticalOptions="Center" />
                            <Label Text="Información General" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Nombre -->
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Nombre del Proyecto" />
                                        <Span Text=" *" TextColor="{StaticResource Error}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Padding="12,0" HeightRequest="46">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry
                                    Text="{Binding Nombre}"
                                    Placeholder="Ej: Desarrollo Backend TMR"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}"
                                    FontSize="13"
                                    VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Cliente -->
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Cliente" />
                                        <Span Text=" *" TextColor="{StaticResource Error}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Padding="12,0" HeightRequest="54">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Picker
                                    ItemsSource="{Binding ClientesDisponibles}"
                                    SelectedItem="{Binding ClienteSeleccionado, Mode=TwoWay}"
                                    ItemDisplayBinding="{Binding Nombre}"
                                    Title="Seleccione un cliente"
                                    IsEnabled="{Binding EsNuevo}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}"
                                    TitleColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}"
                                    FontSize="13"
                                    VerticalOptions="Fill" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Estado -->
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Estado" />
                                        <Span Text=" *" TextColor="{StaticResource Error}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Padding="12,0" HeightRequest="54">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Picker
                                    ItemsSource="{Binding Estados}"
                                    SelectedItem="{Binding Estado}"
                                    Title="Seleccione un estado"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}"
                                    TitleColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}"
                                    FontSize="13"
                                    VerticalOptions="Fill" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Fechas del proyecto -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="Fecha de Inicio *" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                <Border Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Padding="12,0" HeightRequest="46">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <DatePicker Date="{Binding FechaInicio}" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}" FontSize="13" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="Fecha de Fin *" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                <Border Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Padding="12,0" HeightRequest="46">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <DatePicker Date="{Binding FechaFin}" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}" FontSize="13" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- SECCIÓN 2: DATOS DEL PROYECTO -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                    StrokeThickness="1"
                    Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <!-- Título de Sección con Barra Azul -->
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <BoxView WidthRequest="3" HeightRequest="14" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" CornerRadius="1.5" VerticalOptions="Center" />
                            <Label Text="Detalles del Proyecto" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <CollectionView ItemsSource="{Binding LideresAsignados}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProyectoLiderFormItem">
                                    <Border Margin="0,0,0,12" Padding="12" Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="8">
                                            <Picker ItemsSource="{Binding LideresDisponibles}" SelectedItem="{Binding LiderSeleccionado, Mode=TwoWay}" ItemDisplayBinding="{Binding Nombre}" Title="Seleccione un líder" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}" TitleColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" FontSize="13" />
                                            <Label Text="Recursos del líder" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecursosAsignados}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ProyectoRecursoFormItem">
                                                        <Grid Padding="0,3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <Picker Grid.Column="0" ItemsSource="{Binding Opciones}" SelectedItem="{Binding Seleccionado, Mode=TwoWay}" ItemDisplayBinding="{Binding NombreConDepartamento}" Title="Seleccione un colaborador" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}" TitleColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" />
                                                            <Button Grid.Column="1" Text="X" Command="{Binding EliminarCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Error}" FontAttributes="Bold" FontSize="16" Padding="4,0" WidthRequest="32" HeightRequest="40" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                            <Button Text="+ Agregar recurso" Command="{Binding AgregarRecursoCommand}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" FontSize="12" HorizontalOptions="Start" Padding="0" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="+ Agregar líder" Command="{Binding AgregarLiderCommand}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" FontAttributes="Bold" HorizontalOptions="Start" Padding="0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Mensaje de Error -->
                <Label Text="{Binding ErrorMessage}" FontSize="12" TextColor="{StaticResource Error}" IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

                <!-- Botones de Acción -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                    <Button Grid.Column="0"
                            Text="Guardar"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="10"
                            HeightRequest="44"
                            Command="{Binding GuardarCommand}" />
                    <Button Grid.Column="1"
                            Text="Cancelar"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="10"
                            HeightRequest="44"
                            Command="{Binding CancelarCommand}" />
                </Grid>

                <!-- Padding inferior -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
