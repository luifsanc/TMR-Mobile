<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.Operaciones.ProyectosFormPage"
             x:DataType="vm:ProyectosFormViewModel"
             Title="{Binding TituloPagina}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid>
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- CABECERA -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center" Margin="0,4,0,4">
                    <Button
                        Grid.Column="0"
                        Text="‹"
                        Command="{Binding RegresarCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#163572"
                        FontSize="28"
                        FontAttributes="Bold"
                        Padding="0"
                        WidthRequest="36"
                        HeightRequest="36"
                        VerticalOptions="Center" />
                    
                    <Label
                        Grid.Column="1"
                        Text="{Binding TituloPagina}"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#163572"
                        VerticalOptions="Center" />
                </Grid>

                <!-- SECCIÓN 1: INFORMACIÓN GENERAL -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <!-- Título de Sección con Barra Azul -->
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <BoxView WidthRequest="3" HeightRequest="14" Color="#163572" CornerRadius="1.5" VerticalOptions="Center" />
                            <Label Text="Información General" FontSize="14" FontAttributes="Bold" TextColor="#163572" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Nombre -->
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="12" TextColor="#6B7280">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Nombre del Proyecto" />
                                        <Span Text=" *" TextColor="#DC2626" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="12,0" HeightRequest="46">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry
                                    Text="{Binding Nombre}"
                                    Placeholder="Ej: Desarrollo Backend TMR"
                                    TextColor="#374151"
                                    PlaceholderColor="#9CA3AF"
                                    FontSize="13"
                                    VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Cliente -->
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="12" TextColor="#6B7280">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Cliente" />
                                        <Span Text=" *" TextColor="#DC2626" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="12,0" HeightRequest="46">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry
                                    Text="{Binding Cliente}"
                                    Placeholder="Ej: Empresa X S.A."
                                    TextColor="#374151"
                                    PlaceholderColor="#9CA3AF"
                                    FontSize="13"
                                    VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Estado -->
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="12" TextColor="#6B7280">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Estado" />
                                        <Span Text=" *" TextColor="#DC2626" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="8,0" HeightRequest="46">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Picker
                                    ItemsSource="{Binding Estados}"
                                    SelectedItem="{Binding Estado}"
                                    Title="Seleccione un estado"
                                    TextColor="#374151"
                                    TitleColor="#9CA3AF"
                                    FontSize="13"
                                    VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- SECCIÓN 2: DATOS DEL PROYECTO -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <!-- Título de Sección con Barra Azul -->
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <BoxView WidthRequest="3" HeightRequest="14" Color="#163572" CornerRadius="1.5" VerticalOptions="Center" />
                            <Label Text="Detalles del Proyecto" FontSize="14" FontAttributes="Bold" TextColor="#163572" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Líder Asignado -->
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="12" TextColor="#6B7280">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Líder Asignado" />
                                        <Span Text=" *" TextColor="#DC2626" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="12,0" HeightRequest="46">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry
                                    Text="{Binding LiderAsignado}"
                                    Placeholder="Nombre del líder"
                                    TextColor="#374151"
                                    PlaceholderColor="#9CA3AF"
                                    FontSize="13"
                                    VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Recursos -->
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="12" TextColor="#6B7280">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Número de Recursos" />
                                        <Span Text=" *" TextColor="#DC2626" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="12,0" HeightRequest="46">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry
                                    Text="{Binding Recursos}"
                                    Placeholder="Cantidad de recursos"
                                    Keyboard="Numeric"
                                    TextColor="#374151"
                                    PlaceholderColor="#9CA3AF"
                                    FontSize="13"
                                    VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Fechas en Grid -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" ColumnSpacing="12">
                            <!-- Fecha Inicio -->
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label FontSize="12" TextColor="#6B7280">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Fecha de Inicio" />
                                            <Span Text=" *" TextColor="#DC2626" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="12,0" HeightRequest="46">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <DatePicker Date="{Binding FechaInicio}" TextColor="#374151" FontSize="13" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Fecha Fin -->
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label FontSize="12" TextColor="#6B7280">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Fecha de Fin" />
                                            <Span Text=" *" TextColor="#DC2626" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="12,0" HeightRequest="46">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <DatePicker Date="{Binding FechaFin}" TextColor="#374151" FontSize="13" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Mensaje de Error -->
                <Label Text="{Binding ErrorMessage}" FontSize="12" TextColor="#DC2626" IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

                <!-- Botones de Acción -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                    <Button Grid.Column="0"
                            Text="Guardar"
                            BackgroundColor="#163572"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="10"
                            HeightRequest="44"
                            Command="{Binding GuardarCommand}" />
                    <Button Grid.Column="1"
                            Text="Cancelar"
                            BackgroundColor="#F3F4F6"
                            TextColor="#163572"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="10"
                            HeightRequest="44"
                            Command="{Binding CancelarCommand}" />
                </Grid>

                <!-- Padding inferior -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>