<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    xmlns:dto="clr-namespace:tmr_shared.DTOs.Lideres;assembly=tmr-shared"
    xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
    x:Class="tmr_mobile.Views.Operaciones.LideresPage"
    x:DataType="vm:LideresViewModel"
    Title="Líderes"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource BackgroundLight}">

    <Grid RowDefinitions="*,36">
        <!-- Contenido principal y Botón Flotante en la fila superior -->
        <Grid Grid.Row="0">
            <Grid RowDefinitions="Auto,*" Padding="16,16,16,0" RowSpacing="14">

                <!-- TÍTULO DE LA PÁGINA (Sin fondo, texto azul corporativo {StaticResource Primary} con fuente Inter) -->
                <Label
                    Grid.Row="0"
                    Text="Líderes de Proyecto"
                    FontSize="28"
                    FontAttributes="Bold"
                    FontFamily="InterSemiBold"
                    TextColor="{StaticResource Primary}"
                    Margin="0,4,0,4" />

                <!-- LISTA DE LÍDERES CON HEADER SCROLLABLE -->
                <CollectionView
                    Grid.Row="1"
                    ItemsSource="{Binding Lideres}"
                    RemainingItemsThreshold="3"
                    RemainingItemsThresholdReachedCommand="{Binding CargarMasLideresCommand}"
                    SelectionMode="None">

                    <CollectionView.Header>
                        <VerticalStackLayout Spacing="14" Margin="0,0,0,14">
                            <!-- BUSCADOR CON BOTÓN DE DESCARGA -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <!-- Input de Búsqueda -->
                                <Border
                                    Grid.Column="0"
                                    HeightRequest="44"
                                    BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource BorderColor}"
                                    StrokeThickness="1"
                                    Padding="12,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                        <Image
                                            Grid.Column="0"
                                            Source="buscar_icon.png"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            VerticalOptions="Center" />
                                        <Entry
                                            Grid.Column="1"
                                            Text="{Binding TextoBusqueda}"
                                            Placeholder="Buscar por nombre, correo o cliente..."
                                            PlaceholderColor="{StaticResource TextLight}"
                                            TextColor="{StaticResource TextPrimary}"
                                            FontSize="13"
                                            FontFamily="InterRegular"
                                            BackgroundColor="Transparent"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <!-- Botón Descargar Reporte (Excel / PDF) -->
                                <Border
                                    Grid.Column="1"
                                    HeightRequest="44"
                                    BackgroundColor="{StaticResource Primary}"
                                    Stroke="Transparent"
                                    Padding="14,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ExportarReporteCommand}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Path Data="M12,4 L12,14 M7,9 L12,14 L17,9 M5,19 L19,19"
                                              Stroke="{StaticResource White}"
                                              StrokeThickness="2"
                                              StrokeLineCap="Round"
                                              StrokeLineJoin="Round"
                                              WidthRequest="16"
                                              HeightRequest="16"
                                              VerticalOptions="Center"
                                              Aspect="Uniform" />
                                        <Label Text="Descargar"
                                               TextColor="{StaticResource White}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- CARDS DE RESUMEN (Estadísticas 4 métricas) -->
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                <!-- Internos -->
                                <Border
                                    Grid.Column="0"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    Stroke="{StaticResource PrimaryLight}"
                                    StrokeThickness="1"
                                    Padding="6,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Internos" FontSize="10" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding TotalInternos}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Externos -->
                                <Border
                                    Grid.Column="1"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    Stroke="{StaticResource BorderColor}"
                                    StrokeThickness="1"
                                    Padding="6,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Externos" FontSize="10" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding TotalExternos}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Activos -->
                                <Border
                                    Grid.Column="2"
                                    BackgroundColor="{StaticResource SuccessSurface}"
                                    Stroke="{StaticResource SuccessSurface}"
                                    StrokeThickness="1"
                                    Padding="6,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Activos" FontSize="10" TextColor="{StaticResource SuccessText}" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding TotalActivos}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource SuccessText}" HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Inactivos -->
                                <Border
                                    Grid.Column="3"
                                    BackgroundColor="{StaticResource ErrorSurface}"
                                    Stroke="{StaticResource ErrorSurface}"
                                    StrokeThickness="1"
                                    Padding="6,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Inactivos" FontSize="10" TextColor="{StaticResource ErrorText}" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding TotalInactivos}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource ErrorText}" HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </CollectionView.Header>
                    ItemsSource="{Binding Lideres}"
                    RemainingItemsThreshold="3"
                    RemainingItemsThresholdReachedCommand="{Binding CargarMasLideresCommand}"
                    SelectionMode="None">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label
                                Text="No se encontraron líderes de proyecto."
                                TextColor="{StaticResource TextMuted}"
                                FontSize="14"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:LiderResponse">
                            <Border
                                Margin="0,0,0,10"
                                Padding="14"
                                BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource BorderColor}"
                                StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirOpcionesCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <!-- Avatar Iniciales -->
                                    <Border
                                        Grid.Column="0"
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="21" />
                                        </Border.StrokeShape>
                                        <Label
                                            Text="{Binding Inicial}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource Primary}"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />
                                    </Border>

                                    <!-- Información -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding NombreCompleto}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource Primary}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Text="{Binding Email}"
                                            FontSize="12"
                                            TextColor="{StaticResource TextMuted}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Text="{Binding ClientesResumen}"
                                            FontSize="11"
                                            TextColor="{StaticResource TextLight}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <!-- Estado y Tipo Badges -->
                                    <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center" HorizontalOptions="End">
                                        <Border
                                            BackgroundColor="{Binding ColorFondoEstado}"
                                            Stroke="Transparent"
                                            Padding="8,4"
                                            HorizontalOptions="End">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>
                                            <Label
                                                Text="{Binding EstadoTexto}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="{Binding ColorEstado}" />
                                        </Border>

                                        <Border
                                            BackgroundColor="{StaticResource Secondary}"
                                            Stroke="Transparent"
                                            Padding="6,2"
                                            HorizontalOptions="End">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="4" />
                                            </Border.StrokeShape>
                                            <Label
                                                Text="{Binding TipoBadge}"
                                                FontSize="10"
                                                TextColor="{StaticResource TextMuted}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>

            <!-- BOTÓN FLOTANTE NUEVO -->
            <Button
                Text="+"
                Command="{Binding AbrirCrearLiderCommand}"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                BackgroundColor="{StaticResource Primary}"
                TextColor="{StaticResource White}"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Padding="0">
                <Button.Shadow>
                    <Shadow Brush="{StaticResource TextPrimary}" Offset="0,4" Radius="6" Opacity="0.2" />
                </Button.Shadow>
            </Button>
        </Grid>

        <!-- BARRA DE NAVEGACIÓN INFERIOR COMPARTIDA -->
        <shared:BottomNavBar Grid.Row="1" />

        <!-- LOADING -->
        <ActivityIndicator
            Grid.RowSpan="2"
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            Color="{StaticResource Primary}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>
