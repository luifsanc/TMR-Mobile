<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             xmlns:dto="clr-namespace:tmr_shared.DTOs.Lideres;assembly=tmr-shared"
             x:Class="tmr_mobile.Views.Operaciones.LideresPage"
             x:DataType="vm:LideresViewModel"
             Title="{Binding Title}">

    <CollectionView ItemsSource="{Binding Lideres}" Margin="16">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="dto:LiderResponse">
                <Border Margin="0,0,0,12" Padding="16"
                        StrokeShape="RoundRectangle 10" Stroke="Transparent">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding NombreCompleto}" FontAttributes="Bold" FontSize="16" />
                        <Label Text="{Binding Email}" TextColor="#64748B" FontSize="14" />
                        <Label Text="{Binding Tipopersona}" TextColor="#2563EB" FontSize="13" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
