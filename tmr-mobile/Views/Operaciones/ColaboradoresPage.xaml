<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.Operaciones.ColaboradoresPage"
             x:DataType="vm:ColaboradoresViewModel"
             Title="{Binding Title}">

    <CollectionView ItemsSource="{Binding Colaboradores}" Margin="16">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:ColaboradorItem">
                <Frame Margin="0,0,0,12" Padding="16" CornerRadius="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding NombreCompleto}" FontAttributes="Bold" FontSize="16" />
                        <Label Text="{Binding Cargo}" TextColor="#2563EB" FontSize="14" />
                        <Label Text="{Binding Email}" TextColor="#64748B" FontSize="13" />
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
