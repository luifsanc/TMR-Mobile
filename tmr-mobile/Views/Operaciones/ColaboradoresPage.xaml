<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.Operaciones.ColaboradoresPage"
             x:DataType="vm:ColaboradoresViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="12">
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" BackgroundColor="#ECFDF5">
            <VerticalStackLayout Spacing="4">
                <Label Text="Colaboradores" Style="{StaticResource PageHeaderTitleStyle}" />
                <Label Text="Información de personal, cargo y participación en proyectos" Style="{StaticResource PageHeaderSubtitleStyle}" />
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Colaboradores}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="No se encontraron colaboradores." TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ColaboradorItem">
                    <Border Style="{StaticResource ListCardStyle}" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding NombreCompleto}" Style="{StaticResource PageTitleStyle}" FontSize="16" />
                            <Label Text="{Binding Cargo}" Style="{StaticResource PageSubtitleStyle}" FontSize="14" />
                            <Label Text="{Binding Email}" TextColor="{StaticResource Primary}" FontSize="13" />
                            <Label Text="{Binding CodigoEmpleado, StringFormat='Código: {0}'}" Style="{StaticResource PageSubtitleStyle}" FontSize="13" />
                            <Label Text="{Binding NumProyectos, StringFormat='Proyectos: {0}'}" TextColor="{StaticResource Success}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
