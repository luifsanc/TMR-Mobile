<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    xmlns:model="clr-namespace:tmr_mobile.Models.Operaciones"
    xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
    x:Class="tmr_mobile.Views.Operaciones.ColaboradoresPage"
    x:DataType="vm:ColaboradoresViewModel"
    Title="Colaboradores"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}">

    <Grid RowDefinitions="*,36">
        <!-- Contenido principal y Botón Flotante -->
        <Grid Grid.Row="0">
            <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="14">

                <!-- TÍTULO -->
                <Label
                    Grid.Row="0"
                    Text="Colaboradores"
                    FontSize="28"
                    FontAttributes="Bold"
                    FontFamily="InterSemiBold"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                    Margin="0,4,0,4" />

                <!-- BUSCADOR CON BOTONES DE FILTRO Y DESCARGA -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <!-- Buscador -->
                    <Border
                        Grid.Column="0"
                        HeightRequest="44"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                        StrokeThickness="1"
                        Padding="12,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                            <Image
                                Grid.Column="0"
                                Source="{AppThemeBinding Light=buscar_icon.png, Dark=buscar_icon_dark.png}"
                                WidthRequest="18"
                                HeightRequest="18"
                                VerticalOptions="Center" />
                            <Entry
                                Grid.Column="1"
                                Text="{Binding Busqueda}"
                                Placeholder="Buscar por nombre o identificación..."
                                PlaceholderColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                FontSize="13"
                                FontFamily="InterRegular"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Botón Filtro de Estado -->
                    <Border
                        Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <ImageButton
                            Source="{AppThemeBinding Light=filtro_icon.png, Dark=filtro_icon_dark.png}"
                            Command="{Binding CambiarFiltroEstadoCommand}"
                            Padding="11"
                            BackgroundColor="Transparent"
                            ToolTipProperties.Text="{Binding FiltroEstadoTexto}" />
                    </Border>

                    <!-- Botón Descargar (CSV / Reporte) -->
                    <Border
                        Grid.Column="2"
                        WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <ImageButton
                            Source="{AppThemeBinding Light=descargar_icon.png, Dark=descargar_icon_dark.png}"
                            Command="{Binding DescargarCommand}"
                            Padding="11"
                            BackgroundColor="Transparent" />
                    </Border>
                </Grid>

                <!-- CARDS DE RESUMEN METRICAS (2 FILAS RESPONSIVAS) -->
                <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <!-- Fila 1: Total colab. (33%) | Activos (33%) | Inactivos (33%) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <!-- Total colaboradores -->
                        <Border
                            Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                            StrokeThickness="1"
                            Padding="8,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                            </Border.Shadow>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                                <Border
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    BackgroundColor="{AppThemeBinding Light=#FFEDD5, Dark=#44331C}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Image
                                        Source="total_colab.png"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                    <Label
                                        Text="{Binding TotalColaboradores}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        FontFamily="InterSemiBold"
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                                    <Label
                                        Text="Total colab."
                                        FontSize="9"
                                        FontFamily="InterRegular"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Activos -->
                        <Border
                            Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                            StrokeThickness="1"
                            Padding="8,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                            </Border.Shadow>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                                <Border
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource DarkSuccessSurface}}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Image
                                        Source="colab_activos.png"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                    <Label
                                        Text="{Binding TotalActivos}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        FontFamily="InterSemiBold"
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                                    <Label
                                        Text="Activos"
                                        FontSize="9"
                                        FontFamily="InterRegular"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Inactivos -->
                        <Border
                            Grid.Column="2"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                            StrokeThickness="1"
                            Padding="8,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                            </Border.Shadow>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                                <Border
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#3A3B3C}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Image
                                        Source="colab_inactivos.png"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                    <Label
                                        Text="{Binding TotalInactivos}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        FontFamily="InterSemiBold"
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                                    <Label
                                        Text="Inactivos"
                                        FontSize="9"
                                        FontFamily="InterRegular"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Fila 2: Asignados (50%) | No asignados (50%) -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                        <!-- Asignados -->
                        <Border
                            Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                            StrokeThickness="1"
                            Padding="10,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                            </Border.Shadow>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                                <Border
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Image
                                        Source="colab_asignados.png"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                    <Label
                                        Text="{Binding TotalAsignados}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        FontFamily="InterSemiBold"
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                                    <Label
                                        Text="Asignados"
                                        FontSize="10"
                                        FontFamily="InterRegular"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- No asignados -->
                        <Border
                            Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                            StrokeThickness="1"
                            Padding="10,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                            </Border.Shadow>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                                <Border
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#3A3B3C}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Image
                                        Source="colab_no_asignados.png"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                    <Label
                                        Text="{Binding TotalNoAsignados}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        FontFamily="InterSemiBold"
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                                    <Label
                                        Text="No asignados"
                                        FontSize="10"
                                        FontFamily="InterRegular"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Grid>

                <!-- LISTA DE COLABORADORES -->
                <CollectionView
                    Grid.Row="3"
                    ItemsSource="{Binding Colaboradores}"
                    SelectionMode="None"
                    VerticalScrollBarVisibility="Never">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label
                                Text="No se encontraron colaboradores."
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                FontSize="14"
                                FontFamily="InterRegular"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:ColaboradorModel">
                            <Border
                                Margin="0,0,0,12"
                                Padding="14,14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                                StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirDetalleCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <!-- Avatar Iniciales -->
                                    <Border
                                        Grid.Column="0"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="22" />
                                        </Border.StrokeShape>
                                        <Label
                                            Text="{Binding Iniciales}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            FontFamily="InterSemiBold"
                                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />
                                    </Border>

                                    <!-- Información del Colaborador -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding NombreCompleto}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            FontFamily="InterSemiBold"
                                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Text="{Binding IdentificacionTexto, StringFormat='C.I.: {0}'}"
                                            FontSize="12"
                                            FontFamily="InterRegular"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Text="{Binding EmailTexto}"
                                            FontSize="12"
                                            FontFamily="InterRegular"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Text="{Binding CargoTexto}"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            FontFamily="InterSemiBold"
                                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <!-- Status Badge Pill de Clientes con Punto Indicador (•) -->
                                    <Border
                                        Grid.Column="2"
                                        BackgroundColor="{Binding ColorFondoEstado}"
                                        StrokeThickness="0"
                                        Padding="10,4"
                                        VerticalOptions="Start"
                                        Margin="0,2,0,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                            <Label
                                                Text="•"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{Binding ColorEstado}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Text="{Binding EstadoTexto}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                FontFamily="InterSemiBold"
                                                TextColor="{Binding ColorEstado}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>

            <!-- BOTÓN FLOTANTE NUEVO -->
            <Button
                Text="+"
                Command="{Binding NuevoCommand}"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                TextColor="{StaticResource White}"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Padding="0">
                <Button.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,4" Radius="6" Opacity="0.2" />
                </Button.Shadow>
            </Button>
        </Grid>

        <!-- BARRA DE NAVEGACIÓN INFERIOR COMPARTIDA -->
        <shared:UserBottomNavBar Grid.Row="1" />

        <!-- LOADING -->
        <ActivityIndicator
            Grid.RowSpan="2"
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>
