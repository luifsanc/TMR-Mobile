<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    x:Class="tmr_mobile.Views.Operaciones.ColaboradorSalidaPage"
    x:DataType="vm:ColaboradorSalidaViewModel"
    Title="Registrar Salida"
    BackgroundColor="{StaticResource BackgroundLight}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- CABECERA -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Button
                        Grid.Column="0"
                        Text="‹"
                        Command="{Binding RegresarCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        FontSize="24"
                        FontAttributes="Bold"
                        Padding="0"
                        WidthRequest="36"
                        HeightRequest="36"
                        VerticalOptions="Center" />

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label
                            Text="Registrar Salida"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Primary}" />
                        <HorizontalStackLayout Spacing="6">
                            <Label
                                Text="{Binding Colaborador.NombreCompleto}"
                                FontSize="12"
                                TextColor="{StaticResource TextMuted}" />
                            <Label
                                Text="•"
                                FontSize="12"
                                TextColor="{StaticResource TextMuted}" />
                            <Label
                                Text="{Binding Colaborador.NumeroIdentificacion}"
                                FontSize="12"
                                TextColor="{StaticResource TextMuted}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <!-- CARD FORMULARIO DE SALIDA -->
                <Border BackgroundColor="{StaticResource White}" Stroke="{StaticResource BorderColor}" StrokeThickness="1" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="▼ Datos de salida" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" />

                        <!-- Fecha de salida -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Fecha de salida *" FontSize="12" TextColor="{StaticResource TextMuted}" />
                            <Border Stroke="{StaticResource BorderColor}" StrokeThickness="1" BackgroundColor="Transparent" Padding="12,0" HeightRequest="44">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <DatePicker Date="{Binding FechaSalida}" Format="dd/MM/yyyy" TextColor="{StaticResource TextMain}" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Tipo de salida -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Tipo de salida *" FontSize="12" TextColor="{StaticResource TextMuted}" />
                            <Border Stroke="{StaticResource BorderColor}" StrokeThickness="1" BackgroundColor="Transparent" Padding="8,0" HeightRequest="44">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Picker
                                    ItemsSource="{Binding TiposSalida}"
                                    ItemDisplayBinding="{Binding Valor}"
                                    SelectedItem="{Binding TipoSalidaSeleccionado}"
                                    Title="Seleccione un tipo de salida"
                                    TextColor="{StaticResource TextMain}"
                                    TitleColor="{StaticResource TextLight}"
                                    VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Causa de salida -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Causa de salida *" FontSize="12" TextColor="{StaticResource TextMuted}" />
                            <Border Stroke="{StaticResource BorderColor}" StrokeThickness="1" BackgroundColor="Transparent" Padding="8,0" HeightRequest="44">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Picker
                                    ItemsSource="{Binding CausasSalida}"
                                    ItemDisplayBinding="{Binding Valor}"
                                    SelectedItem="{Binding CausaSalidaSeleccionada}"
                                    Title="Seleccione una causa de salida"
                                    TextColor="{StaticResource TextMain}"
                                    TitleColor="{StaticResource TextLight}"
                                    VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Comentario (Opcional) -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Comentario (opcional)" FontSize="12" TextColor="{StaticResource TextMuted}" />
                                <Label Grid.Column="1" Text="Máximo 500 caracteres" FontSize="11" TextColor="{StaticResource TextLight}" />
                            </Grid>
                            <Border Stroke="{StaticResource BorderColor}" StrokeThickness="1" BackgroundColor="Transparent" Padding="12,8" HeightRequest="100">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Editor
                                    Text="{Binding Comentario}"
                                    Placeholder="Ingrese un comentario detallado sobre la salida..."
                                    PlaceholderColor="{StaticResource TextLight}"
                                    TextColor="{StaticResource TextMain}"
                                    MaxLength="500"
                                    AutoSize="Disabled" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- BOTÓN GUARDAR -->
                <Button
                    Text="Guardar"
                    Command="{Binding GuardarSalidaCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource White}"
                    CornerRadius="8"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    Margin="0,8,0,24" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- LOADING -->
        <ActivityIndicator
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            Color="{StaticResource Primary}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <!-- ERROR -->
        <ContentView
            IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
            BackgroundColor="{StaticResource Overlay}"
            InputTransparent="False">
            <Border BackgroundColor="{StaticResource White}" Padding="24" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="300">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Error" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Error}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource TextMain}" HorizontalTextAlignment="Center" />
                    <Button Text="Cerrar" Command="{Binding LimpiarErrorCommand}" BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource White}" CornerRadius="8" />
                </VerticalStackLayout>
            </Border>
        </ContentView>
    </Grid>

</ContentPage>
