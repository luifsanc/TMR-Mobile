<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    xmlns:model="clr-namespace:tmr_mobile.Models.Operaciones"
    x:Class="tmr_mobile.Views.Operaciones.ClientesPage"
    x:DataType="vm:ClientesViewModel"
    Title="Clientes"
    BackgroundColor="#F4F6FA">

    <Grid>
        <Grid
            RowDefinitions="Auto,Auto,Auto,*"
            Padding="16"
            RowSpacing="16">

            <!-- TÍTULO -->
            <Label
                Grid.Row="0"
                Text="Clientes"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#173A54" />

            <!-- RESUMEN -->
            <Grid
                Grid.Row="1"
                ColumnDefinitions="*,*,*"
                ColumnSpacing="8">

                <!-- TOTAL -->
                <Border
                    Grid.Column="0"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="{Binding TotalClientes}"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#173A54"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="Total"
                            FontSize="11"
                            TextColor="#64748B"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- ACTIVOS -->
                <Border
                    Grid.Column="1"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="{Binding TotalActivos}"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#173A54"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="Activos"
                            FontSize="11"
                            TextColor="#43A047"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- INACTIVOS -->
                <Border
                    Grid.Column="2"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="{Binding TotalInactivos}"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#173A54"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="Inactivos"
                            FontSize="11"
                            TextColor="#E53935"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- BUSCADOR CON BOTONES DE FILTRO Y DESCARGA -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <!-- Buscador -->
                <Border
                    Grid.Column="0"
                    HeightRequest="46"
                    BackgroundColor="White"
                    Stroke="#DCE3EC"
                    StrokeThickness="1"
                    Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry
                        Text="{Binding Busqueda}"
                        Placeholder="Buscar cliente por nombre, RUC o email..."
                        PlaceholderColor="#9CA3AF"
                        TextColor="#173A54"
                        FontSize="13"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center" />
                </Border>

                <!-- Botón de Filtro de Estado -->
                <Button
                    Grid.Column="1"
                    Text="⊕"
                    Command="{Binding CambiarFiltroEstadoCommand}"
                    WidthRequest="46"
                    HeightRequest="46"
                    CornerRadius="10"
                    BackgroundColor="White"
                    TextColor="#173A54"
                    BorderColor="#DCE3EC"
                    BorderWidth="1"
                    FontSize="18"
                    Padding="0"
                    ToolTipProperties.Text="{Binding FiltroEstadoTexto}" />

                <!-- Botón de Descarga / Exportar -->
                <Button
                    Grid.Column="2"
                    Text="⤓"
                    Command="{Binding DescargarCommand}"
                    WidthRequest="46"
                    HeightRequest="46"
                    CornerRadius="10"
                    BackgroundColor="White"
                    TextColor="#173A54"
                    BorderColor="#DCE3EC"
                    BorderWidth="1"
                    FontSize="18"
                    Padding="0" />
            </Grid>

            <!-- CARDS -->
            <CollectionView
                Grid.Row="3"
                ItemsSource="{Binding Clientes}"
                SelectionMode="None"
                VerticalScrollBarVisibility="Never">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="30"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Label
                            Text="No se encontraron clientes."
                            TextColor="#64748B"
                            FontSize="14"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:ClienteModel">
                        <Border
                            Margin="0,0,0,12"
                            Padding="0"
                            BackgroundColor="White"
                            Stroke="#E1E6EC"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="Black"
                                    Offset="0,2"
                                    Radius="7"
                                    Opacity="0.08" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirDetalleCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="6,Auto">
                                <!-- FRANJA ESTADO -->
                                <BoxView
                                    Grid.Row="0"
                                    Color="{Binding ColorEstado}" />

                                <VerticalStackLayout
                                    Grid.Row="1"
                                    Padding="16,13"
                                    Spacing="10">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <!-- NOMBRE COMERCIAL -->
                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding NombreComercial}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="#173A54"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />

                                        <!-- BADGE ESTADO -->
                                        <Border
                                            Grid.Column="1"
                                            BackgroundColor="{Binding ColorFondoEstado}"
                                            Stroke="Transparent"
                                            Padding="8,4"
                                            VerticalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label
                                                Text="{Binding EstadoTexto}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="{Binding ColorEstado}" />
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                                        <!-- IDENTIFICACIÓN -->
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                            <Label
                                                Text="Identificación"
                                                FontSize="11"
                                                TextColor="#94A3B8" />
                                            <Label
                                                Text="{Binding NumeroIdentificacion}"
                                                FontSize="13"
                                                TextColor="#334155" />
                                        </VerticalStackLayout>

                                        <!-- TELÉFONO -->
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                            <Label
                                                Text="Teléfono"
                                                FontSize="11"
                                                TextColor="#94A3B8" />
                                            <Label
                                                Text="{Binding Telefono}"
                                                FontSize="13"
                                                TextColor="#334155" />
                                        </VerticalStackLayout>

                                        <!-- CORREO -->
                                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2">
                                            <Label
                                                Text="Correo Electrónico"
                                                FontSize="11"
                                                TextColor="#94A3B8" />
                                            <Label
                                                Text="{Binding Email}"
                                                FontSize="13"
                                                TextColor="#334155"
                                                MaxLines="1"
                                                LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- FLOATING ACTION BUTTON -->
        <Button
            Text="+"
            Command="{Binding NuevoCommand}"
            WidthRequest="56"
            HeightRequest="56"
            CornerRadius="28"
            BackgroundColor="#173A54"
            TextColor="White"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="20"
            Padding="0">
            <Button.Shadow>
                <Shadow
                    Brush="Black"
                    Offset="0,4"
                    Radius="6"
                    Opacity="0.2" />
            </Button.Shadow>
        </Button>

        <!-- LOADING -->
        <ActivityIndicator
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            Color="#173A54"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
    </Grid>

</ContentPage>
