<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    xmlns:model="clr-namespace:tmr_mobile.Models.Operaciones"
    xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
    x:Class="tmr_mobile.Views.Operaciones.ClientesPage"
    x:DataType="vm:ClientesViewModel"
    Title="Clientes"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}">

    <Grid RowDefinitions="*,56">
        <!-- Contenido principal y Botón Flotante en la fila superior -->
        <Grid Grid.Row="0">
            <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="14">

                <!-- TÍTULO DE LA PÁGINA (Sin fondo, texto azul corporativo {StaticResource Primary} con fuente Inter) -->
                <Label
                    Grid.Row="0"
                    Text="Clientes"
                    FontSize="28"
                    FontAttributes="Bold"
                    FontFamily="InterSemiBold"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                    Margin="0,4,0,4" />

                <!-- BARRA DE BÚSQUEDA Y BOTONES DE FILTRO Y DESCARGA -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <!-- Input de Búsqueda -->
                    <Border
                        Grid.Column="0"
                        HeightRequest="44"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                        StrokeThickness="1"
                        Padding="12,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                            <Image
                                Grid.Column="0"
                                Source="{AppThemeBinding Light=buscar_icon.png, Dark=buscar_icon_dark.png}"
                                WidthRequest="18"
                                HeightRequest="18"
                                VerticalOptions="Center" />
                            <Entry
                                Grid.Column="1"
                                Text="{Binding Busqueda}"
                                Placeholder="Buscar por nombre, identificador..."
                                PlaceholderColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                FontSize="13"
                                FontFamily="InterRegular"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Botón de Filtro de Estado -->
                    <Border
                        Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <ImageButton
                            Source="{AppThemeBinding Light=filtro_icon.png, Dark=filtro_icon_dark.png}"
                            Command="{Binding CambiarFiltroEstadoCommand}"
                            Padding="11"
                            BackgroundColor="Transparent"
                            ToolTipProperties.Text="{Binding FiltroEstadoTexto}" />
                    </Border>

                    <!-- Botón de Descargar / Exportar -->
                    <Border
                        Grid.Column="2"
                        WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <ImageButton
                            Source="{AppThemeBinding Light=descargar_icon.png, Dark=descargar_icon_dark.png}"
                            Command="{Binding DescargarCommand}"
                            Padding="11"
                            BackgroundColor="Transparent" />
                    </Border>
                </Grid>

                <!-- CARDS ESTADÍSTICAS (Total Clientes, Activos, Inactivos) -->
                <Grid Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
                    <!-- Total Clientes -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                        StrokeThickness="1"
                        Padding="14,14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                        </Border.Shadow>
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Border
                                WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Image
                                    Source="total_clientes.png"
                                    WidthRequest="24"
                                    HeightRequest="24"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                <Label
                                    Text="{Binding TotalClientes}"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    FontFamily="InterSemiBold"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                                <Label
                                    Text="Total clientes"
                                    FontSize="12"
                                    FontFamily="InterRegular"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Activos -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                        StrokeThickness="1"
                        Padding="14,14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                        </Border.Shadow>
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Border
                                WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource DarkSuccessSurface}}"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Image
                                    Source="cliente_activos.png"
                                    WidthRequest="24"
                                    HeightRequest="24"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                <Label
                                    Text="{Binding TotalActivos}"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    FontFamily="InterSemiBold"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                                <Label
                                    Text="Activos"
                                    FontSize="12"
                                    FontFamily="InterRegular"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Inactivos -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                        StrokeThickness="1"
                        Padding="14,14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                        </Border.Shadow>
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Border
                                WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Image
                                    Source="cliente_inactivos.png"
                                    WidthRequest="24"
                                    HeightRequest="24"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                <Label
                                    Text="{Binding TotalInactivos}"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    FontFamily="InterSemiBold"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                                <Label
                                    Text="Inactivos"
                                    FontSize="12"
                                    FontFamily="InterRegular"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- CARDS DE CLIENTES CON TIPOGRAFÍA INTER -->
                <CollectionView
                    Grid.Row="3"
                    ItemsSource="{Binding Clientes}"
                    SelectionMode="None"
                    VerticalScrollBarVisibility="Never">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label
                                Text="No se encontraron clientes."
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                FontSize="14"
                                FontFamily="InterRegular"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:ClienteModel">
                            <Border
                                Margin="0,0,0,12"
                                Padding="14,14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                                StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirDetalleCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <!-- Avatar Iniciales -->
                                    <Border
                                        Grid.Column="0"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="22" />
                                        </Border.StrokeShape>
                                        <Label
                                            Text="{Binding Iniciales}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            FontFamily="InterSemiBold"
                                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />
                                    </Border>

                                    <!-- Información del Cliente -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding NombreComercial}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            FontFamily="InterSemiBold"
                                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Text="{Binding RucFormateado}"
                                            FontSize="12"
                                            FontFamily="InterRegular"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                        <Label
                                            Text="{Binding Email}"
                                            FontSize="12"
                                            FontFamily="InterRegular"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <!-- Status Badge Pill con Punto Indicador (•) -->
                                    <Border
                                        Grid.Column="2"
                                        BackgroundColor="{Binding ColorFondoEstado}"
                                        StrokeThickness="0"
                                        Padding="10,4"
                                        VerticalOptions="Start"
                                        Margin="0,2,0,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                            <Label
                                                Text="•"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{Binding ColorEstado}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Text="{Binding EstadoTexto}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                FontFamily="InterSemiBold"
                                                TextColor="{Binding ColorEstado}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>

            <!-- FLOATING ACTION BUTTON (+) -->
            <Button
                Text="+"
                Command="{Binding NuevoCommand}"
                WidthRequest="52"
                HeightRequest="52"
                CornerRadius="26"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                TextColor="{StaticResource White}"
                FontSize="24"
                FontAttributes="Bold"
                FontFamily="InterSemiBold"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Padding="0">
                <Button.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,4" Radius="6" Opacity="0.2" />
                </Button.Shadow>
            </Button>
        </Grid>

        <!-- BARRA DE NAVEGACIÓN INFERIOR COMPARTIDA -->
        <shared:UserBottomNavBar Grid.Row="1" />

        <!-- INDICADOR DE CARGA -->
        <ActivityIndicator
            Grid.RowSpan="2"
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
    </Grid>

</ContentPage>
