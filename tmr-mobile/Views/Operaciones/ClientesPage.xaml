<ContentPage xmlns:shared="clr-namespace:tmr_mobile.Views.Shared" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             xmlns:dto="clr-namespace:tmr_shared.DTOs.Clientes;assembly=tmr-shared"
             x:Class="tmr_mobile.Views.Operaciones.ClientesPage"
             x:DataType="vm:ClientesViewModel"
             Title="{Binding Title}">
    <Grid RowDefinitions="*,80">
        <ContentView Grid.Row="0">
<CollectionView ItemsSource="{Binding Clientes}" Margin="16">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="dto:ClienteListaResponse">
                <Border Margin="0,0,0,12" Padding="16"
                        StrokeShape="RoundRectangle 10" Stroke="Transparent">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding NombreComercial}" FontAttributes="Bold" FontSize="16" />
                        <Label Text="{Binding NumeroIdentificacion, StringFormat='{0}'}" TextColor="#64748B" FontSize="14" />
                        <Label Text="{Binding Email}" TextColor="#2563EB" FontSize="13" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>


        </ContentView>
        <shared:BottomNavBar Grid.Row="1" />
    </Grid>
</ContentPage>
