<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.Operaciones.ClientesPage"
             x:DataType="vm:ClientesViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="12">
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" BackgroundColor="#EFF6FF">
            <VerticalStackLayout Spacing="4">
                <Label Text="Clientes" Style="{StaticResource PageHeaderTitleStyle}" />
                <Label Text="Detalle de clientes, contacto y datos de identificación" Style="{StaticResource PageHeaderSubtitleStyle}" />
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Clientes}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="No se encontraron clientes." TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ClienteItem">
                    <Border Style="{StaticResource ListCardStyle}" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding NombreComercial}" Style="{StaticResource PageTitleStyle}" FontSize="16" />
                            <Label Text="{Binding NumeroIdentificacion, StringFormat='Identificación: {0}'}" Style="{StaticResource PageSubtitleStyle}" FontSize="14" />
                            <Label Text="{Binding Email}" TextColor="{StaticResource Primary}" FontSize="13" />
                            <Label Text="{Binding Telefono, StringFormat='Teléfono: {0}'}" Style="{StaticResource PageSubtitleStyle}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
