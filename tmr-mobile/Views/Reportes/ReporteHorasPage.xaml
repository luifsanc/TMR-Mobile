<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    xmlns:dto="clr-namespace:tmr_shared.DTOs.Reportes;assembly=tmr-shared"
    xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
    x:Class="tmr_mobile.Views.Reportes.ReporteHorasPage"
    x:DataType="vm:ReporteHorasViewModel"
    Title="Reporte por Horas"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}">

    <Grid RowDefinitions="*,36">
        <Grid Grid.Row="0">
            <Grid RowDefinitions="Auto,*" Padding="16,16,16,0" RowSpacing="14">

                <!-- CABECERA FIJA -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                    <Button
                        Grid.Column="0"
                        Text="‹"
                        Command="{Binding RegresarCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                        FontSize="28"
                        FontFamily="InterSemiBold"
                        FontAttributes="Bold"
                        Padding="0"
                        WidthRequest="36"
                        HeightRequest="36"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="Reporte por Horas"
                        FontSize="24"
                        FontAttributes="Bold"
                        FontFamily="InterSemiBold"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                        VerticalOptions="Center" />
                </Grid>

                <!-- RESULTADOS CON HEADER SCROLLABLE -->
                <CollectionView
                    Grid.Row="1"
                    ItemsSource="{Binding Resultados}"
                    RemainingItemsThreshold="3"
                    RemainingItemsThresholdReachedCommand="{Binding CargarMasReportesCommand}"
                    SelectionMode="None">

                    <CollectionView.Header>
                        <VerticalStackLayout Spacing="14" Margin="0,0,0,14">
                            <!-- BUSCADOR CON DESPLEGABLES Y BOTÓN DE DESCARGA -->
                            <VerticalStackLayout Spacing="8">
                                <!-- Fila 1: Buscador y Botón Descarga -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Border
                                        Grid.Column="0"
                                        HeightRequest="44"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                                        StrokeThickness="1"
                                        Padding="12,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                            <Image
                                                Grid.Column="0"
                                                Source="{AppThemeBinding Light=buscar_icon.png, Dark=buscar_icon_dark.png}"
                                                WidthRequest="18"
                                                HeightRequest="18"
                                                VerticalOptions="Center" />
                                            <Entry
                                                Grid.Column="1"
                                                Text="{Binding TextoCliente}"
                                                Placeholder="Buscar por cliente..."
                                                PlaceholderColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                                FontSize="13"
                                                FontFamily="InterRegular"
                                                BackgroundColor="Transparent"
                                                VerticalOptions="Center"
                                                ReturnCommand="{Binding CargarReporteCommand}" />
                                        </Grid>
                                    </Border>

                                    <!-- Botón Descargar Reporte (PDF / Excel) -->
                                    <Border
                                        Grid.Column="1"
                                        HeightRequest="44"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                                        Stroke="Transparent"
                                        Padding="14,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ExportarReporteCommand}" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Path Data="M12,4 L12,14 M7,9 L12,14 L17,9 M5,19 L19,19"
                                                  Stroke="{StaticResource White}"
                                                  StrokeThickness="2"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  WidthRequest="16"
                                                  HeightRequest="16"
                                                  VerticalOptions="Center"
                                                  Aspect="Uniform" />
                                            <Label Text="Descargar"
                                                   TextColor="{StaticResource White}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>

                                <!-- Fila 2: Desplegables de Año y Mes -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <!-- Desplegable Año -->
                                    <Border
                                        Grid.Column="0"
                                        HeightRequest="44"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                                        StrokeThickness="1"
                                        Padding="10,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                            <Label Text="Año:" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}" VerticalOptions="Center" />
                                            <Picker
                                                Grid.Column="1"
                                                ItemsSource="{Binding AniosDisponibles}"
                                                SelectedItem="{Binding AnioSeleccionadoTexto}"
                                                FontSize="12"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}"
                                                VerticalTextAlignment="Center"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Desplegable Mes -->
                                    <Border
                                        Grid.Column="1"
                                        HeightRequest="44"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                                        StrokeThickness="1"
                                        Padding="10,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                            <Label Text="Mes:" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}" VerticalOptions="Center" />
                                            <Picker
                                                Grid.Column="1"
                                                ItemsSource="{Binding MesesDisponibles}"
                                                SelectedItem="{Binding MesSeleccionadoTexto}"
                                                FontSize="12"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}"
                                                VerticalTextAlignment="Center"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>

                            <!-- CARDS DE RESUMEN METRICAS (3 CARDS) -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                <!-- Card 1: Clientes Consultados -->
                                <Border
                                    Grid.Column="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                                    StrokeThickness="1"
                                    Padding="8,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Clientes" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding TotalClientesConsultados}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource DarkPrimaryDark}}" HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Card 2: Recursos Asignados -->
                                <Border
                                    Grid.Column="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource DarkSuccessSurface}}"
                                    Stroke="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource DarkSuccessSurface}}"
                                    StrokeThickness="1"
                                    Padding="8,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Recursos" FontSize="10" TextColor="{StaticResource SuccessText}" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding TotalRecursosInvolucrados}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource SuccessText}" HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Card 3: Total Horas -->
                                <Border
                                    Grid.Column="2"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}"
                                    Stroke="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}"
                                    StrokeThickness="1"
                                    Padding="8,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Total Horas" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding TotalHorasRegistradas, StringFormat='{0:N1}h'}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label
                                Text="No se encontraron registros de horas."
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}"
                                FontSize="14"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:ReporteHorasResponse">
                            <Border
                                Margin="0,0,0,10"
                                Padding="14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                                StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <!-- Avatar Inicial Cliente -->
                                    <Border
                                        Grid.Column="0"
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="21" />
                                        </Border.StrokeShape>
                                        <Label
                                            Text="{Binding Inicial}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />
                                    </Border>

                                    <!-- Datos de Cliente y Recursos -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Cliente}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label
                                                Text="{Binding Recursos, StringFormat='👥 {0} recursos'}"
                                                FontSize="12"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}" />
                                            <Label
                                                Text="•"
                                                FontSize="12"
                                                TextColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" />
                                            <Label
                                                Text="{Binding Mes, StringFormat='📅 {0}'}"
                                                FontSize="12"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Horas Acumuladas y Estado -->
                                    <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label
                                            Text="{Binding Horas, StringFormat='{0:N1} hrs'}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                                            HorizontalTextAlignment="End" />

                                        <Border
                                            BackgroundColor="{Binding ColorFondoEstado}"
                                            Stroke="Transparent"
                                            Padding="8,3"
                                            HorizontalOptions="End">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>
                                            <Label
                                                Text="{Binding EstadoCliente}"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                TextColor="{Binding ColorEstado}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
        </Grid>

        <!-- BARRA DE NAVEGACIÓN INFERIOR COMPARTIDA -->
        <shared:BottomNavBar Grid.Row="1" />

        <!-- LOADING -->
        <ActivityIndicator
            Grid.RowSpan="2"
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>
