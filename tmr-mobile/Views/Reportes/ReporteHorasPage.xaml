<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.Reportes.ReporteHorasPage"
             x:DataType="vm:ReporteHorasViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20">
            <Label Text="Filtro de Reporte de Horas" FontAttributes="Bold" FontSize="18" />

            <Label Text="Fecha Inicio" FontSize="14" TextColor="#64748B" />
            <DatePicker Date="{Binding FechaInicio}" Format="dd/MM/yyyy" />

            <Label Text="Fecha Fin" FontSize="14" TextColor="#64748B" />
            <DatePicker Date="{Binding FechaFin}" Format="dd/MM/yyyy" />

            <Button Text="🔍 Generar Reporte"
                    Command="{Binding GenerarReporteCommand}"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="8" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
