<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.Reportes.ReporteHorasPage"
             x:DataType="vm:ReporteHorasViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="20">
            <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#EFF6FF">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Reporte por horas" Style="{StaticResource PageHeaderTitleStyle}" />
                    <Label Text="Elige el rango de fechas para filtrar la información y generar el reporte" Style="{StaticResource PageHeaderSubtitleStyle}" />

                    <Label Text="Fecha Inicio" Style="{StaticResource SectionTitleStyle}" />
                    <DatePicker Date="{Binding FechaInicio}" Format="dd/MM/yyyy" />

                    <Label Text="Fecha Fin" Style="{StaticResource SectionTitleStyle}" />
                    <DatePicker Date="{Binding FechaFin}" Format="dd/MM/yyyy" />

                    <Button Text="🔍 Generar reporte"
                            Command="{Binding GenerarReporteCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
