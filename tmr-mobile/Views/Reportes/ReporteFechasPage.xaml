<ContentPage xmlns:shared="clr-namespace:tmr_mobile.Views.Shared" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.Reportes.ReporteFechasPage"
             x:DataType="vm:ReporteFechasViewModel"
             Title="{Binding Title}">
    <Grid RowDefinitions="*,80">
        <ContentView Grid.Row="0">
<VerticalStackLayout Spacing="16" Padding="20">
        <Label Text="Reporte por Fechas" FontAttributes="Bold" FontSize="18" />
        <Label Text="Consulta detallada de registros agrupados por fechas." TextColor="#64748B" FontSize="14" />
    </VerticalStackLayout>


        </ContentView>
        <shared:BottomNavBar Grid.Row="1" />
    </Grid>
</ContentPage>
