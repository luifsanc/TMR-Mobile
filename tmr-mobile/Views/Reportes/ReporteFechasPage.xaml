<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.Reportes.ReporteFechasPage"
             x:DataType="vm:ReporteFechasViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="20">
            <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#FEFCE8">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Reporte por fechas" Style="{StaticResource PageHeaderTitleStyle}" />
                    <Label Text="Consulta los registros agrupados por fecha para un análisis más claro" Style="{StaticResource PageHeaderSubtitleStyle}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource ListCardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Disponibilidad" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="Los datos se organizan por día para simplificar la revisión del avance del equipo." Style="{StaticResource PageSubtitleStyle}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
