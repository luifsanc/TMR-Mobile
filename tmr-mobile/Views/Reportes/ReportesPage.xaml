<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
    x:Class="tmr_mobile.Views.Reportes.ReportesPage"
    x:DataType="vm:ReportesViewModel"
    Title="Reportes"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}">

    <Grid RowDefinitions="*,56">
        <!-- Contenido principal -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- TÍTULO -->
                <Label
                    Text="Módulo de Reportes"
                    FontSize="28"
                    FontAttributes="Bold"
                    FontFamily="InterSemiBold"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                    Margin="0,4,0,4" />

                <!-- SUBTÍTULO -->
                <Label
                    Text="Seleccione el tipo de informe operacional que desea consultar o exportar:"
                    FontSize="13"
                    FontFamily="InterRegular"
                    TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}" />

                <!-- TARJETA 1: REPORTE POR HORAS -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                    StrokeThickness="1"
                    Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding IrAReporteHorasCommand}" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <!-- Icono -->
                        <Border
                            Grid.Column="0"
                            WidthRequest="48"
                            HeightRequest="48"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label
                                Text="📊"
                                FontSize="24"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />
                        </Border>

                        <!-- Info -->
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label
                                Text="Reporte por Horas"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                            <Label
                                Text="Consolidado de horas ejecutadas por cliente, mes y recursos asignados."
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}" />
                        </VerticalStackLayout>

                        <!-- Arrow Icon -->
                        <Label
                            Grid.Column="2"
                            Text="›"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- TARJETA 2: REPORTE POR FECHAS -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                    StrokeThickness="1"
                    Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="6" Opacity="0.04" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding IrAReporteFechasCommand}" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <!-- Icono -->
                        <Border
                            Grid.Column="0"
                            WidthRequest="48"
                            HeightRequest="48"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label
                                Text="📅"
                                FontSize="24"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />
                        </Border>

                        <!-- Info -->
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label
                                Text="Reporte por Fechas"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                            <Label
                                Text="Detalle cronológico de registros de actividades por rango de fechas, líder y colaborador."
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}" />
                        </VerticalStackLayout>

                        <!-- Arrow Icon -->
                        <Label
                            Grid.Column="2"
                            Text="›"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BARRA DE NAVEGACIÓN INFERIOR COMPARTIDA -->
        <shared:UserBottomNavBar Grid.Row="1" />
    </Grid>
</ContentPage>
