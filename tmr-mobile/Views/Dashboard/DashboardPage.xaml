<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:tmr_mobile.Views.Dashboard.Converters"
             xmlns:models="clr-namespace:tmr_mobile.Views.Dashboard.Models"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
             x:Class="tmr_mobile.Views.Dashboard.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Dashboard"
             BackgroundColor="#F5F6FA"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:StatusToBackgroundColorConverter x:Key="StatusBg"/>
        <conv:StatusToTextColorConverter x:Key="StatusText"/>
    </ContentPage.Resources>

    <Grid>
        <!-- ===================== TODO EN UN SOLO SCROLL ===================== -->
        <ScrollView Margin="0,60,0,80">
            <VerticalStackLayout Spacing="20"
                                 Padding="16,12,16,32">

                <VerticalStackLayout Spacing="2">
                    <Label FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#101828">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Hola, "/>
                                <Span Text="{Binding NombreUsuario}"/>
                                <Span Text=" ðŸ‘‹"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="Aquí tienes un resumen de tu actividad"
                           TextColor="#667085"
                           FontSize="14"/>
                </VerticalStackLayout>


                <FlexLayout BindableLayout.ItemsSource="{Binding StatCards}"
                            Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="SpaceBetween">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:StatCard">
                            <Border StrokeShape="RoundRectangle 16"
                                    BackgroundColor="White"
                                    Stroke="Transparent"
                                    Padding="14"
                                    Margin="0,0,0,10"
                                    WidthRequest="168">
                                <VerticalStackLayout Spacing="8">
                                    <Border StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{Binding IconBackground}"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            Padding="0"
                                            Stroke="Transparent"/>
                                    <Label Text="{Binding Value}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#101828"/>
                                    <Label Text="{Binding Label}"
                                           FontSize="12"
                                           TextColor="#667085"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>


                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Próximos a cerrar"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="#101828"/>
                    <Label Grid.Column="1"
                           Text="Ver todos"
                           FontSize="14"
                           TextColor="#2E5BFF"/>
                </Grid>

                <CollectionView ItemsSource="{Binding ProximosACerrar}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="12"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ClosingProject">
                            <Border StrokeShape="RoundRectangle 16"
                                    BackgroundColor="White"
                                    Stroke="Transparent"
                                    Padding="16">
                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto,Auto,Auto"
                                      RowSpacing="4">
                                    <Border Grid.Row="0"
                                            Grid.Column="0"
                                            BackgroundColor="#EEF1F6"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="8,3"
                                            HorizontalOptions="Start">
                                        <Label Text="{Binding Codigo}"
                                               FontSize="11"
                                               TextColor="#667085"/>
                                    </Border>

                                    <Border Grid.Row="0"
                                            Grid.Column="1"
                                            StrokeShape="RoundRectangle 20"
                                            Padding="10,4"
                                            BackgroundColor="{Binding Estado, Converter={StaticResource StatusBg}}">
                                        <Label Text="{Binding Estado}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{Binding Estado, Converter={StaticResource StatusText}}"/>
                                    </Border>

                                    <Label Grid.Row="1"
                                           Grid.Column="0"
                                           Text="{Binding Titulo}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#101828"/>

                                    <Label Grid.Row="2"
                                           Grid.Column="0"
                                           Text="{Binding Cliente}"
                                           FontSize="13"
                                           TextColor="#667085"/>

                                    <Label Grid.Row="3"
                                           Grid.Column="0"
                                           Text="{Binding FechaCierre, StringFormat='{0:dd/MM/yyyy}'}"
                                           FontSize="13"
                                           TextColor="#667085"/>
                                    <Label Grid.Row="3"
                                           Grid.Column="1"
                                           Text="{Binding HorasRestantes, StringFormat='{0} h restantes'}"
                                           FontSize="12"
                                           TextColor="#667085"
                                           HorizontalOptions="End"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="White"
                        Stroke="Transparent"
                        Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Horas reportadas por proyecto"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#101828"/>
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 20"
                                    Stroke="#E4E7EC"
                                    Padding="10,4">
                                <Label Text="Este mes ⌄"
                                       FontSize="12"
                                       TextColor="#101828"/>
                            </Border>
                        </Grid>

                        <CollectionView ItemsSource="{Binding HorasPorProyecto}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ChartPoint">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Categoria}"
                                                   FontSize="12"
                                                   TextColor="#667085"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Horas, StringFormat='{0} h'}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="#101828"/>
                                        </Grid>
                                        <Border BackgroundColor="#E4ECFF"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 6"
                                                HeightRequest="12">
                                            <Border BackgroundColor="#2E5BFF"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 6"
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Fill"/>
                                        </Border>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>


                        <FlexLayout BindableLayout.ItemsSource="{Binding MetricasMini}"
                                    Wrap="Wrap"
                                    Direction="Row"
                                    JustifyContent="SpaceBetween">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:MetricMini">
                                    <VerticalStackLayout WidthRequest="105"
                                                         Spacing="4">
                                        <Label Text="{Binding Titulo}"
                                               FontSize="10"
                                               TextColor="#98A2B3"/>
                                        <Label Text="{Binding Valor}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#101828"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <HorizontalStackLayout Spacing="6"
                                               HorizontalOptions="Center">
                            <Ellipse Fill="#2E5BFF"
                                     WidthRequest="7"
                                     HeightRequest="7"/>
                            <Ellipse Fill="#D0D5DD"
                                     WidthRequest="7"
                                     HeightRequest="7"/>
                            <Ellipse Fill="#D0D5DD"
                                     WidthRequest="7"
                                     HeightRequest="7"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>


                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Actividad reciente"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="#101828"/>
                    <Label Grid.Column="1"
                           Text="Ver todas"
                           FontSize="14"
                           TextColor="#2E5BFF"/>
                </Grid>

                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="White"
                        Stroke="Transparent"
                        Padding="16">
                    <CollectionView ItemsSource="{Binding ActividadReciente}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical"
                                               ItemSpacing="16"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ActivityItem">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="12">
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{Binding IconBackground}"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            Stroke="Transparent"/>
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="2">
                                        <Label Text="{Binding Descripcion}"
                                               FontSize="14"
                                               TextColor="#101828"/>
                                        <Label Text="{Binding Tiempo}"
                                               FontSize="12"
                                               TextColor="#98A2B3"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>


                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="White"
                        Stroke="Transparent"
                        Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding DetalleTitulo}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#101828"/>
                            <Label Grid.Column="1"
                                   Text="{Binding DetalleTotalHoras}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#101828"/>
                        </Grid>

                        <Label Text="Detalle de horas"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#667085"/>

                        <CollectionView ItemsSource="{Binding DetalleHoras}">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical"
                                                   ItemSpacing="14"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:HourDetail">
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="10">
                                        <Ellipse Grid.Column="0"
                                                 Fill="{Binding Color}"
                                                 WidthRequest="9"
                                                 HeightRequest="9"
                                                 VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding Proyecto}"
                                               FontSize="14"
                                               TextColor="#101828"
                                               VerticalOptions="Center"/>
                                        <Label Grid.Column="2"
                                               Text="{Binding Horas, StringFormat='{0} h'}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#101828"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="#2E5BFF"
                                BackgroundColor="White"
                                Padding="0"
                                HeightRequest="46">
                            <Button Text="📅  Ver reporte completo"
                                    TextColor="#2E5BFF"
                                    BackgroundColor="Transparent"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Clicked="OnVerReporteCompletoClicked"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <shared:TopNavBar VerticalOptions="Start" />
        <shared:BottomNavBar VerticalOptions="End" />
    </Grid>
</ContentPage>
