<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:tmr_mobile.Views.Dashboard.Converters"
             xmlns:models="clr-namespace:tmr_mobile.Views.Dashboard.Models"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
             x:Class="tmr_mobile.Views.Dashboard.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Dashboard"
             BackgroundColor="{StaticResource BackgroundLight}">

    <ContentPage.Resources>
        <conv:StatusToBackgroundColorConverter x:Key="StatusBg"/>
        <conv:StatusToTextColorConverter x:Key="StatusText"/>
        <conv:PercentToColumnsConverter x:Key="PercentToColumns"/>
        <conv:SelectedBackgroundConverter x:Key="SelectedBg"/>
        <conv:SelectedTextColorConverter x:Key="SelectedText"/>
    </ContentPage.Resources>

    <Grid>
        <!-- ===================== TODO EN UN SOLO SCROLL ===================== -->
        <ScrollView Margin="0,0,0,80">
            <VerticalStackLayout Spacing="14"
                                 Padding="16,12,16,32">

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12"
                  VerticalOptions="Center">

                <Label Grid.Column="1"
                       Text="TMR-Mobile"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource TextPrimary}"/>
            </Grid> 

            <!-- ===================== cuadro donde saluda la usuario ===================== -->
            <Border StrokeShape="RoundRectangle 26"
                    Stroke="Transparent"
                    Padding="18,18,18,16">
                <Border.Background>
                    <LinearGradientBrush EndPoint="1,1">
                        <GradientStop Color="{StaticResource BackgroundLight}"
                                      Offset="0.0"/>
                        <GradientStop Color="{StaticResource PrimaryLight}"
                                      Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="14">
                    <VerticalStackLayout Grid.Column="0"
                                         Spacing="6">
                        <Border BackgroundColor="{StaticResource WhiteTranslucent}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 14"
                                Padding="10,5"
                                HorizontalOptions="Start">
                            <Label Text="Resumen general"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"/>
                        </Border>

                        <Label FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Hola, "/>
                                    <Span Text="{Binding NombreUsuario}"/>
                                    <Span Text=" 👋"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label Text="Aquí tienes un resumen claro de tu actividad y tus métricas clave del mes."
                               TextColor="{StaticResource TextMuted}"
                               FontSize="14"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <FlexLayout BindableLayout.ItemsSource="{Binding StatCards}"
                        Wrap="Wrap"
                        Direction="Row"
                        AlignItems="Stretch"
                        JustifyContent="Start"
                        Margin="-4">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:StatCard">
                        <Border StrokeShape="RoundRectangle 14"
                                BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource BorderColor}"
                                Padding="12,10"
                                Margin="4"
                                HeightRequest="126"
                                FlexLayout.Basis="48%"
                                FlexLayout.Grow="1">
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="5"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Center">
                                <Border Grid.Row="0"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{Binding IconBackground}"
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        Padding="0"
                                        Stroke="Transparent"
                                        HorizontalOptions="Center">
                                    <Label Text="{Binding Icon}"
                                        FontSize="15"
                                        TextColor="{Binding IconColor}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                                </Border>

                                <Label Grid.Row="1"
                                    Text="{Binding Value}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    HorizontalOptions="Fill"
                                    TextColor="{StaticResource TextPrimary}"/>

                                <Label Grid.Row="2"
                                    Text="{Binding Label}"
                                    FontSize="10.5"
                                    HorizontalTextAlignment="Center"
                                    HorizontalOptions="Fill"
                                    LineBreakMode="WordWrap"
                                    TextColor="{StaticResource TextMuted}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- ===================== Horas reportadas por proyecto (con selector de rango) ===================== -->
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource White}"
                        Stroke="Transparent"
                        Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                Text="Horas reportadas por proyecto"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}"/>

                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 20"
                                    Stroke="{StaticResource BorderColor}"
                                    BackgroundColor="{StaticResource BackgroundLight}"
                                    Padding="12,6">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleSelectorRangoCommand}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding RangoLabel}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextPrimary}"
                                        VerticalOptions="Center"/>
                                    <Path Data="M2,4 L7,9 L12,4"
                                        Stroke="{StaticResource TextMuted}"
                                        StrokeThickness="1.5"
                                        StrokeLineCap="Round"
                                        StrokeLineJoin="Round"
                                        WidthRequest="12"
                                        HeightRequest="9"
                                        VerticalOptions="Center"
                                        Aspect="Uniform"/>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding HorasPorProyecto}"
                                             Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ChartPoint">
                                    <VerticalStackLayout Spacing="8"
                                                         Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Categoria}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextMuted}"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Horas, StringFormat='{0:0} h'}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}"/>
                                        </Grid>

                                        <Border BackgroundColor="{StaticResource PrimaryLight}"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 6"
                                                HeightRequest="12">
                                            <Grid ColumnDefinitions="{Binding Porcentaje, Converter={StaticResource PercentToColumns}}"
                                                  HeightRequest="12">
                                                <Border Grid.Column="0"
                                                        BackgroundColor="{StaticResource Primary}"
                                                        Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 6"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <FlexLayout BindableLayout.ItemsSource="{Binding MetricasMini}"
                                    Wrap="Wrap"
                                    Direction="Row"
                                    JustifyContent="SpaceBetween">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:MetricMini">
                                    <VerticalStackLayout WidthRequest="105"
                                                         Spacing="4">
                                        <Label Text="{Binding Titulo}"
                                               FontSize="10"
                                               TextColor="{StaticResource TextLight}"/>
                                        <Label Text="{Binding Valor}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                

            <!-- ===================== Proyectos por cliente ===================== -->
            <Border StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource White}"
                    Stroke="Transparent"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Proyectos por cliente"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"/>

                    <CollectionView ItemsSource="{Binding ProyectosPorClienteVisibles}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ClientDistribution">
                                <VerticalStackLayout Spacing="8"
                                                     Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding Cliente}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextMuted}"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Grid.Column="1"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Proyectos}"/>
                                                    <Span Text=" ("/>
                                                    <Span Text="{Binding Porcentaje, StringFormat='{0:0.#}'}"/>
                                                    <Span Text="%)"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Grid>

                                    <Border BackgroundColor="{StaticResource PrimaryLight}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 6"
                                            HeightRequest="12">
                                        <Grid ColumnDefinitions="{Binding Porcentaje, Converter={StaticResource PercentToColumns}}"
                                              HeightRequest="12">
                                            <Border Grid.Column="0"
                                                    BackgroundColor="{StaticResource Primary}"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 6"/>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="{Binding TextoVerMasClientes}"
                            Command="{Binding ToggleVerMasClientesCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            FontAttributes="Bold"
                            FontSize="13"
                            HorizontalOptions="Center"
                            Padding="0"
                            HeightRequest="36"/>
                </VerticalStackLayout>
            </Border>
            

            <!-- ===================== Próximos a cerrar ===================== -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="Próximos a cerrar"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"/>
            </Grid>

                <CollectionView ItemsSource="{Binding ProximosACerrar}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="12"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ClosingProject">
                            <Border StrokeShape="RoundRectangle 16"
                                    BackgroundColor="{StaticResource White}"
                                    Stroke="Transparent"
                                    Padding="16">
                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto,Auto,Auto"
                                      RowSpacing="4">
                                    <Border Grid.Row="0"
                                            Grid.Column="0"
                                            BackgroundColor="{StaticResource Secondary}"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="8,3"
                                            HorizontalOptions="Start">
                                        <Label Text="{Binding Codigo}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextMuted}"/>
                                    </Border>

                                    <Border Grid.Row="0"
                                            Grid.Column="1"
                                            StrokeShape="RoundRectangle 20"
                                            Padding="10,4"
                                            BackgroundColor="{Binding Estado, Converter={StaticResource StatusBg}}">
                                        <Label Text="{Binding Estado}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{Binding Estado, Converter={StaticResource StatusText}}"/>
                                    </Border>

                                    <Label Grid.Row="1"
                                           Grid.Column="0"
                                           Text="{Binding Titulo}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"/>

                                    <Label Grid.Row="2"
                                           Grid.Column="0"
                                           Text="{Binding Cliente}"
                                           FontSize="13"
                                           TextColor="{StaticResource TextMuted}"/>

                                    <Label Grid.Row="3"
                                           Grid.Column="0"
                                           Text="{Binding FechaCierre, StringFormat='{0:dd/MM/yyyy}'}"
                                           FontSize="13"
                                           TextColor="{StaticResource TextMuted}"/>
                                    <Label Grid.Row="3"
                                           Grid.Column="1"
                                           Text="{Binding HorasRestantes, StringFormat='{0} h restantes'}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextMuted}"
                                           HorizontalOptions="End"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

        <shared:BottomNavBar VerticalOptions="End" />
    </Grid>
</ContentPage>
