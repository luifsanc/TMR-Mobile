<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:tmr_mobile.Views.Dashboard.Converters"
             xmlns:models="clr-namespace:tmr_mobile.Views.Dashboard.Models"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
             x:Class="tmr_mobile.Views.Dashboard.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Dashboard"
             BackgroundColor="{StaticResource DashboardPageBg}">

    <ContentPage.Resources>
        <conv:StatusToBackgroundColorConverter x:Key="StatusBg"/>
        <conv:StatusToTextColorConverter x:Key="StatusText"/>
        <conv:PercentToColumnsConverter x:Key="PercentToColumns"/>
        <conv:SelectedBackgroundConverter x:Key="SelectedBg"/>
        <conv:SelectedTextColorConverter x:Key="SelectedText"/>
        <Color x:Key="DashboardPageBg">#F4F7FC</Color>
        <Color x:Key="DashboardSurface">#FFFFFF</Color>
        <Color x:Key="DashboardText">#0F172A</Color>
        <Color x:Key="DashboardMuted">#667085</Color>
        <Color x:Key="DashboardBorder">#E6ECF5</Color>
        <Color x:Key="DashboardPrimary">#2347C6</Color>
        <Color x:Key="DashboardHeroStart">#F8FBFF</Color>
        <Color x:Key="DashboardHeroEnd">#EEF4FF</Color>
    </ContentPage.Resources>

    <Grid>
        <!-- ===================== TODO EN UN SOLO SCROLL ===================== -->
        <ScrollView Margin="0,60,0,80">
            <VerticalStackLayout Spacing="20"
                                 Padding="16,12,16,32">

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12"
                  VerticalOptions="Center">

                <Label Grid.Column="1"
                       Text="Dashboard"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource DashboardText}"/>

                <HorizontalStackLayout Grid.Column="2"
                                       Spacing="10"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center">
                    <Border StrokeShape="RoundRectangle 14"
                            BackgroundColor="White"
                            Stroke="{StaticResource DashboardBorder}"
                            WidthRequest="44"
                            HeightRequest="44"
                            Padding="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotificationsTapped"/>
                        </Border.GestureRecognizers>
                        <Grid>
                            <Label Text="🔔"
                                   FontSize="17"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                            <Border WidthRequest="10"
                                    HeightRequest="10"
                                    BackgroundColor="#F04438"
                                    Stroke="White"
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 5"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    Margin="0,6,6,0"
                                    IsVisible="{Binding TieneNotificaciones}"/>
                        </Grid>
                    </Border>

                    <Border StrokeShape="RoundRectangle 22"
                            BackgroundColor="White"
                            Stroke="{StaticResource DashboardBorder}"
                            Padding="6"
                            MinimumWidthRequest="92"
                            HeightRequest="44">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAvatarTapped"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="8"
                              VerticalOptions="Center">
                            <Grid Grid.Column="0"
                                  WidthRequest="32"
                                  HeightRequest="32">
                                <Border StrokeShape="RoundRectangle 16"
                                        BackgroundColor="{StaticResource DashboardText}"
                                        Stroke="Transparent"/>
                                <Label Text="{Binding AvatarInicial}"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                                <Border WidthRequest="10"
                                        HeightRequest="10"
                                        BackgroundColor="#12B76A"
                                        Stroke="White"
                                        StrokeThickness="2"
                                        StrokeShape="RoundRectangle 5"
                                        HorizontalOptions="End"
                                        VerticalOptions="End"/>
                            </Grid>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="0"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding NombreUsuario}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource DashboardText}"
                                       LineBreakMode="TailTruncation"/>
                                <Label Text="En línea"
                                       FontSize="10"
                                       TextColor="#12B76A"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- ===================== cuadro donde saluda la usuario ===================== -->
            <Border StrokeShape="RoundRectangle 26"
                    Stroke="Transparent"
                    Padding="18,18,18,16">
                <Border.Background>
                    <LinearGradientBrush EndPoint="1,1">
                        <GradientStop Color="{StaticResource DashboardHeroStart}"
                                      Offset="0.0"/>
                        <GradientStop Color="{StaticResource DashboardHeroEnd}"
                                      Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="14">
                    <VerticalStackLayout Grid.Column="0"
                                         Spacing="6">
                        <Border BackgroundColor="#FFFFFFAA"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 14"
                                Padding="10,5"
                                HorizontalOptions="Start">
                            <Label Text="Resumen general"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource DashboardPrimary}"/>
                        </Border>

                        <Label FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{StaticResource DashboardText}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Hola, "/>
                                    <Span Text="{Binding NombreUsuario}"/>
                                    <Span Text=" 👋"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label Text="Aquí tienes un resumen claro de tu actividad y tus métricas clave del mes."
                               TextColor="{StaticResource DashboardMuted}"
                               FontSize="14"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <FlexLayout BindableLayout.ItemsSource="{Binding StatCards}"
                        Wrap="Wrap"
                        Direction="Row"
                        JustifyContent="SpaceBetween">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:StatCard">
                        <Border StrokeShape="RoundRectangle 16"
                                BackgroundColor="White"
                                Stroke="{StaticResource DashboardBorder}"
                                Padding="14"
                                Margin="0,0,0,10"
                                WidthRequest="168">
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="10">
                                <Grid Grid.Row="0"
                                      ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8">
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{Binding IconBackground}"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            Padding="0"
                                            Stroke="Transparent">
                                        <Label Text="{Binding Icon}"
                                               FontSize="20"
                                               TextColor="{Binding IconColor}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>

                                    <Border Grid.Column="1"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="#F8FAFC"
                                            Stroke="Transparent"
                                            HeightRequest="26"
                                            HorizontalOptions="End"
                                            WidthRequest="26">
                                    </Border>
                                </Grid>

                                <Label Grid.Row="1"
                                       Text="{Binding Value}"
                                       FontSize="21"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource DashboardText}"/>

                                <Label Grid.Row="2"
                                       Text="{Binding Label}"
                                       FontSize="12"
                                       TextColor="{StaticResource DashboardMuted}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- ===================== Horas reportadas por proyecto (con selector de rango) ===================== -->
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="White"
                        Stroke="Transparent"
                        Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                Text="Horas reportadas por proyecto"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#101828"/>

                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 20"
                                    Stroke="#E4E7EC"
                                    BackgroundColor="#F9FAFB"
                                    Padding="12,6">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleSelectorRangoCommand}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding RangoLabel}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="#101828"
                                        VerticalOptions="Center"/>
                                    <Path Data="M2,4 L7,9 L12,4"
                                        Stroke="#667085"
                                        StrokeThickness="1.5"
                                        StrokeLineCap="Round"
                                        StrokeLineJoin="Round"
                                        WidthRequest="12"
                                        HeightRequest="9"
                                        VerticalOptions="Center"
                                        Aspect="Uniform"/>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding HorasPorProyecto}"
                                             Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ChartPoint">
                                    <VerticalStackLayout Spacing="8"
                                                         Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Categoria}"
                                                   FontSize="12"
                                                   TextColor="#667085"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Horas, StringFormat='{0:0} h'}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="#101828"/>
                                        </Grid>

                                        <Border BackgroundColor="#E4ECFF"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 6"
                                                HeightRequest="12">
                                            <Grid ColumnDefinitions="{Binding Porcentaje, Converter={StaticResource PercentToColumns}}"
                                                  HeightRequest="12">
                                                <Border Grid.Column="0"
                                                        BackgroundColor="#2E5BFF"
                                                        Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 6"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <FlexLayout BindableLayout.ItemsSource="{Binding MetricasMini}"
                                    Wrap="Wrap"
                                    Direction="Row"
                                    JustifyContent="SpaceBetween">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:MetricMini">
                                    <VerticalStackLayout WidthRequest="105"
                                                         Spacing="4">
                                        <Label Text="{Binding Titulo}"
                                               FontSize="10"
                                               TextColor="#98A2B3"/>
                                        <Label Text="{Binding Valor}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#101828"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                

            <!-- ===================== Proyectos por cliente ===================== -->
            <Border StrokeShape="RoundRectangle 16"
                    BackgroundColor="White"
                    Stroke="Transparent"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Proyectos por cliente"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#101828"/>

                    <CollectionView ItemsSource="{Binding ProyectosPorClienteVisibles}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ClientDistribution">
                                <VerticalStackLayout Spacing="8"
                                                     Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding Cliente}"
                                               FontSize="12"
                                               TextColor="#667085"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Grid.Column="1"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#101828">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Proyectos}"/>
                                                    <Span Text=" ("/>
                                                    <Span Text="{Binding Porcentaje, StringFormat='{0:0.#}'}"/>
                                                    <Span Text="%)"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Grid>

                                    <Border BackgroundColor="#E4ECFF"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 6"
                                            HeightRequest="12">
                                        <Grid ColumnDefinitions="{Binding Porcentaje, Converter={StaticResource PercentToColumns}}"
                                              HeightRequest="12">
                                            <Border Grid.Column="0"
                                                    BackgroundColor="#7A58D1"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 6"/>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="{Binding TextoVerMasClientes}"
                            Command="{Binding ToggleVerMasClientesCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#7A58D1"
                            FontAttributes="Bold"
                            FontSize="13"
                            HorizontalOptions="Center"
                            Padding="0"
                            HeightRequest="36"/>
                </VerticalStackLayout>
            </Border>

            <!-- ===================== Próximos a cerrar ===================== -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="Próximos a cerrar"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="#101828"/>
                <Label Grid.Column="1"
                       Text="Ver todos"
                       FontSize="14"
                       TextColor="#2E5BFF"/>
            </Grid>

                <CollectionView ItemsSource="{Binding ProximosACerrar}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="12"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ClosingProject">
                            <Border StrokeShape="RoundRectangle 16"
                                    BackgroundColor="White"
                                    Stroke="Transparent"
                                    Padding="16">
                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto,Auto,Auto"
                                      RowSpacing="4">
                                    <Border Grid.Row="0"
                                            Grid.Column="0"
                                            BackgroundColor="#EEF1F6"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="8,3"
                                            HorizontalOptions="Start">
                                        <Label Text="{Binding Codigo}"
                                               FontSize="11"
                                               TextColor="#667085"/>
                                    </Border>

                                    <Border Grid.Row="0"
                                            Grid.Column="1"
                                            StrokeShape="RoundRectangle 20"
                                            Padding="10,4"
                                            BackgroundColor="{Binding Estado, Converter={StaticResource StatusBg}}">
                                        <Label Text="{Binding Estado}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{Binding Estado, Converter={StaticResource StatusText}}"/>
                                    </Border>

                                    <Label Grid.Row="1"
                                           Grid.Column="0"
                                           Text="{Binding Titulo}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#101828"/>

                                    <Label Grid.Row="2"
                                           Grid.Column="0"
                                           Text="{Binding Cliente}"
                                           FontSize="13"
                                           TextColor="#667085"/>

                                    <Label Grid.Row="3"
                                           Grid.Column="0"
                                           Text="{Binding FechaCierre, StringFormat='{0:dd/MM/yyyy}'}"
                                           FontSize="13"
                                           TextColor="#667085"/>
                                    <Label Grid.Row="3"
                                           Grid.Column="1"
                                           Text="{Binding HorasRestantes, StringFormat='{0} h restantes'}"
                                           FontSize="12"
                                           TextColor="#667085"
                                           HorizontalOptions="End"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

        <shared:TopNavBar VerticalOptions="Start" />
        <shared:BottomNavBar VerticalOptions="End" />
    </Grid>
</ContentPage>
