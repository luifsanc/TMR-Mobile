<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:tmr_mobile.Views.Components"
             xmlns:conv="clr-namespace:tmr_mobile.Views.Dashboard.Converters"
             xmlns:models="clr-namespace:tmr_mobile.Views.Dashboard.Models"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
             x:Class="tmr_mobile.Views.Dashboard.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Dashboard"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}">

    <ContentPage.Resources>
        <conv:StatusToBackgroundColorConverter x:Key="StatusBg"/>
        <conv:StatusToTextColorConverter x:Key="StatusText"/>
        <conv:PercentToColumnsConverter x:Key="PercentToColumns"/>
        <conv:SelectedBackgroundConverter x:Key="SelectedBg"/>
        <conv:SelectedTextColorConverter x:Key="SelectedText"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*"
          SafeAreaEdges="Container"
          BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}">
        <!-- Fixed header -->
        <Grid Grid.Row="0"
              Padding="16,12,16,8"
              ColumnDefinitions="26,*,26"
              ColumnSpacing="12"
              VerticalOptions="Center">

            <Image Grid.Column="1"
                   Source="{AppThemeBinding Light=letras1.png, Dark=letras2.png}"
                   WidthRequest="124"
                   HeightRequest="40"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   SemanticProperties.Description="Integrity Solutions" />

            <Grid Grid.Column="2"
                  WidthRequest="26"
                  HeightRequest="26"
                  HorizontalOptions="End"
                  SemanticProperties.Description="Notificaciones">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNotificationsTapped" />
                </Grid.GestureRecognizers>

                <Image Source="{AppThemeBinding Light=notification_bell_alarm.png, Dark=notification_bell_alarm_dark.png}"
                       WidthRequest="16"
                       HeightRequest="16"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <Border WidthRequest="7"
                        HeightRequest="7"
                        Padding="0"
                        Margin="0,1,1,0"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        BackgroundColor="{StaticResource Error}"
                        Stroke="{StaticResource OnPrimary}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 3.5"
                        IsVisible="{Binding TieneNotificaciones}" />
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1" Margin="0,0,0,56">
            <VerticalStackLayout Spacing="14"
                                 Padding="16,4,16,32">

            <!-- ===================== cuadro donde saluda la usuario ===================== -->
            <Border StrokeShape="RoundRectangle 26"
                    Stroke="Transparent"
                    Padding="18,18,18,16">
                <Border.Background>
                    <LinearGradientBrush EndPoint="1,1">
                        <GradientStop Color="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}"
                                      Offset="0.0"/>
                        <GradientStop Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}"
                                      Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="14">
                    <VerticalStackLayout Grid.Column="0"
                                         Spacing="6">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource WhiteTranslucent}, Dark={StaticResource DarkWhiteTranslucent}}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 14"
                                Padding="10,5"
                                HorizontalOptions="Start">
                            <Label Text="Resumen general"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"/>
                        </Border>

                        <Label FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Hola, "/>
                                    <Span Text="{Binding NombreUsuario}"/>
                                    <Span Text=" 👋"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label Text="Aquí tienes un resumen de la actividad y las métricas clave del mes."
                               TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}"
                               FontSize="14"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <FlexLayout BindableLayout.ItemsSource="{Binding StatCards}"
                        Wrap="Wrap"
                        Direction="Row"
                        AlignItems="Stretch"
                        JustifyContent="Start"
                        Margin="-4">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:StatCard">
                        <Border StrokeShape="RoundRectangle 14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                                Padding="12,10"
                                Margin="4"
                                HeightRequest="126"
                                FlexLayout.Basis="48%"
                                FlexLayout.Grow="1">
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="5"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Center">
                                <Border Grid.Row="0"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{Binding IconBackground}"
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        Padding="0"
                                        Stroke="Transparent"
                                        HorizontalOptions="Center">
                                    <Label Text="{Binding Icon}"
                                        FontSize="15"
                                        TextColor="{Binding IconColor}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                                </Border>

                                <Label Grid.Row="1"
                                    Text="{Binding Value}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    HorizontalOptions="Fill"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"/>

                                <Label Grid.Row="2"
                                    Text="{Binding Label}"
                                    FontSize="10.5"
                                    HorizontalTextAlignment="Center"
                                    HorizontalOptions="Fill"
                                    LineBreakMode="WordWrap"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- ===================== Horas reportadas por proyecto (con selector de rango) ===================== -->
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                        Stroke="Transparent"
                        Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                Text="Horas reportadas por proyecto"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"/>

                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 20"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}"
                                    Padding="12,6">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleSelectorRangoCommand}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding RangoLabel}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                        VerticalOptions="Center"/>
                                    <Path Data="M2,4 L7,9 L12,4"
                                        Stroke="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}"
                                        StrokeThickness="1.5"
                                        StrokeLineCap="Round"
                                        StrokeLineJoin="Round"
                                        WidthRequest="12"
                                        HeightRequest="9"
                                        VerticalOptions="Center"
                                        Aspect="Uniform"/>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding HorasPorProyecto}"
                                             Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ChartPoint">
                                    <VerticalStackLayout Spacing="8"
                                                         Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Categoria}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Horas, StringFormat='{0:0} h'}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"/>
                                        </Grid>

                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 6"
                                                HeightRequest="12">
                                            <Grid ColumnDefinitions="{Binding Porcentaje, Converter={StaticResource PercentToColumns}}"
                                                  HeightRequest="12">
                                                <Border Grid.Column="0"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                                                        Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 6"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <FlexLayout BindableLayout.ItemsSource="{Binding MetricasMini}"
                                    Wrap="Wrap"
                                    Direction="Row"
                                    JustifyContent="SpaceBetween">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:MetricMini">
                                    <VerticalStackLayout WidthRequest="105"
                                                         Spacing="4">
                                        <Label Text="{Binding Titulo}"
                                               FontSize="10"
                                               TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}"/>
                                        <Label Text="{Binding Valor}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                

            <!-- ===================== Proyectos por cliente ===================== -->
            <Border StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                    Stroke="Transparent"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Proyectos por cliente"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"/>

                    <CollectionView ItemsSource="{Binding ProyectosPorClienteVisibles}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ClientDistribution">
                                <VerticalStackLayout Spacing="8"
                                                     Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding Cliente}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Grid.Column="1"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Proyectos}"/>
                                                    <Span Text=" ("/>
                                                    <Span Text="{Binding Porcentaje, StringFormat='{0:0.#}'}"/>
                                                    <Span Text="%)"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Grid>

                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 6"
                                            HeightRequest="12">
                                        <Grid ColumnDefinitions="{Binding Porcentaje, Converter={StaticResource PercentToColumns}}"
                                              HeightRequest="12">
                                            <Border Grid.Column="0"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 6"/>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="{Binding TextoVerMasClientes}"
                            Command="{Binding ToggleVerMasClientesCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                            FontAttributes="Bold"
                            FontSize="13"
                            HorizontalOptions="Center"
                            Padding="0"
                            HeightRequest="36"/>
                </VerticalStackLayout>
            </Border>
            

            <!-- ===================== Próximos a cerrar ===================== -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="Próximos a cerrar"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"/>
            </Grid>

                <CollectionView ItemsSource="{Binding ProximosACerrar}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="12"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ClosingProject">
                            <Border StrokeShape="RoundRectangle 16"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                                    Stroke="Transparent"
                                    Padding="16">
                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto,Auto,Auto"
                                      RowSpacing="4">
                                    <Border Grid.Row="0"
                                            Grid.Column="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="8,3"
                                            HorizontalOptions="Start">
                                        <Label Text="{Binding Codigo}"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}"/>
                                    </Border>

                                    <Border Grid.Row="0"
                                            Grid.Column="1"
                                            StrokeShape="RoundRectangle 20"
                                            Padding="10,4"
                                            BackgroundColor="{Binding Estado, Converter={StaticResource StatusBg}}">
                                        <Label Text="{Binding Estado}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{Binding Estado, Converter={StaticResource StatusText}}"/>
                                    </Border>

                                    <Label Grid.Row="1"
                                           Grid.Column="0"
                                           Text="{Binding Titulo}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"/>

                                    <Label Grid.Row="2"
                                           Grid.Column="0"
                                           Text="{Binding Cliente}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}"/>

                                    <Label Grid.Row="3"
                                           Grid.Column="0"
                                           Text="{Binding FechaCierre, StringFormat='{0:dd/MM/yyyy}'}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}"/>
                                    <Label Grid.Row="3"
                                           Grid.Column="1"
                                           Text="{Binding HorasRestantes, StringFormat='{0} h restantes'}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}"
                                           HorizontalOptions="End"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

        <shared:UserBottomNavBar Grid.Row="1" VerticalOptions="End" />
        
        <!-- namespace: xmlns:components="clr-namespace:tmr_mobile.Views.Components" -->
        <components:OptionsPopover
            Grid.RowSpan="99"
            IsVisible="{Binding IsRangoSelectorVisible}"
            ItemsSource="{Binding OpcionesRango}"
            SelectedCommand="{Binding SeleccionarRangoCommand}"
            DismissCommand="{Binding CerrarSelectorRangoCommand}"/>
    </Grid>
</ContentPage>
