<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             xmlns:dto="clr-namespace:tmr_shared.DTOs.TimeReport;assembly=tmr-shared"
             x:Class="tmr_mobile.Views.TimeReport.TimeReportPage"
             x:DataType="vm:TimeReportViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*">
        <Button Grid.Row="0"
                Text="+ Registrar Nueva Actividad"
                Command="{Binding NuevaActividadCommand}"
                Margin="16,12"
                BackgroundColor="#10B981"
                TextColor="White"
                CornerRadius="8" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Actividades}"
                        Margin="16,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:CalendarioActividadDto">
                    <Border Margin="0,0,0,12" Padding="16"
                            StrokeShape="RoundRectangle 10" Stroke="Transparent">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding ProyectoNombre}" FontAttributes="Bold" FontSize="16" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding CantidadHoras, StringFormat='{0}h'}" FontAttributes="Bold" TextColor="#2563EB" />
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding DescripcionActividad}" TextColor="#64748B" FontSize="14" Margin="0,4,0,0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
