<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.TimeReport.TimeReportPage"
             x:DataType="vm:TimeReportViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="20">
            <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#F8FAFC">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Registro de actividades" Style="{StaticResource PageHeaderTitleStyle}" />
                        <Label Text="Control diario de horas, proyectos y tipos de actividad" Style="{StaticResource PageHeaderSubtitleStyle}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Nueva" Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" BackgroundColor="#EFF6FF">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🕐 Por registrar" FontSize="11" TextColor="#1D4ED8" />
                        <Label Text="{Binding HorasPorRegistrar, StringFormat='{0} h'}" FontAttributes="Bold" TextColor="#1D4ED8" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" BackgroundColor="#ECFDF5">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="✅ Hoy" FontSize="11" TextColor="#047857" />
                        <Label Text="{Binding HorasRegistradasHoy, StringFormat='{0} h'}" FontAttributes="Bold" TextColor="#047857" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" BackgroundColor="#FEFCE8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="📅 Semana" FontSize="11" TextColor="#A16207" />
                        <Label Text="{Binding HorasSemana, StringFormat='{0} h'}" FontAttributes="Bold" TextColor="#A16207" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" BackgroundColor="#F5F3FF">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="📊 Mes" FontSize="11" TextColor="#7C3AED" />
                        <Label Text="{Binding HorasMes, StringFormat='{0} h'}" FontAttributes="Bold" TextColor="#7C3AED" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <VerticalStackLayout Spacing="8">
                <Label Text="Últimas actividades" Style="{StaticResource SectionTitleStyle}" />
                <CollectionView ItemsSource="{Binding Actividades}" Margin="0,0,0,8">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActividadItem">
                            <Border Style="{StaticResource ListCardStyle}" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Proyecto}" Style="{StaticResource PageTitleStyle}" FontSize="16" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Horas, StringFormat='{0}h'}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding TipoActividad}" Style="{StaticResource PageSubtitleStyle}" FontSize="13" Margin="0,2,0,0" />
                                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Descripcion}" Style="{StaticResource PageSubtitleStyle}" FontSize="14" Margin="0,4,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
