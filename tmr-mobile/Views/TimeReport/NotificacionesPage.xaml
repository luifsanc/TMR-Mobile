<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
             x:Class="tmr_mobile.Views.TimeReport.NotificacionesPage"
             x:DataType="vm:NotificacionesViewModel"
             Title="{Binding Title}">

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}">
        
        <ScrollView Margin="0,0,0,56">
            <VerticalStackLayout Padding="20,24,20,32">
                <!-- Tarjeta Notificaciones -->
                <Border StrokeShape="RoundRectangle 8" Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Padding="0">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" Offset="0,2" Radius="4" Opacity="0.05" />
                    </Border.Shadow>
                    
                    <VerticalStackLayout>
                        <!-- Header -->
                        <Grid ColumnDefinitions="*,Auto" Padding="16,10,10,8">
                            <Label Text="Notificaciones"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                                   VerticalOptions="Center" />

                            <Border Grid.Column="1"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    Padding="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 14"
                                    SemanticProperties.Description="Cerrar notificaciones">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCloseTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="×"
                                       FontSize="20"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        
                        <!-- Separator -->
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" />
                        
                        <!-- Lista de Notificaciones -->
                        <CollectionView ItemsSource="{Binding Notificaciones}" SelectionMode="None">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Padding="24,32"
                                                     Spacing="8"
                                                     HorizontalOptions="Center">
                                    <Label Text="No tienes notificaciones pendientes."
                                           FontSize="14"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}" />
                                    <Label Text="{Binding ErrorMessage}"
                                           FontSize="12"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{StaticResource Error}"
                                           IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:NotificacionItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*" Padding="16" ColumnSpacing="12">
                                        <!-- Icono de Alerta -->
                                        <Grid Grid.Column="0" WidthRequest="22" HeightRequest="22" VerticalOptions="Start" Margin="0,2,0,0">
                                            <!-- Triángulo de advertencia -->
                                            <Polygon Points="11,0 22,20 0,20" Stroke="{StaticResource Error}" StrokeThickness="1.5" Fill="Transparent" IsVisible="{Binding IsAlert}" />
                                            <Label Text="!" TextColor="{StaticResource Error}" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,4,0,0" IsVisible="{Binding IsAlert}" />
                                        </Grid>
                                        
                                        <!-- Contenido -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                                            <Label FontSize="14" LineHeight="1.2">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding MensajePart1}" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}" />
                                                        <Span Text="{Binding MensajeHighlight}" TextColor="{StaticResource Error}" FontAttributes="Bold" />
                                                        <Span Text="{Binding MensajePart2}" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <shared:UserBottomNavBar VerticalOptions="End" />
    </Grid>
</ContentPage>
