<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.TimeReport.CargaActividadesPage"
             x:DataType="vm:CargaActividadesViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="20">
            <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#ECFDF5">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Carga masiva" Style="{StaticResource PageHeaderTitleStyle}" />
                    <Label Text="Importa partes de horas desde un archivo Excel con la misma lógica del flujo del frontend" Style="{StaticResource PageHeaderSubtitleStyle}" />
                    <Button Text="📁 Seleccionar archivo Excel"
                            Command="{Binding SeleccionarArchivoCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Label Text="{Binding ArchivoSeleccionado}"
                           FontSize="13"
                           FontAttributes="Italic"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource ListCardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Pasos recomendados" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="1. Descarga la plantilla de ejemplo." Style="{StaticResource PageSubtitleStyle}" />
                    <Label Text="2. Completa los campos de proyecto, horas y actividad." Style="{StaticResource PageSubtitleStyle}" />
                    <Label Text="3. Sube el archivo y valida el resultado." Style="{StaticResource PageSubtitleStyle}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
