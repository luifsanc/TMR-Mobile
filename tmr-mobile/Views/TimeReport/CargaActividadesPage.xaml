<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="tmr_mobile.Views.TimeReport.CargaActividadesPage"
             xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F6FA">

    <Grid RowDefinitions="*,80">
        <ScrollView Grid.Row="0">
        <VerticalStackLayout Spacing="18" Padding="16" BackgroundColor="#F5F6FA">

            <!-- Header -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 20"
                    Padding="14"
                    HorizontalOptions="Fill">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <ImageButton Source="menu_icon.png"
                                 BackgroundColor="Transparent"
                                 WidthRequest="24"
                                 HeightRequest="24" />
                    <Label Text="Carga de actividades"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#101828"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <ImageButton Source="bell_icon.png"
                                 BackgroundColor="Transparent"
                                 WidthRequest="22"
                                 HeightRequest="22" />
                </Grid>
            </Border>

            <!-- Summary -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="18"
                    HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Horas por registrar"
                           FontSize="13"
                           TextColor="#64748B" />
                    <Label Text="140.005,42 h"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#101828" />
                </VerticalStackLayout>
            </Border>

            <!-- Search + filter -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 16"
                        Padding="12"
                        HorizontalOptions="Fill"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="🔍"
                               FontSize="16"
                               VerticalOptions="Center"
                               TextColor="#94A3B8" />
                        <Label Text="Buscar proyecto..."
                               FontSize="14"
                               TextColor="#94A3B8"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 16"
                        WidthRequest="56"
                        HeightRequest="56"
                        HorizontalOptions="End"
                        VerticalOptions="Center">
                    <Label Text="⚙"
                           FontSize="18"
                           TextColor="#101828"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Pagination / Sort -->
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                <Label Text="1 al 10 de 3.780"
                       FontSize="12"
                       TextColor="#667085"
                       VerticalTextAlignment="Center"
                       HorizontalOptions="Start" />
                <Label Text="Ordenar"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       VerticalTextAlignment="Center"
                       HorizontalOptions="End" />
            </Grid>

            <!-- Cards -->
            <VerticalStackLayout Spacing="12">
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Aldo Gennaro Di Mattia"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#101828" />
                        <Label Text="Migración de Time Report"
                               FontSize="14"
                               TextColor="#475569" />
                        <Border Stroke="#E2E8F0"
                                BackgroundColor="#EFF6FF"
                                StrokeShape="RoundRectangle 14"
                                Padding="10,6"
                                HorizontalOptions="Start">
                            <Label Text="Integrity Solutions"
                                   FontSize="12"
                                   TextColor="#2563EB" />
                        </Border>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Text="06/07/2026 · 2.5 h"
                                   FontSize="12"
                                   TextColor="#64748B"
                                   VerticalOptions="Center" />
                            <Border BackgroundColor="#ECFDF5"
                                    Stroke="#86EFAC"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="10,6"
                                    VerticalOptions="Center">
                                <Label Text="Cargado"
                                       FontSize="12"
                                       TextColor="#16A34A" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Aldo Gennaro Di Mattia"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#101828" />
                        <Label Text="Migración de Time Report"
                               FontSize="14"
                               TextColor="#475569" />
                        <Border Stroke="#E2E8F0"
                                BackgroundColor="#EFF6FF"
                                StrokeShape="RoundRectangle 14"
                                Padding="10,6"
                                HorizontalOptions="Start">
                            <Label Text="Integrity Solutions"
                                   FontSize="12"
                                   TextColor="#2563EB" />
                        </Border>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Text="10/07/2026 · 2.5 h"
                                   FontSize="12"
                                   TextColor="#64748B"
                                   VerticalOptions="Center" />
                            <Border BackgroundColor="#ECFDF5"
                                    Stroke="#86EFAC"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="10,6"
                                    VerticalOptions="Center">
                                <Label Text="Cargado"
                                       FontSize="12"
                                       TextColor="#16A34A" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Aldo Gennaro Di Mattia"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#101828" />
                        <Label Text="Migración de Time Report"
                               FontSize="14"
                               TextColor="#475569" />
                        <Border Stroke="#E2E8F0"
                                BackgroundColor="#EFF6FF"
                                StrokeShape="RoundRectangle 14"
                                Padding="10,6"
                                HorizontalOptions="Start">
                            <Label Text="Integrity Solutions"
                                   FontSize="12"
                                   TextColor="#2563EB" />
                        </Border>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Text="16/07/2026 · 2.5 h"
                                   FontSize="12"
                                   TextColor="#64748B"
                                   VerticalOptions="Center" />
                            <Border BackgroundColor="#ECFDF5"
                                    Stroke="#86EFAC"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="10,6"
                                    VerticalOptions="Center">
                                <Label Text="Cargado"
                                       FontSize="12"
                                       TextColor="#16A34A" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Download button -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 20"
                    Padding="14"
                    HorizontalOptions="Fill">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="⬇"
                           FontSize="18"
                           TextColor="#101828"
                           VerticalOptions="Center" />
                    <Label Text="Descargar"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#101828"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>
        </ScrollView>
        
        <!-- Custom Bottom Nav Bar -->
        <shared:BottomNavBar Grid.Row="1" />
    </Grid>
</ContentPage>
