<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             xmlns:models="clr-namespace:tmr_mobile.Models"
             xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
             xmlns:converters="clr-namespace:tmr_mobile.Views.TimeReport.Converters"
             x:Class="tmr_mobile.Views.TimeReport.CargaActividadesPage"
             x:DataType="vm:CargaActividadesViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundLight}">

    <ContentPage.Resources>
        <converters:EstadoToColorConverter x:Key="EstadoToColorConverter"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0"
            Margin="0,0,0,36">
        <VerticalStackLayout Padding="16,12,16,32" Spacing="20">

        <!-- ===================== Card de horas por registrar + carga de archivo ===================== -->
        <Border StrokeShape="RoundRectangle 16"
                BackgroundColor="{StaticResource BackgroundLight}"
                Stroke="Transparent"
                Padding="16">
            <VerticalStackLayout Spacing="12">

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                        <Label Text="Horas por registrar" FontSize="14" TextColor="{StaticResource TextMuted}"/>
                        <Label Text="{Binding HorasPorRegistrarTexto}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 24"
                            BackgroundColor="{StaticResource TextPrimary}"
                            Stroke="Transparent"
                            WidthRequest="48"
                            HeightRequest="48"
                            Padding="0"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SeleccionarArchivoCommand}"/>
                        </Border.GestureRecognizers>
                        <Path Data="M12,14 L12,4 M7,9 L12,4 L17,9 M5,19 L19,19"
                            Stroke="{StaticResource White}"
                            StrokeThickness="2"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            WidthRequest="18"
                            HeightRequest="18"
                            Aspect="Uniform"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- Fila del archivo elegido: aparece solo tras usar el botón de arriba -->
                <Grid IsVisible="{Binding TieneArchivoSeleccionado}"
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="8"
                    VerticalOptions="Center">

                    <Label Grid.Column="0"
                        Text="{Binding NombreArchivoSeleccionado}"
                        FontSize="13"
                        TextColor="{StaticResource TextMain}"
                        LineBreakMode="MiddleTruncation"
                        VerticalOptions="Center"/>

                    <!-- Botón "X" para cancelar la selección -->
                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="Transparent"
                            Stroke="Transparent"
                            WidthRequest="24"
                            HeightRequest="24"
                            Padding="0"
                            IsVisible="{Binding PuedeSubirArchivo}"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding QuitarArchivoSeleccionadoCommand}"/>
                        </Border.GestureRecognizers>
                        <Path Data="M6,6 L18,18 M6,18 L18,6"
                            Stroke="{StaticResource TextLight}"
                            StrokeThickness="2"
                            StrokeLineCap="Round"
                            WidthRequest="14"
                            HeightRequest="14"
                            Aspect="Uniform"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
                    </Border>

                    <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                        <ActivityIndicator Grid.Column="0"
                                            IsRunning="{Binding IsBusy}"
                                            IsVisible="{Binding IsBusy}"
                                            Color="{StaticResource TextPrimary}"
                                            WidthRequest="20"
                                            HeightRequest="20"/>

                        <Button Grid.Column="1"
                                Text="{Binding TextoBotonSubir}"
                                Command="{Binding CargarArchivoCommand}"
                                IsEnabled="{Binding PuedeSubirArchivo}"
                                FontSize="13"
                                Padding="12,6"
                                CornerRadius="8"
                                BackgroundColor="{StaticResource TextPrimary}"
                                TextColor="{StaticResource White}"/>
                    </Grid>
                </Grid>

                <!-- Resultado de la carga: éxito en verde, error en rojo -->
                <Label Text="{Binding MensajeResultado}"
                    IsVisible="{Binding TieneMensajeResultado}"
                    FontSize="12"
                    LineBreakMode="WordWrap">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding HuboErrores}" Value="True">
                            <Setter Property="TextColor" Value="{StaticResource Error}"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding HuboErrores}" Value="False">
                            <Setter Property="TextColor" Value="{StaticResource Accent}"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

            </VerticalStackLayout>
        </Border>

            <!-- ===================== Búsqueda + Filtro ===================== -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource BorderColor}"
                        BackgroundColor="{StaticResource White}"
                        Padding="14,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="&#128269;" FontSize="16" VerticalOptions="Center" Margin="0,0,8,0"/>
                        <Entry Grid.Column="1"
                               Placeholder="{Binding CampoFiltro, StringFormat='Buscar por {0}...'}"
                               Text="{Binding TextoBusqueda}"
                               TextColor="{StaticResource TextPrimary}"
                               PlaceholderColor="{StaticResource TextLight}"
                               FontSize="14"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource BorderColor}"
                        BackgroundColor="{StaticResource White}"
                        WidthRequest="48"
                        HeightRequest="48"
                        Padding="0">
                    <Button Text="&#9881;"
                            Command="{Binding AbrirFiltrosCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextPrimary}"
                            FontSize="18"
                            Padding="0"/>
                </Border>
            </Grid>

                <!-- ======================== Filtro de fechas ========================== -->
                <Border BackgroundColor="White">
                <VerticalStackLayout Spacing="4">
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding FiltroFechaActivo}" />
                        <Label Text="Filtrar por fecha"
                            FontSize="14"
                            VerticalOptions="Center"
                            FontAttributes="Bold" />        
                    </HorizontalStackLayout>

                    <Grid IsVisible="{Binding FiltroFechaActivo}"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="8"
                          Margin="0,0,0,8">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Desde" VerticalOptions="Center" />
                            <DatePicker Date="{Binding FechaDesde}"
                                        Format="dd/MM/yyyy"
                                        MaximumDate="{Binding FechaHasta}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Hasta" VerticalOptions="Center" />
                            <DatePicker Date="{Binding FechaHasta}"
                                        Format="dd/MM/yyyy"
                                        MinimumDate="{Binding FechaDesde}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

       <!-- ===================== Botón Ordenar (reemplaza el Button de texto plano) ===================== -->
            <Border StrokeShape="RoundRectangle 10"
                     Stroke="{StaticResource BorderColor}"
                     BackgroundColor="{StaticResource White}"
                     Padding="12,0"
                     HeightRequest="40">
              <Border.GestureRecognizers>
                     <TapGestureRecognizer Command="{Binding OrdenarCommand}"/>
              </Border.GestureRecognizers>
                     <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Path Data="M4,7 L20,7 M7,12 L17,12 M10,17 L14,17"
                                   Stroke="{StaticResource TextMuted}"
                                   StrokeThickness="1.6"
                                   StrokeLineCap="Round"
                                   WidthRequest="16"
                                   HeightRequest="16"
                                   Aspect="Uniform"
                                   VerticalOptions="Center"/>
                            <Label Text="{Binding OrdenTexto}"
                                   FontSize="13"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"/>
                     </HorizontalStackLayout>
              </Border>

              <Border StrokeShape="RoundRectangle 12"
                     BackgroundColor="{StaticResource Primary}"
                     Stroke="Transparent"
                     HeightRequest="50"
                     Padding="0"
                     Opacity="{Binding PuedeDescargar, Converter={StaticResource BoolToOpacityConverter}}"
                     IsEnabled="{Binding PuedeDescargar}">
                     <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DescargarCommand}"/>
                     </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                   <Path Data="M12,4 L12,14 M7,9 L12,14 L17,9 M5,19 L19,19"
                                                 IsVisible="{Binding DescargandoArchivo, Converter={StaticResource InverseBoolConverter}}"
                                                 Stroke="{StaticResource White}"
                                                 StrokeThickness="2"
                                                 StrokeLineCap="Round"
                                                 StrokeLineJoin="Round"
                                                 WidthRequest="18"
                                                 HeightRequest="18"
                                                 Aspect="Uniform"/>
                            <ActivityIndicator IsRunning="{Binding DescargandoArchivo}"
                                                IsVisible="{Binding DescargandoArchivo}"
                                                Color="{StaticResource White}"
                                                WidthRequest="18"
                                                HeightRequest="18"/>
                            <Label Text="{Binding TextoBotonDescargar}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource White}"/>
                     </HorizontalStackLayout>
              </Border>

       <!-- ===================== Paginación + Ordenar ===================== -->
       <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5">

              <!-- Flecha anterior -->
              <Border Grid.Column="0"
                     StrokeShape="RoundRectangle 20"
                     Stroke="{StaticResource BorderColor}"
                     BackgroundColor="Transparent"
                     WidthRequest="40"
                     HeightRequest="40"
                     Padding="0"
                     Opacity="{Binding PuedeIrAnterior, Converter={StaticResource BoolToOpacityConverter}}"
                     IsEnabled="{Binding PuedeIrAnterior}">
                     <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PaginaAnteriorCommand}"/>
                     </Border.GestureRecognizers>
                     <Path Data="M15,6 L9,12 L15,18"
                                   Stroke="{StaticResource TextMuted}"
                                   StrokeThickness="2"
                                   StrokeLineCap="Round"
                                   StrokeLineJoin="Round"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   Aspect="Uniform"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
              </Border>

              <Label Grid.Column="1"
                     Text="{Binding RangoRegistrosTexto}"
                     FontSize="13"
                     TextColor="{StaticResource TextMuted}"
                     VerticalOptions="Center"
                     HorizontalOptions="Center"/>

              <!-- Flecha siguiente -->
              <Border Grid.Column="2"
                     StrokeShape="RoundRectangle 20"
                     Stroke="{StaticResource BorderColor}"
                     BackgroundColor="Transparent"
                     WidthRequest="40"
                     HeightRequest="40"
                     Padding="0"
                     Opacity="{Binding PuedeIrSiguiente, Converter={StaticResource BoolToOpacityConverter}}"
                     IsEnabled="{Binding PuedeIrSiguiente}">
                     <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PaginaSiguienteCommand}"/>
                     </Border.GestureRecognizers>
                     <Path Data="M9,6 L15,12 L9,18"
                                   Stroke="{StaticResource TextMuted}"
                                   StrokeThickness="2"
                                   StrokeLineCap="Round"
                                   StrokeLineJoin="Round"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   Aspect="Uniform"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
              </Border>
       </Grid>



            <!-- ===================== Indicador de carga ===================== -->
            <ActivityIndicator IsRunning="{Binding CargandoActividades}"
                                IsVisible="{Binding CargandoActividades}"
                                Color="{StaticResource Primary}"/>

            <!-- ===================== Lista de tarjetas (sin ScrollView propio) ===================== -->
            <VerticalStackLayout Spacing="12"
                                  BindableLayout.ItemsSource="{Binding Actividades}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ActividadCargaItem">
                        <Border StrokeShape="RoundRectangle 14"
                                Stroke="{StaticResource BorderColor}"
                                BackgroundColor="{StaticResource White}"
                                Padding="16">
                            <VerticalStackLayout Spacing="10">

                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Colaborador}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                        <Label Text="{Binding Proyecto}" FontSize="13" TextColor="{StaticResource TextMuted}"/>
                                    </VerticalStackLayout>

                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding IsSeleccionado}"
                                              Color="{StaticResource Primary}"
                                              VerticalOptions="Start"/>
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="{StaticResource BackgroundLight}"/>

                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="{StaticResource PrimaryLight}"
                                            Stroke="Transparent"
                                            Padding="12,4"
                                            HorizontalOptions="Start">
                                        <Label Text="{Binding Cliente}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                                    </Border>

                                    <Label Grid.Column="1" Text="{Binding FechaTexto}" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                    <Label Grid.Column="2" Text="·" FontSize="13" TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                                    <Label Grid.Column="3" Text="{Binding HorasTexto}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                </Grid>

                                <HorizontalStackLayout Spacing="6">
                                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                             Color="{Binding Estado, Converter={StaticResource EstadoToColorConverter}}"/>
                                    <Label Text="{Binding Estado}" FontSize="13" FontAttributes="Bold"
                                           TextColor="{Binding Estado, Converter={StaticResource EstadoToColorConverter}}"/>
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
        
        </ScrollView>

        <shared:BottomNavBar VerticalOptions="End" />
    </Grid>
</ContentPage>
