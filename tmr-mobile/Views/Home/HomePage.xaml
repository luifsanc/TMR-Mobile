<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.Home.HomePage"
             Title="Módulos"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkBackgroundLight}}"
             x:DataType="vm:HomeViewModel">

    <ContentPage.Resources>
        <x:Double x:Key="ModuleCardWidth">140</x:Double>
        <x:Double x:Key="ModuleCardHeight">110</x:Double>
        <x:Double x:Key="ModuleIconSize">32</x:Double>
        <x:Double x:Key="ModuleTextSize">14</x:Double>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Modal menu header -->
        <Border Grid.Row="0"
                Margin="20,16,20,8"
                Padding="14,9,8,9"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="¿Qué quieres hacer hoy?"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}"
                       VerticalOptions="Center" />

                <Border Grid.Column="1"
                        WidthRequest="28"
                        HeightRequest="28"
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 14"
                        SemanticProperties.Description="Cerrar menú">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="×"
                           FontSize="20"
                           TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Modules Grid -->
        <ScrollView Grid.Row="1"
                    Margin="20,8,20,24"
                    Orientation="Vertical"
                    VerticalScrollBarVisibility="Never">
            <FlexLayout x:Name="ModulesLayout"
                        BindableLayout.ItemsSource="{Binding Modulos}"
                        Direction="Row"
                        Wrap="Wrap"
                        AlignItems="Start"
                        AlignContent="Start"
                        JustifyContent="SpaceBetween"
                        SizeChanged="OnModulesLayoutSizeChanged">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModuloItem">
                        <Border WidthRequest="{DynamicResource ModuleCardWidth}"
                                HeightRequest="{DynamicResource ModuleCardHeight}"
                                Margin="0,0,0,12"
                                Padding="10"
                                StrokeShape="RoundRectangle 16"
                                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkSurfaceElevated}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=NavigateCommand}"
                                                      CommandParameter="{Binding Ruta}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 Spacing="10">
                                <Grid WidthRequest="{DynamicResource ModuleIconSize}"
                                      HeightRequest="{DynamicResource ModuleIconSize}"
                                      HorizontalOptions="Center">
                                    <Image Source="{Binding Icono}"
                                           WidthRequest="{DynamicResource ModuleIconSize}"
                                           HeightRequest="{DynamicResource ModuleIconSize}"
                                           IsVisible="{AppThemeBinding Light=True, Dark=False}" />
                                    <Image Source="{Binding IconoOscuro}"
                                           WidthRequest="{DynamicResource ModuleIconSize}"
                                           HeightRequest="{DynamicResource ModuleIconSize}"
                                           IsVisible="{AppThemeBinding Light=False, Dark=True}" />
                                </Grid>
                                <Label Text="{Binding Nombre}"
                                       FontSize="{DynamicResource ModuleTextSize}"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </ScrollView>
    </Grid>
</ContentPage>
