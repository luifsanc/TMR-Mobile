<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels" x:Class="tmr_mobile.Views.Auth.AppPreferencesPage"
             x:DataType="vm:AppPreferencesViewModel" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}" Title="Configuración">
    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSurfaceColor}}" /><Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" /><Setter Property="StrokeThickness" Value="1" /><Setter Property="StrokeShape" Value="RoundRectangle 18" /><Setter Property="Padding" Value="18" /><Setter Property="HorizontalOptions" Value="Fill" /></Style>
        <Style x:Key="Title" TargetType="Label"><Setter Property="FontFamily" Value="InterSemiBold" /><Setter Property="FontSize" Value="15" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextPrimary}}" /></Style>
        <Style x:Key="Caption" TargetType="Label"><Setter Property="FontFamily" Value="InterRegular" /><Setter Property="FontSize" Value="12" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextLight}}" /></Style>
        <Style x:Key="Section" TargetType="Label"><Setter Property="FontFamily" Value="InterSemiBold" /><Setter Property="FontSize" Value="12" /><Setter Property="CharacterSpacing" Value="1.2" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextLight}}" /><Setter Property="Margin" Value="4,0,0,0" /></Style>
        <Style x:Key="NotificationSwitch" TargetType="Switch">
            <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" /><Setter Property="ThumbColor" Value="{StaticResource White}" /><Setter Property="Scale" Value="1.08" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="On"><VisualState.Setters><Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" /><Setter Property="ThumbColor" Value="{StaticResource White}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Off"><VisualState.Setters><Setter Property="ThumbColor" Value="{StaticResource White}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                </VisualStateGroup></VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="16,18,24,14" ColumnDefinitions="48,*" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSurfaceColor}}">
            <Button Text="‹" Command="{Binding GoBackCommand}" FontFamily="InterRegular" FontSize="32" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkTextPrimary}}" BackgroundColor="Transparent" Padding="0" WidthRequest="44" HeightRequest="44" />
            <Label Grid.Column="1" Text="Configuración" FontFamily="InterSemiBold" FontSize="19" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkTextPrimary}}" VerticalOptions="Center" />
        </Grid>
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,22,24,36" Spacing="12">
                <Label Text="APARIENCIA" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8"><Label Text="Tema de la aplicación" Style="{StaticResource Title}" /><Label Text="Elige cómo quieres ver TMR" Style="{StaticResource Caption}" />
                        <Picker ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" FontFamily="InterRegular" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextPrimary}}" Title="Selecciona un tema" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="NOTIFICACIONES" Style="{StaticResource Section}" Margin="4,10,0,0" />
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,72"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="5"
                          MinimumHeightRequest="72"
                          HorizontalOptions="FillAndExpand">
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="Notificaciones"
                               Style="{StaticResource Title}"
                               LineBreakMode="TailTruncation" />
                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Text="Recibe avisos importantes de TMR"
                               Style="{StaticResource Caption}"
                               MaxLines="2"
                               LineBreakMode="WordWrap" />
                        <Grid Grid.RowSpan="2"
                              Grid.Column="1"
                              WidthRequest="72"
                              HorizontalOptions="End"
                              VerticalOptions="Fill">
                            <Switch IsToggled="{Binding NotificationsEnabled}"
                                    Style="{StaticResource NotificationSwitch}"
                                    WidthRequest="54"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="Activar o desactivar notificaciones" />
                        </Grid>
                    </Grid>
                </Border>
                <Label Text="REGIÓN Y FORMATO" Style="{StaticResource Section}" Margin="4,10,0,0" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="15">
                        <VerticalStackLayout Spacing="5"><Label Text="Formato de fecha" Style="{StaticResource Title}" /><Picker ItemsSource="{Binding DateFormats}" SelectedItem="{Binding SelectedDateFormat}" FontFamily="InterRegular" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextPrimary}}" /></VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" />
                        <VerticalStackLayout Spacing="5"><Label Text="Formato de hora" Style="{StaticResource Title}" /><Picker ItemsSource="{Binding TimeFormats}" SelectedItem="{Binding SelectedTimeFormat}" FontFamily="InterRegular" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextPrimary}}" /></VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Label Text="Las preferencias se guardan automáticamente en este dispositivo." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" Margin="8,8" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
