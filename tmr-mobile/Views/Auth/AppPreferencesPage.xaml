<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels" x:Class="tmr_mobile.Views.Auth.AppPreferencesPage"
             x:DataType="vm:AppPreferencesViewModel" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark=#101827}" Title="Configuración">
    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark=#1E293B}" /><Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderColor}, Dark=#334155}" /><Setter Property="StrokeThickness" Value="1" /><Setter Property="StrokeShape" Value="RoundRectangle 18" /><Setter Property="Padding" Value="18" /></Style>
        <Style x:Key="Title" TargetType="Label"><Setter Property="FontFamily" Value="InterSemiBold" /><Setter Property="FontSize" Value="15" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMain}, Dark=#F8FAFC}" /></Style>
        <Style x:Key="Caption" TargetType="Label"><Setter Property="FontFamily" Value="InterRegular" /><Setter Property="FontSize" Value="12" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMuted}, Dark=#94A3B8}" /></Style>
        <Style x:Key="Section" TargetType="Label"><Setter Property="FontFamily" Value="InterSemiBold" /><Setter Property="FontSize" Value="12" /><Setter Property="CharacterSpacing" Value="1.2" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMuted}, Dark=#94A3B8}" /><Setter Property="Margin" Value="4,0,0,0" /></Style>
        <Style x:Key="NotificationSwitch" TargetType="Switch">
            <Setter Property="OnColor" Value="{StaticResource Primary}" /><Setter Property="ThumbColor" Value="{StaticResource White}" /><Setter Property="Scale" Value="1.08" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="On"><VisualState.Setters><Setter Property="OnColor" Value="{StaticResource Primary}" /><Setter Property="ThumbColor" Value="{StaticResource White}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Off"><VisualState.Setters><Setter Property="ThumbColor" Value="{StaticResource White}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                </VisualStateGroup></VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="16,18,24,14" ColumnDefinitions="48,*" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark=#1E293B}">
            <Button Text="‹" Command="{Binding GoBackCommand}" FontFamily="InterRegular" FontSize="32" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#F8FAFC}" BackgroundColor="Transparent" Padding="0" WidthRequest="44" HeightRequest="44" />
            <Label Grid.Column="1" Text="Configuración" FontFamily="InterSemiBold" FontSize="19" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#F8FAFC}" VerticalOptions="Center" />
        </Grid>
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,22,24,36" Spacing="12">
                <Label Text="APARIENCIA" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8"><Label Text="Tema de la aplicación" Style="{StaticResource Title}" /><Label Text="Elige cómo quieres ver TMR" Style="{StaticResource Caption}" />
                        <Picker ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" FontFamily="InterRegular" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark=#F8FAFC}" Title="Selecciona un tema" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="NOTIFICACIONES" Style="{StaticResource Section}" Margin="4,10,0,0" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18"><VerticalStackLayout Spacing="3"><Label Text="Notificaciones" Style="{StaticResource Title}" /><Label Text="Recibe avisos importantes de TMR" Style="{StaticResource Caption}" /></VerticalStackLayout><Switch Grid.Column="1" IsToggled="{Binding NotificationsEnabled}" Style="{StaticResource NotificationSwitch}" HorizontalOptions="End" VerticalOptions="Center" /></Grid>
                    </VerticalStackLayout>
                </Border>
                <Label Text="REGIÓN Y FORMATO" Style="{StaticResource Section}" Margin="4,10,0,0" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="15">
                        <VerticalStackLayout Spacing="5"><Label Text="Formato de fecha" Style="{StaticResource Title}" /><Picker ItemsSource="{Binding DateFormats}" SelectedItem="{Binding SelectedDateFormat}" FontFamily="InterRegular" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark=#F8FAFC}" /></VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark=#334155}" />
                        <VerticalStackLayout Spacing="5"><Label Text="Formato de hora" Style="{StaticResource Title}" /><Picker ItemsSource="{Binding TimeFormats}" SelectedItem="{Binding SelectedTimeFormat}" FontFamily="InterRegular" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark=#F8FAFC}" /></VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Label Text="Las preferencias se guardan automáticamente en este dispositivo." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" Margin="8,8" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
