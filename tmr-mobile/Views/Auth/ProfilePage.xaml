<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
             x:Class="tmr_mobile.Views.Auth.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F6F8FC"
             Title="Perfil">

    <Grid RowDefinitions="*,80">
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,32,24,32" Spacing="24">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Mi perfil"
                           FontFamily="InterSemiBold"
                           FontSize="28"
                           TextColor="#163572" />
                    <Label Text="Administra la seguridad de tu cuenta"
                           FontFamily="InterRegular"
                           FontSize="14"
                           TextColor="#64748B" />
                </VerticalStackLayout>

                <Border BackgroundColor="White"
                        Stroke="#E8EDF5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="22">
                    <Border.Shadow>
                        <Shadow Brush="#163572" Opacity="0.08" Radius="18" Offset="0,6" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="64,*" ColumnSpacing="16">
                        <Border WidthRequest="64"
                                HeightRequest="64"
                                BackgroundColor="#EAF1FA"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 32">
                            <Image Source="user_profile.png"
                                   WidthRequest="28"
                                   HeightRequest="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="4">
                            <Label Text="{Binding UserName}"
                                   FontFamily="InterSemiBold"
                                   FontSize="20"
                                   TextColor="#163572"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Email}"
                                   FontFamily="InterRegular"
                                   FontSize="13"
                                   TextColor="#64748B"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label Text="SEGURIDAD"
                           FontFamily="InterSemiBold"
                           FontSize="12"
                           CharacterSpacing="1.2"
                           TextColor="#64748B"
                           Margin="4,0,0,2" />

                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangePasswordCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="46"
                                    HeightRequest="46"
                                    BackgroundColor="#EAF1FA"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 13">
                                <Image Source="key_icon.png"
                                       WidthRequest="22"
                                       HeightRequest="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Cambiar contraseña"
                                       FontFamily="InterSemiBold"
                                       FontSize="15"
                                       TextColor="#163572" />
                                <Label Text="Actualiza tu clave de acceso"
                                       FontFamily="InterRegular"
                                       FontSize="12"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontFamily="InterRegular"
                                   FontSize="28"
                                   TextColor="#94A3B8"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border BackgroundColor="White"
                            Stroke="#FECACA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="46"
                                    HeightRequest="46"
                                    BackgroundColor="#FEF2F2"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 13">
                                <Image Source="logout_icon.png"
                                       WidthRequest="22"
                                       HeightRequest="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Cerrar sesión"
                                       FontFamily="InterSemiBold"
                                       FontSize="15"
                                       TextColor="#B42318" />
                                <Label Text="Salir de este dispositivo"
                                       FontFamily="InterRegular"
                                       FontSize="12"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>
                            <ActivityIndicator Grid.Column="2"
                                               IsVisible="{Binding IsBusy}"
                                               IsRunning="{Binding IsBusy}"
                                               Color="#B42318"
                                               WidthRequest="22"
                                               HeightRequest="22"
                                               VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <shared:BottomNavBar Grid.Row="1" />
    </Grid>
</ContentPage>
