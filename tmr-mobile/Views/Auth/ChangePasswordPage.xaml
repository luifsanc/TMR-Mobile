<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.Auth.ChangePasswordPage"
             x:DataType="vm:ChangePasswordViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F6F8FC"
             Title="Cambiar contraseña">

    <ContentPage.Resources>
        <Style x:Key="PasswordLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="InterSemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="#374151" />
        </Style>
        <Style x:Key="PasswordEntry" TargetType="Entry">
            <Setter Property="FontFamily" Value="InterRegular" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="#1F2937" />
            <Setter Property="PlaceholderColor" Value="#94A3B8" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="ToggleButton" TargetType="Button">
            <Setter Property="Text" Value="Ver" />
            <Setter Property="FontFamily" Value="InterSemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="#163572" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinimumWidthRequest" Value="48" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0"
              ColumnDefinitions="48,*"
              Padding="16,18,24,14"
              BackgroundColor="White">
            <Button Text="‹"
                    Command="{Binding GoBackCommand}"
                    FontFamily="InterRegular"
                    FontSize="32"
                    TextColor="#163572"
                    BackgroundColor="Transparent"
                    Padding="0"
                    WidthRequest="44"
                    HeightRequest="44" />
            <Label Grid.Column="1"
                   Text="Cambiar contraseña"
                   FontFamily="InterSemiBold"
                   FontSize="19"
                   TextColor="#163572"
                   VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,24,24,36" Spacing="20">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Protege tu cuenta"
                           FontFamily="InterSemiBold"
                           FontSize="24"
                           TextColor="#163572" />
                    <Label Text="Ingresa tu contraseña actual y define una nueva clave de acceso."
                           FontFamily="InterRegular"
                           FontSize="14"
                           LineHeight="1.35"
                           TextColor="#64748B" />
                </VerticalStackLayout>

                <Border BackgroundColor="White"
                        Stroke="#E8EDF5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="#163572" Opacity="0.07" Radius="16" Offset="0,5" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="17">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="Contraseña actual" Style="{StaticResource PasswordLabel}" />
                            <Border BackgroundColor="White" Stroke="#D1D5DB" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="12,0,4,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Text="{Binding OldPassword}"
                                           IsPassword="{Binding IsOldPasswordHidden}"
                                           Placeholder="Ingresa tu contraseña actual"
                                           ReturnType="Next"
                                           Style="{StaticResource PasswordEntry}" />
                                    <Button Grid.Column="1" Command="{Binding ToggleOldPasswordCommand}" Style="{StaticResource ToggleButton}" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="Nueva contraseña" Style="{StaticResource PasswordLabel}" />
                            <Border BackgroundColor="White" Stroke="#D1D5DB" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="12,0,4,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Text="{Binding NewPassword}"
                                           IsPassword="{Binding IsNewPasswordHidden}"
                                           Placeholder="Mínimo 6 caracteres"
                                           ReturnType="Next"
                                           Style="{StaticResource PasswordEntry}" />
                                    <Button Grid.Column="1" Command="{Binding ToggleNewPasswordCommand}" Style="{StaticResource ToggleButton}" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="Confirmar nueva contraseña" Style="{StaticResource PasswordLabel}" />
                            <Border BackgroundColor="White" Stroke="#D1D5DB" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="12,0,4,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Text="{Binding ConfirmPassword}"
                                           IsPassword="{Binding IsConfirmPasswordHidden}"
                                           Placeholder="Repite la nueva contraseña"
                                           ReturnType="Done"
                                           Style="{StaticResource PasswordEntry}" />
                                    <Button Grid.Column="1" Command="{Binding ToggleConfirmPasswordCommand}" Style="{StaticResource ToggleButton}" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <Label Text="No podrás reutilizar una de tus últimas 5 contraseñas."
                               FontFamily="InterRegular"
                               FontSize="12"
                               TextColor="#64748B" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                        BackgroundColor="#FEF2F2"
                        Stroke="#FECACA"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="13">
                    <Label Text="{Binding ErrorMessage}"
                           FontFamily="InterRegular"
                           FontSize="13"
                           TextColor="#B42318" />
                </Border>

                <Border IsVisible="{Binding SuccessMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                        BackgroundColor="#ECFDF3"
                        Stroke="#ABEFC6"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="13">
                    <Label Text="{Binding SuccessMessage}"
                           FontFamily="InterSemiBold"
                           FontSize="13"
                           TextColor="#067647" />
                </Border>

                <Button Text="Actualizar contraseña"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        HeightRequest="52"
                        CornerRadius="10"
                        FontFamily="InterSemiBold"
                        FontSize="15"
                        BackgroundColor="#0C3B73"
                        TextColor="White" />

                <ActivityIndicator IsVisible="{Binding IsBusy}"
                                   IsRunning="{Binding IsBusy}"
                                   Color="#163572"
                                   HeightRequest="28" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
