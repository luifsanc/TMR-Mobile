<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    x:Class="tmr_mobile.Views.Auth.ForgotPasswordPage"
    x:DataType="vm:ForgotPasswordViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled"
    BackgroundColor="{StaticResource Primary}">

    <Grid>

        <!-- Fondo -->
        <BoxView Color="{StaticResource Primary}" />

        <Image
            Source="background.png"
            Aspect="AspectFill"
            Opacity="1"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <!-- Contenido -->
        <ScrollView VerticalScrollBarVisibility="Never">

            <Grid
                Padding="24"
                MinimumHeightRequest="700">

                <!-- Tarjeta -->
                <Border
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="370"
                    Padding="28,30"
                    BackgroundColor="{StaticResource White}"
                    StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="{StaticResource TextPrimary}"
                            Offset="0,6"
                            Radius="18"
                            Opacity="0.18" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="0">

                        <!-- Volver -->
                        <Label
                            Text="← Regresar"
                            TextColor="{StaticResource Primary}"
                            FontSize="14"
                            HorizontalOptions="Start"
                            Margin="0,0,0,24">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding GoBackCommand}" />
                            </Label.GestureRecognizers>

                        </Label>

                        <!-- Logo -->
                        <Image
                            Source="logo_isc1.png"
                            HeightRequest="80"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            Margin="0,0,0,18" />

                        <!-- Título -->
                        <Label
                            Text="Recuperar contraseña"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Primary}"
                            HorizontalTextAlignment="Center"
                            Margin="0,0,0,12" />

                        <!-- Descripción -->
                        <Label
                            Text="Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña."
                            FontSize="14"
                            TextColor="{StaticResource TextMuted}"
                            HorizontalTextAlignment="Center"
                            LineHeight="1.3"
                            Margin="0,0,0,24" />

                        <!-- ÉXITO -->
                        <Border
                            IsVisible="{Binding IsSuccess}"
                            BackgroundColor="{StaticResource SuccessSurface}"
                            Stroke="{StaticResource SuccessSurface}"
                            StrokeThickness="1"
                            Padding="14"
                            Margin="0,0,0,16">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="5">

                                <Label
                                    Text="✓ ¡Éxito!"
                                    TextColor="{StaticResource SuccessText}"
                                    FontSize="14"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding SuccessMessage}"
                                    TextColor="{StaticResource SuccessText}"
                                    FontSize="13" />

                                <Label
                                    Text="Serás redirigido al inicio de sesión..."
                                    TextColor="{StaticResource SuccessText}"
                                    FontSize="12"
                                    FontAttributes="Italic" />

                            </VerticalStackLayout>

                        </Border>

                        <!-- FORMULARIO -->
                        <VerticalStackLayout
                            IsVisible="{Binding IsFormVisible}"
                            Spacing="0">

                            <!-- Correo -->
                            <Border
                                HeightRequest="52"
                                BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource BorderColor}"
                                StrokeThickness="1"
                                Padding="14,0"
                                Margin="0,0,0,6">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>

                                <Entry
                                    Text="{Binding Email}"
                                    Placeholder="Correo electrónico"
                                    PlaceholderColor="{StaticResource TextLight}"
                                    TextColor="{StaticResource TextMain}"
                                    Keyboard="Email"
                                    FontSize="14"
                                    BackgroundColor="Transparent"
                                    Margin="0"
                                    VerticalOptions="Center" />

                            </Border>

                            <!-- Validación del correo -->
                            <Label
                                Text="{Binding EmailError}"
                                IsVisible="{Binding HasEmailError}"
                                TextColor="{StaticResource Error}"
                                FontSize="12"
                                Margin="2,0,0,14" />

                            <!-- Error del servidor -->
                            <Label
                                Text="{Binding ErrorMessage}"
                                TextColor="{StaticResource ErrorText}"
                                FontSize="12"
                                HorizontalTextAlignment="Center"
                                Margin="0,0,0,14" />

                            <!-- Botón -->
                            <Button
                                Text="Enviar enlace"
                                Command="{Binding SendLinkCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                HeightRequest="50"
                                CornerRadius="8"
                                BackgroundColor="{StaticResource TextLight}"
                                TextColor="{StaticResource White}"
                                FontSize="14"
                                FontAttributes="Bold" />

                            <!-- Cargando -->
                            <ActivityIndicator
                                IsVisible="{Binding IsBusy}"
                                IsRunning="{Binding IsBusy}"
                                Color="{StaticResource Primary}"
                                HeightRequest="28"
                                HorizontalOptions="Center"
                                Margin="0,10,0,0" />

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>

            </Grid>

        </ScrollView>

    </Grid>

</ContentPage>
