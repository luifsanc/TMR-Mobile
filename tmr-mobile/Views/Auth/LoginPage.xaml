<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <Grid>
        <Image Source="Resources/Images/background.png"
               Aspect="AspectFill"
               Opacity="0.9"
               VerticalOptions="Fill"
               HorizontalOptions="Fill" />

        <ScrollView>
            <Grid Padding="24" MinimumHeightRequest="600">
                <VerticalStackLayout Spacing="24" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="380">
                    <VerticalStackLayout Spacing="24" BackgroundColor="Transparent">
                        <Image Source="Resources/Images/logo_isc.png"
                               HeightRequest="100"
                               HorizontalOptions="Center" />

                        <Border Style="{StaticResource CardBorderStyle}">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource Gray200Brush}" Offset="0,8" Radius="20" Opacity="0.12" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="20">
                                <Label Text="Iniciar Sesión"
                                       Style="{StaticResource TitleLarge}" />

                                <Label Text="Accede a tu cuenta para ver tus actividades y reportes"
                                       Style="{StaticResource Subtitle}" />

                                <VerticalStackLayout Spacing="16">
                                    <Entry Placeholder="Correo electrónico"
                                           Style="{StaticResource PrimaryEntryStyle}"
                                           Text="{Binding User}"
                                           Keyboard="Email" />

                                    <Entry Placeholder="Contraseña"
                                           Style="{StaticResource PrimaryEntryStyle}"
                                           Text="{Binding Password}"
                                           IsPassword="True" />

                                    <Label Text="{Binding ErrorMessage}"
                                           Style="{StaticResource ErrorText}"
                                           IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

                                    <Button Text="Ingresar"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding LoginCommand}"
                                            IsEnabled="{Binding IsNotBusy}" />

                                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                                       IsVisible="{Binding IsBusy}"
                                                       HorizontalOptions="Center"
                                                       Color="{StaticResource Primary}" />
                                </VerticalStackLayout>

                                <Label Text="¿Olvidaste tu contraseña?"
                                       Style="{StaticResource LinkText}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
