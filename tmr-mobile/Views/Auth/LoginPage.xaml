<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    x:Class="tmr_mobile.Views.Auth.LoginPage"
    x:DataType="vm:LoginViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled"
    BackgroundColor="{StaticResource Primary}">

    <Grid>

      

        <!-- Imagen de fondo sutil, a pantalla completa -->
        <Image
            Source="background.png"
            Aspect="AspectFill"
            Opacity="1"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <!-- Contenido -->
        <ScrollView VerticalScrollBarVisibility="Never">

            <Grid Padding="24">

                <Border
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="340"
                    Padding="28,30"
                    BackgroundColor="{StaticResource White}"
                    StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="{StaticResource TextPrimary}"
                            Offset="0,5"
                            Radius="16"
                            Opacity="0.18" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="0">

                        <!-- Logo -->
                        <Image
                            Source="logo_isc1.png"
                            HeightRequest="90"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            Margin="0,0,0,20" />

                        <!-- Título -->
                        <Label
                            Text="Iniciar Sesión"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Primary}"
                            HorizontalTextAlignment="Center"
                            Margin="0,0,0,24" />

                        <!-- Correo -->
                        <Border
                            HeightRequest="54"
                            BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            Padding="14,0"
                            Margin="0,0,0,14">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Entry
                                StyleId="BorderlessAuthEntry"
                                Text="{Binding User}"
                                Placeholder="Correo electrónico"
                                PlaceholderColor="{StaticResource TextLight}"
                                TextColor="{StaticResource TextMain}"
                                Keyboard="Email"
                                FontSize="14"
                                BackgroundColor="Transparent"
                                Margin="0"
                                VerticalOptions="Center" />

                        </Border>

                        <!-- Contraseña -->
                        <Border
                            HeightRequest="54"
                            BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            Padding="14,0"
                            Margin="0,0,0,18">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*,Auto">
                                <Entry
                                    StyleId="BorderlessAuthEntry"
                                    Text="{Binding Password}"
                                    Placeholder="Contraseña"
                                    PlaceholderColor="{StaticResource TextLight}"
                                    TextColor="{StaticResource TextMain}"
                                    IsPassword="{Binding IsPasswordHidden}"
                                    FontSize="14"
                                    BackgroundColor="Transparent"
                                    Margin="0"
                                    VerticalOptions="Center">
                                    <Entry.Triggers>
                                        <MultiTrigger TargetType="Entry">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding IsPasswordHidden}"
                                                                  Value="True" />
                                                <BindingCondition Binding="{Binding Password, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                                                                  Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="FontSize" Value="11" />
                                        </MultiTrigger>
                                    </Entry.Triggers>
                                </Entry>

                                <ImageButton
                                    Grid.Column="1"
                                    Source="{Binding PasswordToggleIcon}"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    WidthRequest="46"
                                    HeightRequest="50"
                                    Padding="11"
                                    BackgroundColor="Transparent" />
                            </Grid>

                        </Border>

                        <!-- Error general -->
                        <Border
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                            BackgroundColor="{StaticResource ErrorSurface}"
                            Stroke="{StaticResource ErrorSurface}"
                            StrokeThickness="1"
                            Padding="10"
                            Margin="0,0,0,14">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Label
                                Text="{Binding ErrorMessage}"
                                FontSize="12"
                                TextColor="{StaticResource ErrorText}"
                                HorizontalTextAlignment="Center" />

                        </Border>

                        <!-- Botón -->
                        <Button
                            Text="Ingresar"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            HeightRequest="50"
                            CornerRadius="8"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            FontSize="15"
                            FontAttributes="Bold"
                            Margin="0,0,0,10" />

                        <!-- Loading -->
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{StaticResource Primary}"
                            HeightRequest="28"
                            HorizontalOptions="Center"
                            Margin="0,0,0,4" />

                        <!-- Recuperar contraseña -->
                        <Label
                            Text="¿Olvidaste tu contraseña?"
                            TextColor="{StaticResource Primary}"
                            FontSize="13"
                            HorizontalTextAlignment="Center"
                            HorizontalOptions="Center"
                            Padding="8">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnForgotPasswordTapped" />
                            </Label.GestureRecognizers>

                        </Label>

                    </VerticalStackLayout>

                </Border>

            </Grid>

        </ScrollView>

    </Grid>

</ContentPage>
