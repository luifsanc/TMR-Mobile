<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    x:Class="tmr_mobile.Views.Auth.LoginPage"
    x:DataType="vm:LoginViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled"
    BackgroundColor="#164B80">

    <Grid>

      

        <!-- Imagen de fondo sutil, a pantalla completa -->
        <Image
            Source="background.png"
            Aspect="AspectFill"
            Opacity="0"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <!-- Contenido -->
        <ScrollView VerticalScrollBarVisibility="Never">

            <Grid Padding="24">

                <Border
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="340"
                    Padding="28,30"
                    BackgroundColor="White"
                    StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Offset="0,5"
                            Radius="16"
                            Opacity="0.18" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="0">

                        <!-- Logo -->
                        <Image
                            Source="logo_isc.png"
                            HeightRequest="90"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            Margin="0,0,0,20" />

                        <!-- Título -->
                        <Label
                            Text="Iniciar Sesión"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="#173A54"
                            HorizontalTextAlignment="Center"
                            Margin="0,0,0,24" />

                        <!-- Correo -->
                        <Border
                            HeightRequest="54"
                            BackgroundColor="White"
                            Stroke="#D9D9D9"
                            StrokeThickness="1"
                            Padding="14,0"
                            Margin="0,0,0,14">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Entry
                                Text="{Binding User}"
                                Placeholder="Correo electrónico"
                                PlaceholderColor="#999999"
                                TextColor="#333333"
                                Keyboard="Email"
                                FontSize="14"
                                BackgroundColor="Transparent"
                                Margin="0"
                                VerticalOptions="Center" />

                        </Border>

                        <!-- Contraseña -->
                        <Border
                            HeightRequest="54"
                            BackgroundColor="White"
                            Stroke="#D9D9D9"
                            StrokeThickness="1"
                            Padding="14,0"
                            Margin="0,0,0,18">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Entry
                                Text="{Binding Password}"
                                Placeholder="Contraseña"
                                PlaceholderColor="#999999"
                                TextColor="#333333"
                                IsPassword="True"
                                FontSize="14"
                                BackgroundColor="Transparent"
                                Margin="0"
                                VerticalOptions="Center" />

                        </Border>

                        <!-- Error general -->
                        <Border
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                            BackgroundColor="#FFF1F1"
                            Stroke="#F3C1C1"
                            StrokeThickness="1"
                            Padding="10"
                            Margin="0,0,0,14">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Label
                                Text="{Binding ErrorMessage}"
                                FontSize="12"
                                TextColor="#B42318"
                                HorizontalTextAlignment="Center" />

                        </Border>

                        <!-- Botón -->
                        <Button
                            Text="Ingresar"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            HeightRequest="50"
                            CornerRadius="8"
                            BackgroundColor="#7486AD"
                            TextColor="White"
                            FontSize="15"
                            FontAttributes="Bold"
                            Margin="0,0,0,10" />

                        <!-- Loading -->
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="#173A54"
                            HeightRequest="28"
                            HorizontalOptions="Center"
                            Margin="0,0,0,4" />

                        <!-- Recuperar contraseña -->
                        <Label
                            Text="¿Olvidaste tu contraseña?"
                            TextColor="#0066CC"
                            FontSize="13"
                            HorizontalTextAlignment="Center"
                            HorizontalOptions="Center"
                            Padding="8">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnForgotPasswordTapped" />
                            </Label.GestureRecognizers>

                        </Label>

                    </VerticalStackLayout>

                </Border>

            </Grid>

        </ScrollView>

    </Grid>

</ContentPage>