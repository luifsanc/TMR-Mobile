<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="tmr_mobile.Views.Shared.BottomNavBar">

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
          ColumnDefinitions="*,46,60,46,*"
          HeightRequest="36"
          VerticalOptions="End">
         <!-- Top shadow / border -->
         <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" VerticalOptions="Start" Grid.ColumnSpan="5" />
         
         <!-- Home -->
         <VerticalStackLayout x:Name="DashboardButton"
                              Grid.Column="1"
                              VerticalOptions="Center"
                              HorizontalOptions="Center"
                              Spacing="2"
                              Loaded="OnDashboardButtonLoaded">
             <VerticalStackLayout.GestureRecognizers>
                 <TapGestureRecognizer Tapped="OnNavigate" CommandParameter="DashboardPage" />
             </VerticalStackLayout.GestureRecognizers>
             <Image Source="{AppThemeBinding Light=homes.png, Dark=homes_dark.png}"
                    WidthRequest="18" HeightRequest="18" Aspect="AspectFit"
                    HorizontalOptions="Center" VerticalOptions="Center" />
         </VerticalStackLayout>
         
         <!-- Center FAB -->
         <Grid Grid.Column="2" WidthRequest="54" HeightRequest="54" VerticalOptions="End" Margin="0,0,0,7">
              <Grid.GestureRecognizers>
                  <TapGestureRecognizer Tapped="OnNavigate" CommandParameter="HomePage" />
              </Grid.GestureRecognizers>
              <Border StrokeShape="RoundRectangle 27" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Stroke="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}" StrokeThickness="3" WidthRequest="54" HeightRequest="54" HorizontalOptions="Center" VerticalOptions="Center">
                   <Border StrokeShape="RoundRectangle 21" BackgroundColor="Transparent" WidthRequest="42" HeightRequest="42" HorizontalOptions="Center" VerticalOptions="Center" Stroke="Transparent">
                        <Image Source="{AppThemeBinding Light=isotipo1.png, Dark=isotipo2.png}"
                               WidthRequest="34"
                               HeightRequest="34"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               SemanticProperties.Description="Integrity Solutions" />
                   </Border>
              </Border>
         </Grid>

         <!-- Profile -->
         <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
             <VerticalStackLayout.GestureRecognizers>
                 <TapGestureRecognizer Tapped="OnNavigate" CommandParameter="ProfilePage" />
             </VerticalStackLayout.GestureRecognizers>
             <Image Source="{AppThemeBinding Light=user_profile.png, Dark=user_profile_dark.png}"
                    WidthRequest="18" HeightRequest="18" Aspect="AspectFit"
                    HorizontalOptions="Center" VerticalOptions="Center" />
         </VerticalStackLayout>
    </Grid>
</ContentView>
