<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="tmr_mobile.Views.Shared.TopNavBar">

    <Grid>
        <!-- Dropdown Menu Overlay -->
        <Border x:Name="DropdownMenu" 
                IsVisible="False" 
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Padding="0"
                WidthRequest="250"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,60,10,0"
                ZIndex="20">
            
            <VerticalStackLayout Spacing="0">
                <!-- Proyectos -->
                <Grid Padding="15" ColumnDefinitions="40,*" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavigate" CommandParameter="ProyectosPage" />
                    </Grid.GestureRecognizers>
                    <Image Grid.Column="0" Source="{AppThemeBinding Light=icon_proyectos.png, Dark=icon_proyectos_dark.png}" WidthRequest="24" HeightRequest="24" />
                    <Label Grid.Column="1" Text="Proyectos" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" />
                
                <!-- Time Report -->
                <Grid Padding="15" ColumnDefinitions="40,*" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavigate" CommandParameter="TimeReportPage" />
                    </Grid.GestureRecognizers>
                    <Image Grid.Column="0" Source="{AppThemeBinding Light=icon_timereport.png, Dark=icon_timereport_dark.png}" WidthRequest="24" HeightRequest="24" />
                    <Label Grid.Column="1" Text="Time Report" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" />

                <!-- Carga Actividades -->
                <Grid Padding="15" ColumnDefinitions="40,*" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavigate" CommandParameter="CargaActividadesPage" />
                    </Grid.GestureRecognizers>
                    <Image Grid.Column="0" Source="{AppThemeBinding Light=icon_carga.png, Dark=icon_carga_dark.png}" WidthRequest="24" HeightRequest="24" />
                    <Label Grid.Column="1" Text="Carga Actividades" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" />

                <!-- Reportes -->
                <Grid Padding="15" ColumnDefinitions="40,*" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavigate" CommandParameter="ReportesPage" />
                    </Grid.GestureRecognizers>
                    <Image Grid.Column="0" Source="{AppThemeBinding Light=icon_reportes.png, Dark=icon_reportes_dark.png}" WidthRequest="24" HeightRequest="24" />
                    <Label Grid.Column="1" Text="Reportes" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" />

                <!-- Líderes -->
                <Grid Padding="15" ColumnDefinitions="40,*" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavigate" CommandParameter="LideresPage" />
                    </Grid.GestureRecognizers>
                    <Image Grid.Column="0" Source="{AppThemeBinding Light=icon_lideres.png, Dark=icon_lideres_dark.png}" WidthRequest="24" HeightRequest="24" />
                    <Label Grid.Column="1" Text="Líderes" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" />

                <!-- Colaboradores -->
                <Grid Padding="15" ColumnDefinitions="40,*" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavigate" CommandParameter="ColaboradoresPage" />
                    </Grid.GestureRecognizers>
                    <Image Grid.Column="0" Source="icon_colaboradores.png" WidthRequest="24" HeightRequest="24" />
                    <Label Grid.Column="1" Text="Colaboradores" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" />

                <!-- Clientes -->
                <Grid Padding="15" ColumnDefinitions="40,*" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavigate" CommandParameter="ClientesPage" />
                    </Grid.GestureRecognizers>
                    <Image Grid.Column="0" Source="{AppThemeBinding Light=icon_clientes.png, Dark=icon_clientes_dark.png}" WidthRequest="24" HeightRequest="24" />
                    <Label Grid.Column="1" Text="Clientes" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" />
                
                <!-- Seguimiento -->
                <Grid Padding="15" ColumnDefinitions="40,*" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavigate" CommandParameter="SeguimientoPage" />
                    </Grid.GestureRecognizers>
                    <Image Grid.Column="0" Source="{AppThemeBinding Light=icon_seguimiento.png, Dark=icon_seguimiento_dark.png}" WidthRequest="24" HeightRequest="24" />
                    <Label Grid.Column="1" Text="Seguimiento" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                </Grid>
            </VerticalStackLayout>

        </Border>

        <!-- Main Top Bar -->
        <Grid BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
              HeightRequest="60" 
              VerticalOptions="Start"
              ColumnDefinitions="60,*,60"
              ZIndex="10">
              
            <!-- Columna 1: Logo y Texto -->
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                <Image Source="logo_empresa.png" HeightRequest="60" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Columna 2: Boton menu -->
            <ImageButton Grid.Column="2" Source="{AppThemeBinding Light=icon_menu.png, Dark=icon_menu_dark.png}" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" Clicked="OnMenuClicked"/>
        </Grid>
    </Grid>
</ContentView>
