<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="tmr_mobile.Views.Shared.ConfirmDialogPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource OverlaySoft}">

    <Grid Padding="20,32">
        <Border x:Name="DialogCard"
                MaximumWidthRequest="420"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource PrimaryLight}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="24,26,24,22">
            <Border.Shadow>
                <Shadow Brush="{StaticResource TextPrimary}"
                        Opacity="0.24"
                        Radius="28"
                        Offset="0,12" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="0">
                <Border WidthRequest="52"
                        HeightRequest="52"
                        HorizontalOptions="Start"
                        BackgroundColor="{StaticResource ErrorSurface}"
                        Stroke="{StaticResource ErrorSurface}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16">
                    <Label x:Name="IconLabel"
                           FontFamily="InterSemiBold"
                           FontSize="23"
                           TextColor="{StaticResource ErrorText}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>

                <Label x:Name="TitleLabel"
                       Margin="0,18,0,0"
                       FontFamily="InterSemiBold"
                       FontSize="21"
                       TextColor="{StaticResource Primary}"
                       LineHeight="1.15" />

                <Label x:Name="MessageLabel"
                       Margin="0,9,0,0"
                       FontFamily="InterRegular"
                       FontSize="14"
                       TextColor="{StaticResource TextMuted}"
                       LineHeight="1.35" />

                <BoxView Margin="0,24,0,20"
                         HeightRequest="1"
                         Color="{StaticResource PrimaryLight}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button x:Name="CancelButton"
                            Grid.Column="0"
                            Clicked="OnCancelClicked"
                            HeightRequest="48"
                            CornerRadius="11"
                            Padding="12,0"
                            FontFamily="InterSemiBold"
                            FontSize="14"
                            BackgroundColor="{StaticResource White}"
                            BorderColor="{StaticResource BorderColor}"
                            BorderWidth="1"
                            TextColor="{StaticResource TextMain}" />

                    <Button x:Name="ConfirmButton"
                            Grid.Column="1"
                            Clicked="OnConfirmClicked"
                            HeightRequest="48"
                            CornerRadius="11"
                            Padding="12,0"
                            FontFamily="InterSemiBold"
                            FontSize="14"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
