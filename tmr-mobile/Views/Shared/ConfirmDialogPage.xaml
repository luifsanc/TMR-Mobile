<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="tmr_mobile.Views.Shared.ConfirmDialogPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource OverlaySoft}, Dark={StaticResource DarkOverlaySoft}}">

    <Grid Padding="20,32">
        <Border x:Name="DialogCard"
                MaximumWidthRequest="420"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                Stroke="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="24,26,24,22">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                        Opacity="0.24"
                        Radius="28"
                        Offset="0,12" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="0">
                <Border WidthRequest="52"
                        HeightRequest="52"
                        HorizontalOptions="Start"
                        BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource DarkErrorSurface}}"
                        Stroke="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource DarkErrorSurface}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16">
                    <Label x:Name="IconLabel"
                           FontFamily="InterSemiBold"
                           FontSize="23"
                           TextColor="{StaticResource ErrorText}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>

                <Label x:Name="TitleLabel"
                       Margin="0,18,0,0"
                       FontFamily="InterSemiBold"
                       FontSize="21"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                       LineHeight="1.15" />

                <Label x:Name="MessageLabel"
                       Margin="0,9,0,0"
                       FontFamily="InterRegular"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource DarkTextMuted}}"
                       LineHeight="1.35" />

                <BoxView Margin="0,24,0,20"
                         HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button x:Name="CancelButton"
                            Grid.Column="0"
                            Clicked="OnCancelClicked"
                            HeightRequest="48"
                            CornerRadius="11"
                            Padding="12,0"
                            FontFamily="InterSemiBold"
                            FontSize="14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                            BorderColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                            BorderWidth="1"
                            TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}" />

                    <Button x:Name="ConfirmButton"
                            Grid.Column="1"
                            Clicked="OnConfirmClicked"
                            HeightRequest="48"
                            CornerRadius="11"
                            Padding="12,0"
                            FontFamily="InterSemiBold"
                            FontSize="14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                            TextColor="{StaticResource White}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
