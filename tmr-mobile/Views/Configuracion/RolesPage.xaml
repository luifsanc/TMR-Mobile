<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    xmlns:model="clr-namespace:tmr_mobile.Models.Configuracion"
    xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
    x:Class="tmr_mobile.Views.Configuracion.RolesPage"
    x:DataType="vm:RolesConfigViewModel"
    Title="Roles"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="*,80">
        <!-- Contenido principal y FAB en la fila superior -->
        <Grid Grid.Row="0">
            <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="14">

                <!-- TÍTULO DE LA PÁGINA -->
                <Label
                    Grid.Row="0"
                    Text="Roles"
                    FontSize="28"
                    FontAttributes="Bold"
                    FontFamily="InterSemiBold"
                    TextColor="#163572"
                    Margin="0,4,0,4" />

                <!-- BARRA DE BÚSQUEDA Y BOTONES DE FILTRO Y DESCARGA -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <!-- Input de Búsqueda -->
                    <Border
                        Grid.Column="0"
                        HeightRequest="44"
                        BackgroundColor="White"
                        Stroke="#D1D5DB"
                        StrokeThickness="1"
                        Padding="12,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                            <Image
                                Grid.Column="0"
                                Source="buscar_icon.png"
                                WidthRequest="18"
                                HeightRequest="18"
                                VerticalOptions="Center" />
                            <Entry
                                Grid.Column="1"
                                Text="{Binding Busqueda}"
                                Placeholder="Buscar por nombre, descripción o módulo..."
                                PlaceholderColor="#9CA3AF"
                                TextColor="#111827"
                                FontSize="13"
                                FontFamily="InterRegular"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Botón de Filtro de Estado -->
                    <Border
                        Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="White"
                        Stroke="#D1D5DB"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <ImageButton
                            Source="filtro_icon.png"
                            Command="{Binding CambiarFiltroEstadoCommand}"
                            Padding="11"
                            BackgroundColor="Transparent"
                            ToolTipProperties.Text="{Binding FiltroEstado}" />
                    </Border>

                    <!-- Botón de Descargar / Exportar -->
                    <Border
                        Grid.Column="2"
                        WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="White"
                        Stroke="#D1D5DB"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <ImageButton
                            Source="descargar_icon.png"
                            Padding="11"
                            BackgroundColor="Transparent" />
                    </Border>
                </Grid>

                <!-- CARDS ESTADÍSTICAS (Total Roles, Activos, Inactivos) -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <!-- Total Roles -->
                    <Border
                        Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        Padding="10,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
                        </Border.Shadow>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                            <Border
                                WidthRequest="34"
                                HeightRequest="34"
                                BackgroundColor="#F6EEFE"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label
                                    Text="☆"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#A855F7"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                <Label
                                    Text="{Binding TotalRoles}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    FontFamily="InterSemiBold"
                                    TextColor="#163572" />
                                <Label
                                    Text="Total roles"
                                    FontSize="10"
                                    FontFamily="InterRegular"
                                    TextColor="#6B7280" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Activos -->
                    <Border
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        Padding="10,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
                        </Border.Shadow>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                            <Border
                                WidthRequest="34"
                                HeightRequest="34"
                                BackgroundColor="#E6FDEE"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label
                                    Text="☆"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#16A34A"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                <Label
                                    Text="{Binding TotalActivos}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    FontFamily="InterSemiBold"
                                    TextColor="#163572" />
                                <Label
                                    Text="Activos"
                                    FontSize="10"
                                    FontFamily="InterRegular"
                                    TextColor="#6B7280" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Inactivos -->
                    <Border
                        Grid.Column="2"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        Padding="10,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
                        </Border.Shadow>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                            <Border
                                WidthRequest="34"
                                HeightRequest="34"
                                BackgroundColor="#F3F4F6"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label
                                    Text="☆"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#6B7280"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                <Label
                                    Text="{Binding TotalInactivos}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    FontFamily="InterSemiBold"
                                    TextColor="#163572" />
                                <Label
                                    Text="Inactivos"
                                    FontSize="10"
                                    FontFamily="InterRegular"
                                    TextColor="#6B7280" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- LISTA DE ROLES -->
                <CollectionView
                    Grid.Row="3"
                    ItemsSource="{Binding Roles}"
                    SelectionMode="None"
                    VerticalScrollBarVisibility="Never">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label
                                Text="No se encontraron roles."
                                TextColor="#6B7280"
                                FontSize="14"
                                FontFamily="InterRegular"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:RolListaItem">
                            <Border
                                Margin="0,0,0,12"
                                Padding="14,14"
                                BackgroundColor="White"
                                Stroke="#E5E7EB"
                                StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirDetalleCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <!-- Icono Avatar de Rol -->
                                    <Border
                                        Grid.Column="0"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        BackgroundColor="#F0F4FF"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="22" />
                                        </Border.StrokeShape>
                                        <Label
                                            Text="🛡"
                                            FontSize="18"
                                            TextColor="#163572"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />
                                    </Border>

                                    <!-- Información del Rol -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Nombre}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            FontFamily="InterSemiBold"
                                            TextColor="#163572"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Text="{Binding Descripcion}"
                                            FontSize="12"
                                            FontFamily="InterRegular"
                                            TextColor="#6B7280"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation" />
                                        <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                            <Border
                                                BackgroundColor="#EEF4FF"
                                                StrokeThickness="0"
                                                Padding="8,2">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6" />
                                                </Border.StrokeShape>
                                                <Label
                                                    Text="{Binding ModulosTexto}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    FontFamily="InterSemiBold"
                                                    TextColor="#163572"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Badge de Estado Pill con Punto (•) -->
                                    <Border
                                        Grid.Column="2"
                                        BackgroundColor="{Binding ColorFondoEstado}"
                                        StrokeThickness="0"
                                        Padding="10,4"
                                        VerticalOptions="Start"
                                        Margin="0,2,0,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                            <Label
                                                Text="•"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{Binding ColorTextoEstado}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Text="{Binding EstadoTexto}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                FontFamily="InterSemiBold"
                                                TextColor="{Binding ColorTextoEstado}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>

            <!-- FLOATING ACTION BUTTON (+) -->
            <Button
                Text="+"
                Command="{Binding NuevoCommand}"
                WidthRequest="52"
                HeightRequest="52"
                CornerRadius="26"
                BackgroundColor="#163572"
                TextColor="White"
                FontSize="24"
                FontAttributes="Bold"
                FontFamily="InterSemiBold"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Padding="0">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="6" Opacity="0.2" />
                </Button.Shadow>
            </Button>

            <!-- INDICADOR DE CARGA -->
            <ActivityIndicator
                IsVisible="{Binding IsBusy}"
                IsRunning="{Binding IsBusy}"
                Color="#163572"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>

        <!-- BARRA DE NAVEGACIÓN INFERIOR DE LA APP MÓVIL -->
        <shared:BottomNavBar Grid.Row="1" />
    </Grid>

</ContentPage>
