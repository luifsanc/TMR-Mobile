<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.Configuracion.RolesPage"
             x:DataType="vm:RolesConfigViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="20">
            <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#F5F3FF">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Roles y permisos" Style="{StaticResource PageHeaderTitleStyle}" />
                    <Label Text="Configura la matriz de seguridad del sistema como en la vista del frontend" Style="{StaticResource PageHeaderSubtitleStyle}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource ListCardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Cobertura" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="• Revisar permisos por módulo" Style="{StaticResource PageSubtitleStyle}" />
                    <Label Text="• Asignar accesos por rol" Style="{StaticResource PageSubtitleStyle}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
