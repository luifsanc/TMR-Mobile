<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    x:Class="tmr_mobile.Views.Configuracion.CatalogoDetallePage"
    x:DataType="vm:CatalogoDetalleViewModel"
    Title="Detalle"
    BackgroundColor="#F4F6FA">

    <ScrollView>

        <VerticalStackLayout
            Padding="18"
            Spacing="16">

            <!-- REGRESAR -->

            <HorizontalStackLayout>

                <Label
                    Text="‹"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#173A54"
                    VerticalTextAlignment="Center" />

                <Label
                    Text="Regresar"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#173A54"
                    VerticalTextAlignment="Center">

                    <Label.GestureRecognizers>

                        <TapGestureRecognizer
                            Command="{Binding RegresarCommand}" />

                    </Label.GestureRecognizers>

                </Label>

            </HorizontalStackLayout>


            <!-- TÍTULO -->

            <VerticalStackLayout
                Spacing="3">

                <Label
                    Text="Detalle del catálogo"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="#173A54" />

                <Label
                    Text="Información completa del registro seleccionado"
                    FontSize="13"
                    TextColor="#7486AD" />

            </VerticalStackLayout>


            <!-- CARD PRINCIPAL -->

            <Border
                BackgroundColor="White"
                Stroke="#E1E6EC"
                StrokeThickness="1"
                Padding="0">

                <Border.StrokeShape>

                    <RoundRectangle
                        CornerRadius="16" />

                </Border.StrokeShape>

                <Border.Shadow>

                    <Shadow
                        Brush="Black"
                        Offset="0,2"
                        Radius="8"
                        Opacity="0.08" />

                </Border.Shadow>


                <Grid
                    RowDefinitions="7,Auto">

                    <!-- ESTADO -->

                    <BoxView
                        Grid.Row="0"
                        Color="{Binding EstadoColor}" />


                    <VerticalStackLayout
                        Grid.Row="1"
                        Padding="18"
                        Spacing="18">


                        <!-- CÓDIGO -->

                        <VerticalStackLayout
                            Spacing="5">

                            <Label
                                Text="Código"
                                FontSize="11"
                                TextColor="#94A3B8" />

                            <Label
                                Text="{Binding Detalle.CodigoValor}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#173A54" />

                        </VerticalStackLayout>


                        <BoxView
                            HeightRequest="1"
                            Color="#EEF2F6" />


                        <!-- NOMBRE -->

                        <VerticalStackLayout
                            Spacing="5">

                            <Label
                                Text="Nombre / Valor"
                                FontSize="11"
                                TextColor="#94A3B8" />

                            <Label
                                Text="{Binding Detalle.Valor}"
                                FontSize="16"
                                TextColor="#334155" />

                        </VerticalStackLayout>


                        <!-- DESCRIPCIÓN -->

                        <VerticalStackLayout
                            IsVisible="{Binding TieneDescripcion}"
                            Spacing="5">

                            <BoxView
                                HeightRequest="1"
                                Color="#EEF2F6" />

                            <Label
                                Text="Descripción"
                                FontSize="11"
                                TextColor="#94A3B8" />

                            <Label
                                Text="{Binding Detalle.Descripcion}"
                                FontSize="14"
                                TextColor="#475569"
                                LineBreakMode="WordWrap" />

                        </VerticalStackLayout>


                        <!-- ORDEN -->

                        <VerticalStackLayout
                            IsVisible="{Binding TieneOrden}"
                            Spacing="5">

                            <BoxView
                                HeightRequest="1"
                                Color="#EEF2F6" />

                            <Label
                                Text="Orden"
                                FontSize="11"
                                TextColor="#94A3B8" />

                            <Label
                                Text="{Binding Detalle.Orden}"
                                FontSize="14"
                                TextColor="#334155" />

                        </VerticalStackLayout>


                        <!-- VALOR EXTRA -->

                        <VerticalStackLayout
                            IsVisible="{Binding TieneValorExtra}"
                            Spacing="5">

                            <BoxView
                                HeightRequest="1"
                                Color="#EEF2F6" />

                            <Label
                                Text="Valor extra"
                                FontSize="11"
                                TextColor="#94A3B8" />

                            <Label
                                Text="{Binding Detalle.ValorExtra}"
                                FontSize="14"
                                TextColor="#334155"
                                LineBreakMode="WordWrap" />

                        </VerticalStackLayout>


                        <!-- ESTADO -->

                        <VerticalStackLayout
                            Spacing="7">

                            <BoxView
                                HeightRequest="1"
                                Color="#EEF2F6" />

                            <Label
                                Text="Estado"
                                FontSize="11"
                                TextColor="#94A3B8" />

                            <HorizontalStackLayout
                                Spacing="8">

                                <BoxView
                                    WidthRequest="12"
                                    HeightRequest="12"
                                    CornerRadius="6"
                                    Color="{Binding EstadoColor}"
                                    VerticalOptions="Center" />

                                <Label
                                    Text="{Binding EstadoTexto}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="#334155"
                                    VerticalTextAlignment="Center" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Grid>

            </Border>

            <!-- ACCIONES -->

<Grid
    ColumnDefinitions="*,*"
    ColumnSpacing="12">

    <Button
        Grid.Column="0"
        Text="Editar"
        Command="{Binding EditarCommand}"
        HeightRequest="48"
        CornerRadius="10"
        BackgroundColor="#173A54"
        TextColor="White"
        FontAttributes="Bold" />

    <Button
        Grid.Column="1"
        Text="Eliminar"
        Command="{Binding EliminarCommand}"
        HeightRequest="48"
        CornerRadius="10"
        BackgroundColor="#E53935"
        TextColor="White"
        FontAttributes="Bold" />

</Grid>

<ActivityIndicator
    IsRunning="{Binding IsBusy}"
    IsVisible="{Binding IsBusy}"
    Color="#173A54" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>