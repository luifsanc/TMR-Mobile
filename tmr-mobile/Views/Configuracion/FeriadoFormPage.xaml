<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    x:Class="tmr_mobile.Views.Configuracion.FeriadoFormPage"
    x:DataType="vm:FeriadoFormViewModel"
    Title="{Binding TituloPagina}"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F8FAFC">

    <Grid>
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- CABECERA CON ATRÁS Y TÍTULO -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center" Margin="0,4,0,4">
                    <Button
                        Grid.Column="0"
                        Text="‹"
                        Command="{Binding RegresarCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#163572"
                        FontSize="28"
                        FontAttributes="Bold"
                        FontFamily="InterSemiBold"
                        Padding="0"
                        WidthRequest="36"
                        HeightRequest="36"
                        VerticalOptions="Center" />
                    
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="{Binding TituloPagina}" FontSize="22" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="#163572" />
                        <Label Text="Configura tipo, nombre y fecha del calendario laboral." FontSize="11" FontFamily="InterRegular" TextColor="#6B7280" />
                    </VerticalStackLayout>
                </Grid>

                <!-- CARD DE FORMULARIO -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="18">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" /></Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <!-- Título Sección -->
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <BoxView WidthRequest="3" HeightRequest="14" Color="#163572" CornerRadius="1.5" VerticalOptions="Center" />
                            <Label Text="Datos del feriado" FontSize="14" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="#163572" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Tipo de feriado -->
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="12" FontFamily="InterRegular" TextColor="#6B7280">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Tipo de feriado" />
                                        <Span Text=" *" TextColor="#DC2626" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="8,0" HeightRequest="46">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Picker
                                    ItemsSource="{Binding TiposFeriado}"
                                    SelectedItem="{Binding TipoFeriado}"
                                    Title="Selecciona un tipo"
                                    TextColor="#374151"
                                    TitleColor="#9CA3AF"
                                    FontFamily="InterRegular"
                                    FontSize="13"
                                    VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Nombre del feriado -->
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="12" FontFamily="InterRegular" TextColor="#6B7280">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Nombre del feriado" />
                                        <Span Text=" *" TextColor="#DC2626" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="12,0" HeightRequest="46">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Entry
                                    Text="{Binding NombreFeriado}"
                                    Placeholder="Ej: Primer Grito de Independencia"
                                    TextColor="#374151"
                                    PlaceholderColor="#9CA3AF"
                                    FontFamily="InterRegular"
                                    FontSize="13"
                                    VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Fecha -->
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="12" FontFamily="InterRegular" TextColor="#6B7280">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Fecha" />
                                        <Span Text=" *" TextColor="#DC2626" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="12,0" HeightRequest="46">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <DatePicker
                                    Date="{Binding FechaFeriado}"
                                    Format="dd/MM/yyyy"
                                    TextColor="#374151"
                                    FontFamily="InterRegular"
                                    FontSize="13"
                                    VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Descripción -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Descripción (opcional)" FontSize="12" FontFamily="InterRegular" TextColor="#6B7280" />
                            <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White" Padding="12,8" MinimumHeightRequest="70">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Editor
                                    Text="{Binding Descripcion}"
                                    Placeholder="Ej: Feriado nacional en todo el territorio..."
                                    TextColor="#374151"
                                    PlaceholderColor="#9CA3AF"
                                    FontFamily="InterRegular"
                                    FontSize="13"
                                    AutoSize="TextChanges" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Switch Se repite cada año -->
                        <Border Padding="14,10" BackgroundColor="#EEF4FF" Stroke="#D1D5DB" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Se repite cada año" FontSize="13" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="#163572" />
                                    <Label Text="Feriado de recurrencia anual fija" FontSize="11" FontFamily="InterRegular" TextColor="#6B7280" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding EsRecurrente}" OnColor="#163572" ThumbColor="White" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Switch Estado (Solo visible en edición) -->
                        <VerticalStackLayout Spacing="5" IsVisible="{Binding EsEdicion}">
                            <Label Text="Estado del Feriado" FontSize="12" FontFamily="InterRegular" TextColor="#6B7280" />
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Switch IsToggled="{Binding Activo}" OnColor="#16A34A" ThumbColor="White" VerticalOptions="Center" />
                                <Border BackgroundColor="#E6FDEE" StrokeThickness="0" Padding="10,4" IsVisible="{Binding Activo}" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="•" FontSize="14" FontAttributes="Bold" TextColor="#16A34A" VerticalOptions="Center" />
                                        <Label Text="Activo" FontSize="12" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="#16A34A" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border BackgroundColor="#F3F4F6" StrokeThickness="0" Padding="10,4" IsVisible="{Binding Activo, Converter={StaticResource InvertedBoolConverter}}" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="•" FontSize="14" FontAttributes="Bold" TextColor="#6B7280" VerticalOptions="Center" />
                                        <Label Text="Inactivo" FontSize="12" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="#6B7280" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- BOTÓN GUARDAR -->
                <Button
                    Text="{Binding TextoBoton}"
                    Command="{Binding GuardarCommand}"
                    BackgroundColor="#163572"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="48"
                    FontSize="15"
                    FontAttributes="Bold"
                    FontFamily="InterSemiBold"
                    Margin="0,8,0,24" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- INDICADOR DE CARGA -->
        <ActivityIndicator
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            Color="#163572"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <!-- MODAL OVERLAY DE ERROR DE VALIDACIÓN -->
        <ContentView
            IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
            BackgroundColor="#80000000"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            InputTransparent="False">
            <Border BackgroundColor="White" Padding="24" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="320" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.15" /></Border.Shadow>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Error de Validación" FontSize="17" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="#DC2626" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ErrorMessage}" TextColor="#374151" FontSize="13" FontFamily="InterRegular" HorizontalTextAlignment="Center" />
                    <Button Text="Entendido" Command="{Binding LimpiarErrorCommand}" BackgroundColor="#163572" TextColor="White" CornerRadius="8" FontFamily="InterSemiBold" HeightRequest="40" />
                </VerticalStackLayout>
            </Border>
        </ContentView>
    </Grid>
</ContentPage>
