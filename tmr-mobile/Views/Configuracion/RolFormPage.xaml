<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    xmlns:model="clr-namespace:tmr_mobile.Models.Configuracion"
    x:Class="tmr_mobile.Views.Configuracion.RolFormPage"
    x:DataType="vm:RolFormViewModel"
    Title="{Binding TituloPagina}"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}">

    <Grid>
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- CABECERA -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center" Margin="0,4,0,4">
                    <Button
                        Grid.Column="0"
                        Text="‹"
                        Command="{Binding RegresarCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                        FontSize="28"
                        FontAttributes="Bold"
                        FontFamily="InterSemiBold"
                        Padding="0"
                        WidthRequest="36"
                        HeightRequest="36"
                        VerticalOptions="Center" />
                    
                    <Label
                        Grid.Column="1"
                        Text="{Binding TituloPagina}"
                        FontSize="22"
                        FontAttributes="Bold"
                        FontFamily="InterSemiBold"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                        VerticalOptions="Center" />
                </Grid>

                <!-- SECCIÓN 1: INFORMACIÓN DEL ROL -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                    StrokeThickness="1"
                    Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <!-- Título de Sección con Barra Azul -->
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <BoxView WidthRequest="3" HeightRequest="14" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" CornerRadius="1.5" VerticalOptions="Center" />
                            <Label Text="Información del rol" FontSize="14" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Nombre del Rol -->
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="12" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Nombre del rol" />
                                        <Span Text=" *" TextColor="{StaticResource Error}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Padding="12,0" HeightRequest="46">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry
                                    Text="{Binding Nombre}"
                                    Placeholder="Ej: ADMINISTRATIVO"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}"
                                    FontFamily="InterRegular"
                                    FontSize="13"
                                    VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Descripción -->
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="12" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Descripción" />
                                        <Span Text=" *" TextColor="{StaticResource Error}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Padding="12,8" MinimumHeightRequest="70">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Editor
                                    Text="{Binding Descripcion}"
                                    Placeholder="Ej: Puede gestionar clientes y dar seguimiento..."
                                    TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}"
                                    FontFamily="InterRegular"
                                    FontSize="13"
                                    AutoSize="TextChanges" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Estado (Solo visible en Edición) -->
                        <VerticalStackLayout Spacing="5" IsVisible="{Binding EsEdicion}">
                            <Label Text="Estado del Rol" FontSize="12" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Switch IsToggled="{Binding Activo}" OnColor="{StaticResource Accent}" ThumbColor="{StaticResource OnPrimary}" VerticalOptions="Center" />
                                
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource DarkSuccessSurface}}" StrokeThickness="0" Padding="10,4" IsVisible="{Binding Activo}" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="•" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                                        <Label Text="Activo" FontSize="12" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}" StrokeThickness="0" Padding="10,4" IsVisible="{Binding Activo, Converter={StaticResource InverseBoolConverter}}" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="•" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" VerticalOptions="Center" />
                                        <Label Text="Inactivo" FontSize="12" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- SECCIÓN 2: MÓDULOS ACCESIBLES -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                    StrokeThickness="1"
                    Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">
                        <!-- Título de Sección con Barra Azul -->
                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <BoxView WidthRequest="3" HeightRequest="14" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" CornerRadius="1.5" VerticalOptions="Center" />
                                <Label Text="Módulos Accesibles *" FontSize="14" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Selecciona los permisos visibles para este rol." FontSize="11" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" Margin="11,0,0,0" />
                        </VerticalStackLayout>

                        <!-- LISTA DE MÓDULOS INTERACTIVA -->
                        <CollectionView ItemsSource="{Binding Modulos}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="model:RolModuloItem">
                                    <Border
                                        Padding="10,12"
                                        BackgroundColor="{Binding Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='True:#EEF4FF|False:#FFFFFF'}"
                                        Stroke="{Binding Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='True:#163572|False:#D1D5DB'}"
                                        StrokeThickness="{Binding Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='True:1.5|False:1'}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleModuloCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding Selected, Converter={StaticResource BoolToStringConverter}, ConverterParameter='True:☑|False:☐'}"
                                                FontSize="15"
                                                TextColor="{Binding Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='True:#163572|False:#9CA3AF'}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Text="{Binding Nombre}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                FontFamily="InterSemiBold"
                                                TextColor="{Binding Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='True:#163572|False:#374151'}"
                                                VerticalOptions="Center"
                                                MaxLines="1"
                                                LineBreakMode="TailTruncation" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- BOTÓN GUARDAR -->
                <Button
                    Text="{Binding TextoBoton}"
                    Command="{Binding GuardarCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                    TextColor="{StaticResource OnPrimary}"
                    CornerRadius="8"
                    HeightRequest="48"
                    FontSize="15"
                    FontAttributes="Bold"
                    FontFamily="InterSemiBold"
                    Margin="0,8,0,24" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- INDICADOR DE CARGA -->
        <ActivityIndicator
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <!-- MODAL OVERLAY DE ERROR DE VALIDACIÓN -->
        <ContentView
            IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
            BackgroundColor="{StaticResource Scrim}"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            InputTransparent="False">
            <Border
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                Padding="24"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="320"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.15" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Error de Validación" FontSize="17" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{StaticResource Error}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}" FontSize="13" FontFamily="InterRegular" HorizontalTextAlignment="Center" />
                    <Button Text="Entendido" Command="{Binding LimpiarErrorCommand}" BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" TextColor="{StaticResource OnPrimary}" CornerRadius="8" FontFamily="InterSemiBold" HeightRequest="40" />
                </VerticalStackLayout>
            </Border>
        </ContentView>
    </Grid>
</ContentPage>
