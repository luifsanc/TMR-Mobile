<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    xmlns:model="clr-namespace:tmr_mobile.Models.Configuracion"
    xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
    x:Class="tmr_mobile.Views.Configuracion.FeriadosPage"
    x:DataType="vm:FeriadosConfigViewModel"
    Title="{Binding Title}"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- CABECERA -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Días Festivos" FontSize="22" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                        <Label Text="Gestión de feriados nacionales, locales y religiosos" FontSize="12" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Text="+ Nuevo Feriado"
                        Command="{Binding NuevoFeriadoCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                        TextColor="{StaticResource OnPrimary}"
                        CornerRadius="8"
                        FontSize="12"
                        FontAttributes="Bold"
                        FontFamily="InterSemiBold"
                        HeightRequest="40"
                        Padding="14,0"
                        VerticalOptions="Center" />
                </Grid>

                <!-- MÉTRICAS EN GRID RESPONSIVO (2 FILAS ADAPTATIVAS) -->
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <!-- Fila 1: Total Feriados (50%) | Activos (50%) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="10">
                        <!-- Total Feriados -->
                        <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" /></Border.Shadow>
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Border WidthRequest="34" HeightRequest="34" BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Label Text="📅" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                    <Label Text="{Binding TotalFeriados}" FontSize="18" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                                    <Label Text="Total Feriados" FontSize="11" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Activos -->
                        <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" /></Border.Shadow>
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Border WidthRequest="34" HeightRequest="34" BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource DarkSuccessSurface}}" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Label Text="✔" FontSize="14" TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                    <Label Text="{Binding TotalActivos}" FontSize="18" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                                    <Label Text="Activos" FontSize="11" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Fila 2: Nacionales (33%) | Locales (33%) | Religiosos (33%) -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <!-- Nacionales -->
                        <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" Padding="6,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" /></Border.Shadow>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                                <Border WidthRequest="28" HeightRequest="28" BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Label Text="🌐" FontSize="12" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                    <Label Text="{Binding TotalNacionales}" FontSize="16" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                                    <Label Text="Nacionales" FontSize="9" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Locales -->
                        <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" Padding="6,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" /></Border.Shadow>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                                <Border WidthRequest="28" HeightRequest="28" BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource DarkWarningSurface}}" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Label Text="📍" FontSize="12" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                    <Label Text="{Binding TotalLocales}" FontSize="16" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                                    <Label Text="Locales" FontSize="9" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Religiosos -->
                        <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" Padding="6,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" /></Border.Shadow>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                                <Border WidthRequest="28" HeightRequest="28" BackgroundColor="{AppThemeBinding Light={StaticResource PurpleSurface}, Dark={StaticResource DarkPurpleSurface}}" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Label Text="🎉" FontSize="12" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                    <Label Text="{Binding TotalReligiosos}" FontSize="16" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                                    <Label Text="Religiosos" FontSize="9" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Grid>

                <!-- CALENDARIO LABORAL -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" /></Border.Shadow>

                    <VerticalStackLayout Spacing="14">
                        <!-- NAVEGACIÓN DE MES -->
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                            <Label
                                Grid.Row="0"
                                Text="{Binding MesActualTexto}"
                                FontSize="20"
                                FontAttributes="Bold"
                                FontFamily="InterSemiBold"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="NoWrap" />

                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                                <Button
                                    Grid.Column="0"
                                    Text="‹ Anterior"
                                    Command="{Binding NavegarMesAnteriorCommand}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}"
                                    BorderColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    FontSize="11"
                                    FontFamily="InterRegular"
                                    HeightRequest="38"
                                    Padding="10,0" />
                                <Button
                                    Grid.Column="1"
                                    Text="Hoy"
                                    Command="{Binding IrAHoyCommand}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}"
                                    BorderColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    FontSize="11"
                                    FontFamily="InterRegular"
                                    HeightRequest="38"
                                    Padding="14,0" />
                                <Button
                                    Grid.Column="2"
                                    Text="Siguiente ›"
                                    Command="{Binding NavegarMesSiguienteCommand}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMain}, Dark={StaticResource DarkTextMain}}"
                                    BorderColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    FontSize="11"
                                    FontFamily="InterRegular"
                                    HeightRequest="38"
                                    Padding="10,0" />
                            </Grid>
                        </Grid>

                        <!-- DÍAS DE LA SEMANA HEADER -->
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,4,0,0">
                            <Label Grid.Column="0" Text="LUN" FontSize="11" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="MAR" FontSize="11" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="MIE" FontSize="11" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="3" Text="JUE" FontSize="11" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="4" Text="VIE" FontSize="11" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="5" Text="SAB" FontSize="11" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="6" Text="DOM" FontSize="11" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" HorizontalTextAlignment="Center" />
                        </Grid>

                        <!-- CUADRÍCULA DE 42 DÍAS DEL CALENDARIO EN FLEXLAYOUT RESPONSIVO (7 COLUMNAS FIJAS DE 14.28%) -->
                        <FlexLayout
                            BindableLayout.ItemsSource="{Binding DiasCalendario}"
                            Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="Start"
                            AlignItems="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="model:DiaCalendarioItem">
                                    <Border
                                        FlexLayout.Basis="14.28%"
                                        BackgroundColor="{Binding ColorFondoDia}"
                                        Stroke="{Binding ColorBordeDia}"
                                        StrokeThickness="1"
                                        HeightRequest="54"
                                        Margin="0,1"
                                        Padding="2">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                        
                                        <Grid RowDefinitions="18,*">
                                            <!-- Número de día -->
                                            <Label
                                                Grid.Row="0"
                                                Text="{Binding NumeroDia}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                FontFamily="InterSemiBold"
                                                TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                                HeightRequest="18"
                                                HorizontalOptions="Center"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center"
                                                ZIndex="2">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding EsMesActual}"
                                                                 Value="False">
                                                        <Setter Property="TextColor"
                                                                Value="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                            <!-- Badge Feriado en el día -->
                                            <Border
                                                Grid.Row="1"
                                                IsVisible="{Binding TieneFeriados}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource DarkSuccessSurface}}"
                                                Stroke="{StaticResource Accent}"
                                                StrokeThickness="1"
                                                Padding="2,1"
                                                VerticalOptions="End"
                                                HorizontalOptions="Center"
                                                MaximumWidthRequest="42"
                                                Margin="0,1"
                                                ZIndex="1">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirDetalleCommand}"
                                                        CommandParameter="{Binding PrimerFeriado}" />
                                                </Border.GestureRecognizers>
                                                <Label
                                                    Text="{Binding PrimerFeriado.NombreFeriado}"
                                                    FontSize="8"
                                                    FontAttributes="Bold"
                                                    FontFamily="InterSemiBold"
                                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation"
                                                    HorizontalTextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- INDICADOR DE CARGA -->
        <ActivityIndicator
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <!-- BARRA DE NAVEGACIÓN INFERIOR DE LA APP MÓVIL -->
        <shared:UserBottomNavBar Grid.Row="1" />
    </Grid>

</ContentPage>
