<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.Configuracion.FeriadosPage"
             x:DataType="vm:FeriadosConfigViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="20">
            <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#FEFCE8">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Días feriados" Style="{StaticResource PageHeaderTitleStyle}" />
                    <Label Text="Control y administración del calendario de días no laborables" Style="{StaticResource PageHeaderSubtitleStyle}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource ListCardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Vista de calendario" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="• Registrar fechas especiales" Style="{StaticResource PageSubtitleStyle}" />
                    <Label Text="• Revisar exclusiones para reportes y carga de tiempo" Style="{StaticResource PageSubtitleStyle}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
