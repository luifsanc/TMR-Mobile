<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.Configuracion.ConfiguracionPage"
             Title="Configuración"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource White}"
             x:DataType="vm:ConfiguracionViewModel">

    <!-- Principal Grid: Scrollable Content + Fixed Bottom Nav -->
    <Grid RowDefinitions="*,80">
        
        <!-- Modules Grid -->
        <CollectionView Grid.Row="0" ItemsSource="{Binding Modulos}" Margin="20,20,20,30" HorizontalOptions="Center">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="15" HorizontalItemSpacing="15" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ConfiguracionModuloItem">
                    <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource PrimaryLight}" HeightRequest="110" Padding="10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ConfiguracionViewModel}}, Path=NavigateCommand}" CommandParameter="{Binding Ruta}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                             <Image Source="{Binding Icono}" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" />
                             <Label Text="{Binding Nombre}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Custom Bottom Nav Bar with FAB -->
        <shared:BottomNavBar Grid.Row="1" />
    </Grid>
</ContentPage>
