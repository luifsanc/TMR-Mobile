<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    x:Class="tmr_mobile.Views.Configuracion.UsuarioDetallePage"
    x:DataType="vm:UsuarioDetalleViewModel"
    Title="Detalle de Usuario"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource DarkBackgroundLight}}">

    <Grid>
        <!-- CONTENIDO SCROLLABLE -->
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16" Spacing="16">
                
                <!-- HEADER CON BOTÓN ATRÁS Y TÍTULO -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center" Margin="0,4,0,4">
                    <Button
                        Grid.Column="0"
                        Text="‹"
                        Command="{Binding RegresarCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                        FontSize="28"
                        FontAttributes="Bold"
                        FontFamily="InterSemiBold"
                        Padding="0"
                        WidthRequest="36"
                        HeightRequest="36"
                        VerticalOptions="Center" />
                    
                    <Label
                        Grid.Column="1"
                        Text="{Binding NombreMostrado}"
                        FontSize="20"
                        FontAttributes="Bold"
                        FontFamily="InterSemiBold"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                        VerticalOptions="Center"
                        LineBreakMode="TailTruncation"
                        MaxLines="2" />
                        
                    <!-- BADGE DE ESTADO CON PUNTO (•) -->
                    <Border
                        Grid.Column="2"
                        BackgroundColor="{Binding Usuario.ColorFondoEstado}"
                        StrokeThickness="0"
                        Padding="10,4"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label
                                Text="•"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{Binding Usuario.ColorTextoEstado}"
                                VerticalOptions="Center" />
                            <Label
                                Text="{Binding EstadoDetalleTexto}"
                                FontSize="11"
                                FontAttributes="Bold"
                                FontFamily="InterSemiBold"
                                TextColor="{Binding Usuario.ColorTextoEstado}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- CARD 1: VÍNCULO DE PERSONA -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                    StrokeThickness="1"
                    Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <BoxView WidthRequest="3" HeightRequest="14" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" CornerRadius="1.5" VerticalOptions="Center" />
                            <Label Text="Vínculo de persona" FontSize="14" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" RowSpacing="12" ColumnSpacing="12">
                            <!-- Usuario -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="👤" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" VerticalOptions="Center" />
                                    <Label Text="Usuario" FontSize="12" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Usuario.NombreUsuario}" FontSize="14" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                            </VerticalStackLayout>

                            <!-- Tipo de usuario -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="🪪" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" VerticalOptions="Center" />
                                    <Label Text="Tipo de usuario" FontSize="12" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Usuario.TipoUsuarioTexto}" FontSize="14" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- CARD 2: CONTACTO & ROLES -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource DarkSurfaceColor}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}"
                    StrokeThickness="1"
                    Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <BoxView WidthRequest="3" HeightRequest="14" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" CornerRadius="1.5" VerticalOptions="Center" />
                            <Label Text="Contacto &amp; Roles" FontSize="14" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" RowSpacing="12" ColumnSpacing="12">
                            <!-- Correo -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="✉" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" VerticalOptions="Center" />
                                    <Label Text="Correo" FontSize="12" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Usuario.Email}" FontSize="13" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" LineBreakMode="TailTruncation" MaxLines="2" />
                            </VerticalStackLayout>

                            <!-- Roles -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="🛡" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" VerticalOptions="Center" />
                                    <Label Text="Roles" FontSize="12" FontFamily="InterRegular" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource DarkTextLight}}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding RolesTexto}" FontSize="13" FontAttributes="Bold" FontFamily="InterSemiBold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" LineBreakMode="TailTruncation" MaxLines="2" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                
                <!-- ACCIONES (Botones abajo) -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,24">
                    <!-- Botón Editar (Solo visible cuando está Activo) -->
                    <Button
                        Grid.Column="0"
                        Text="Editar"
                        Command="{Binding EditarCommand}"
                        IsVisible="{Binding EsActivo}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                        TextColor="{StaticResource OnPrimary}"
                        CornerRadius="8"
                        HeightRequest="48"
                        FontSize="14"
                        FontAttributes="Bold"
                        FontFamily="InterSemiBold" />
                        
                    <!-- Botón Cambiar Estado (Desactivar/Activar) -->
                    <Button
                        Grid.Column="1"
                        Text="{Binding TextoBotonEstado}"
                        Command="{Binding CambiarEstadoCommand}"
                        BackgroundColor="{StaticResource Error}"
                        TextColor="{StaticResource OnPrimary}"
                        CornerRadius="8"
                        HeightRequest="48"
                        FontSize="14"
                        FontAttributes="Bold"
                        FontFamily="InterSemiBold">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding EsInactivo}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        
        <!-- INDICADOR DE CARGA -->
        <ActivityIndicator
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
            
        <!-- ERROR -->
        <VerticalStackLayout
            IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="16"
            Padding="32">
            <Label
                Text="{Binding ErrorMessage}"
                TextColor="{StaticResource Error}"
                FontSize="14"
                FontFamily="InterRegular"
                HorizontalTextAlignment="Center" />
            <Button
                Text="Regresar"
                Command="{Binding RegresarCommand}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                TextColor="{StaticResource OnPrimary}"
                CornerRadius="8"
                FontFamily="InterSemiBold" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
