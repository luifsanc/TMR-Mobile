<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.Configuracion.CatalogosPage"
             x:DataType="vm:CatalogosConfigViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="20">
            <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#EFF6FF">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Catálogos del sistema" Style="{StaticResource PageHeaderTitleStyle}" />
                    <Label Text="Mantenimiento de maestras y valores auxiliares del negocio" Style="{StaticResource PageHeaderSubtitleStyle}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource ListCardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Uso frecuente" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="• Actualizar listas maestras" Style="{StaticResource PageSubtitleStyle}" />
                    <Label Text="• Mantener datos base del sistema" Style="{StaticResource PageSubtitleStyle}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
