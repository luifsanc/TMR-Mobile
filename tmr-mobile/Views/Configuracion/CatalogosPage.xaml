<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    xmlns:model="clr-namespace:tmr_mobile.Models.Configuracion"
    x:Class="tmr_mobile.Views.Configuracion.CatalogosPage"
    x:DataType="vm:CatalogosConfigViewModel"
    Title="Catálogos"
    BackgroundColor="{StaticResource CatalogBackground}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Padding="16" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="Catálogos" Style="{StaticResource CatalogPageTitle}" />
            <Label Text="Administra los valores de configuración del sistema"
                   Style="{StaticResource CatalogPageSubtitle}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Catalogos}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="model:CatalogoMaster">
                        <Border Padding="16,9"
                                BackgroundColor="{StaticResource CatalogWhite}"
                                Stroke="{StaticResource CatalogBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource CatalogPrimary}" />
                                    <Setter Property="Stroke" Value="{StaticResource CatalogPrimary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SeleccionarCatalogoCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding NombreMostrar}"
                                   FontFamily="Inter SemiBold"
                                   FontSize="12"
                                   FontAttributes="None"
                                   TextColor="{StaticResource CatalogPrimary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource CatalogWhite}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Border Grid.Column="0" HeightRequest="72" Style="{StaticResource CatalogMetricCard}">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="30" HeightRequest="30" Padding="6"
                                BackgroundColor="{StaticResource CatalogTotalIconBackground}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 8">
                            <Image Source="catalog_total_items.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" />
                        </Border>
                        <Label Text="{Binding TotalItems}" FontFamily="Inter SemiBold" FontSize="20" FontAttributes="None"
                               TextColor="{StaticResource CatalogPrimary}" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Total de ítems" FontFamily="Inter" FontSize="10"
                           TextColor="{StaticResource CatalogTextSecondary}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" HeightRequest="72" Style="{StaticResource CatalogMetricCard}">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="30" HeightRequest="30" Padding="6"
                                BackgroundColor="{StaticResource CatalogActiveIconBackground}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 8">
                            <Image Source="catalog_active.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" />
                        </Border>
                        <Label Text="{Binding TotalActivos}" FontFamily="Inter SemiBold" FontSize="20" FontAttributes="None"
                               TextColor="{StaticResource CatalogPrimary}" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Activos" FontFamily="Inter" FontSize="10"
                           TextColor="{StaticResource CatalogAccent}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" HeightRequest="72" Style="{StaticResource CatalogMetricCard}">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="30" HeightRequest="30" Padding="6"
                                BackgroundColor="{StaticResource CatalogInactiveIconBackground}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 8">
                            <Image Source="catalog_inactive.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" />
                        </Border>
                        <Label Text="{Binding TotalInactivos}" FontFamily="Inter SemiBold" FontSize="20" FontAttributes="None"
                               TextColor="{StaticResource CatalogPrimary}" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Inactivos" FontFamily="Inter" FontSize="10"
                           TextColor="{StaticResource CatalogError}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <Border Grid.Column="0" HeightRequest="42" Style="{StaticResource CatalogInputBorder}" Padding="8,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                    <Label Grid.Column="0" Text="⌕" FontFamily="Inter" FontSize="19"
                           TextColor="{StaticResource CatalogTextLight}" VerticalTextAlignment="Center" />
                    <Entry Grid.Column="1"
                           Text="{Binding Busqueda}"
                           Placeholder="Buscar..."
                           HeightRequest="40"
                           FontSize="12"
                           Style="{StaticResource CatalogInput}" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Padding="0"
                    BackgroundColor="{StaticResource CatalogWhite}"
                    Stroke="{StaticResource CatalogBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 9">
                <Picker SelectedItem="{Binding FiltroEstado, Mode=TwoWay}"
                        Style="{StaticResource CatalogFilterPicker}">
                    <Picker.Items>
                        <x:String>Todos</x:String>
                        <x:String>Activos</x:String>
                        <x:String>Inactivos</x:String>
                    </Picker.Items>
                </Picker>
            </Border>

            <Button Grid.Column="2" Text="+ Nuevo" Command="{Binding NuevoCommand}"
                    WidthRequest="78" HeightRequest="42" Padding="6,0" FontSize="12"
                    Style="{StaticResource CatalogPrimaryButton}" />
        </Grid>

        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding Detalles}"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30" Spacing="6"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Sin resultados" Style="{StaticResource CatalogHeadingText}" FontSize="16"
                           TextColor="{StaticResource CatalogTextMain}" HorizontalTextAlignment="Center" />
                    <Label Text="No se encontraron registros para los filtros seleccionados."
                           Style="{StaticResource CatalogPageSubtitle}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:CatalogoDetalle">
                    <Border Margin="0,0,0,12" Padding="0" Style="{StaticResource CatalogCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirDetalleCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="5,Auto">
                            <BoxView Grid.Row="0" Color="{Binding ColorEstado}" />
                            <Grid Grid.Row="1" Padding="16" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <Label Text="CÓDIGO" Style="{StaticResource CatalogFieldLabel}" />
                                    <Label Text="{Binding CodigoValor}" Style="{StaticResource CatalogFieldValueStrong}" />
                                </VerticalStackLayout>
                                <Label Grid.Row="0" Grid.Column="1" Text="›" FontFamily="Inter" FontSize="24"
                                       TextColor="{StaticResource CatalogTextLight}" VerticalTextAlignment="Center" />
                                <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="2">
                                    <Label Text="VALOR / NOMBRE" Style="{StaticResource CatalogFieldLabel}" />
                                    <Label Text="{Binding Valor}" Style="{StaticResource CatalogFieldValue}"
                                           MaxLines="1" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2"
                                                     IsVisible="{Binding TieneDescripcion}" Spacing="2">
                                    <Label Text="DESCRIPCIÓN" Style="{StaticResource CatalogFieldLabel}" />
                                    <Label Text="{Binding Descripcion}" FontFamily="Inter" FontSize="12"
                                           TextColor="{StaticResource CatalogTextMuted}"
                                           MaxLines="2" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="5" HeightRequest="32" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
            <Button Grid.Column="0" Text="‹" Command="{Binding PaginaAnteriorCommand}"
                    IsEnabled="{Binding PuedeAnterior}"
                    Style="{StaticResource CatalogPaginationButton}" />
            <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalOptions="Center"
                        HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding PaginasVisibles}" Spacing="5">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="{x:Null}">
                            <Button Text="{Binding .}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IrPaginaCommand}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource CatalogPaginationButton}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
            <Button Grid.Column="2" Text="›" Command="{Binding PaginaSiguienteCommand}"
                    IsEnabled="{Binding PuedeSiguiente}"
                    Style="{StaticResource CatalogPaginationButton}" />
        </Grid>

        <Grid Grid.RowSpan="6" IsVisible="{Binding IsBusy}" BackgroundColor="#66FFFFFF">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource CatalogPrimary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
