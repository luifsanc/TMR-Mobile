<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    xmlns:model="clr-namespace:tmr_mobile.Models.Configuracion"
    x:Class="tmr_mobile.Views.Configuracion.CatalogosPage"
    x:DataType="vm:CatalogosConfigViewModel"
    Title="Catálogos"
    BackgroundColor="{StaticResource BackgroundLight}">
    <ContentPage.Resources>
        <Style x:Key="CatalogCompactPaginationButton"
               TargetType="Button"
               BasedOn="{StaticResource CatalogPaginationButton}">
            <Setter Property="WidthRequest" Value="26" />
            <Setter Property="HeightRequest" Value="26" />
            <Setter Property="MinimumWidthRequest" Value="26" />
            <Setter Property="MinimumHeightRequest" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="FontSize" Value="9" />
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="*,80">
        <ContentView Grid.Row="0">
            <Grid
                RowDefinitions="Auto,Auto,Auto,Auto,*"
                Padding="16"
                RowSpacing="10">

                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="8"
                      VerticalOptions="Center">
                    <Label Grid.Column="0"
                           Text="Catálogos"
                           VerticalOptions="Center"
                           Style="{StaticResource CatalogPageTitle}" />

                    <Grid Grid.Column="1"
                          HeightRequest="26"
                          ColumnDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="6"
                          VerticalOptions="Center">
                        <Button Grid.Column="0"
                                Text="‹"
                                Command="{Binding PaginaAnteriorCommand}"
                                IsEnabled="{Binding PuedeAnterior}"
                                Style="{StaticResource CatalogCompactPaginationButton}" />
                        <ScrollView Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalOptions="Center"
                                    MaximumWidthRequest="120"
                                    HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding PaginasVisibles}"
                                                   Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="{x:Null}">
                                        <Button Text="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IrPaginaCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource CatalogCompactPaginationButton}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                        <Button Grid.Column="2"
                                Text="›"
                                Command="{Binding PaginaSiguienteCommand}"
                                IsEnabled="{Binding PuedeSiguiente}"
                                Style="{StaticResource CatalogCompactPaginationButton}" />
                    </Grid>
                </Grid>

                <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Catalogos}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="model:CatalogoMaster">
                                <Border Padding="16,9"
                                        BackgroundColor="{StaticResource White}"
                                        Stroke="{StaticResource BorderColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 18">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SeleccionarCatalogoCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding NombreMostrar}"
                                           FontFamily="InterSemiBold"
                                           FontSize="12"
                                           FontAttributes="None"
                                           TextColor="{StaticResource Primary}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource White}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" HeightRequest="72" Style="{StaticResource CatalogMetricCard}">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Border WidthRequest="30" HeightRequest="30" Padding="6"
                                        BackgroundColor="{StaticResource ErrorSurface}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                    <Image Source="catalog_total_items.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" />
                                </Border>
                                <Label Text="{Binding TotalItems}" FontFamily="InterSemiBold" FontSize="20" FontAttributes="None"
                                       TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Total de ítems" FontFamily="InterRegular" FontSize="10"
                                   TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" HeightRequest="72" Style="{StaticResource CatalogMetricCard}">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Border WidthRequest="30" HeightRequest="30" Padding="6"
                                        BackgroundColor="{StaticResource SuccessSurface}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                    <Image Source="catalog_active.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" />
                                </Border>
                                <Label Text="{Binding TotalActivos}" FontFamily="InterSemiBold" FontSize="20" FontAttributes="None"
                                       TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Activos" FontFamily="InterRegular" FontSize="10"
                                   TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" HeightRequest="72" Style="{StaticResource CatalogMetricCard}">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Border WidthRequest="30" HeightRequest="30" Padding="6"
                                        BackgroundColor="{StaticResource Secondary}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                    <Image Source="catalog_inactive.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" />
                                </Border>
                                <Label Text="{Binding TotalInactivos}" FontFamily="InterSemiBold" FontSize="20" FontAttributes="None"
                                       TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Inactivos" FontFamily="InterRegular" FontSize="10"
                                   TextColor="{StaticResource Error}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                    <Border Grid.Column="0" HeightRequest="36" Style="{StaticResource CatalogInputBorder}" Padding="7,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                            <Label Grid.Column="0" Text="⌕" FontFamily="InterRegular" FontSize="17"
                                   TextColor="{StaticResource TextLight}" VerticalTextAlignment="Center" />
                            <Entry Grid.Column="1"
                                   Text="{Binding Busqueda}"
                                   Placeholder="Buscar..."
                                   HeightRequest="34"
                                   MinimumHeightRequest="34"
                                   FontSize="11"
                                   Style="{StaticResource CatalogInput}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="0"
                            BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 9">
                        <Picker SelectedItem="{Binding FiltroEstado, Mode=TwoWay}"
                                WidthRequest="82"
                                HeightRequest="36"
                                MinimumHeightRequest="36"
                                FontSize="10"
                                Style="{StaticResource CatalogFilterPicker}">
                            <Picker.Items>
                                <x:String>Todos</x:String>
                                <x:String>Activos</x:String>
                                <x:String>Inactivos</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>

                    <Button Grid.Column="2" Text="+ Nuevo" Command="{Binding NuevoCommand}"
                            WidthRequest="70" HeightRequest="36" MinimumHeightRequest="36"
                            Padding="4,0" FontSize="11"
                            Style="{StaticResource PrimaryButton}" />
                </Grid>

                <CollectionView Grid.Row="4"
                                ItemsSource="{Binding Detalles}"
                                SelectionMode="None"
                                VerticalScrollBarVisibility="Never">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="30" Spacing="6"
                                             HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="Sin resultados" Style="{StaticResource CatalogHeadingText}" FontSize="16"
                                   TextColor="{StaticResource TextMain}" HorizontalTextAlignment="Center" />
                            <Label Text="No se encontraron registros para los filtros seleccionados."
                                   Style="{StaticResource CatalogPageSubtitle}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:CatalogoDetalle">
                            <Border Margin="0,0,0,8" Padding="0" Style="{StaticResource CatalogCard}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirDetalleCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="4,Auto">
                                    <BoxView Grid.Row="0" Color="{Binding ColorEstado}" />
                                    <Grid Grid.Row="1"
                                          Padding="14,11"
                                          RowDefinitions="Auto,Auto,Auto"
                                          ColumnDefinitions="*,Auto"
                                          RowSpacing="6">
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                            <Label Text="CÓDIGO" Style="{StaticResource CatalogFieldLabel}" />
                                            <Label Text="{Binding CodigoValor}" Style="{StaticResource CatalogFieldValueStrong}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Row="0" Grid.Column="1" Text="›" FontFamily="InterRegular" FontSize="24"
                                               TextColor="{StaticResource TextLight}" VerticalTextAlignment="Center" />
                                        <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="2">
                                            <Label Text="VALOR / NOMBRE" Style="{StaticResource CatalogFieldLabel}" />
                                            <Label Text="{Binding Valor}" Style="{StaticResource CatalogFieldValue}"
                                                   MaxLines="1" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2"
                                                             IsVisible="{Binding TieneDescripcion}" Spacing="2">
                                            <Label Text="DESCRIPCIÓN" Style="{StaticResource CatalogFieldLabel}" />
                                            <Label Text="{Binding Descripcion}" FontFamily="InterRegular" FontSize="12"
                                                   TextColor="{StaticResource TextMuted}"
                                                   MaxLines="2" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid Grid.RowSpan="5" IsVisible="{Binding IsBusy}" BackgroundColor="{StaticResource WhiteTranslucent}">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Grid>
        </ContentView>
        <shared:BottomNavBar Grid.Row="1" />
    </Grid>
</ContentPage>
