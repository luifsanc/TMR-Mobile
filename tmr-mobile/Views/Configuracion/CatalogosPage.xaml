<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
    xmlns:model="clr-namespace:tmr_mobile.Models.Configuracion"
    x:Class="tmr_mobile.Views.Configuracion.CatalogosPage"
    x:DataType="vm:CatalogosConfigViewModel"
    Title="Catálogos"
    BackgroundColor="{StaticResource BackgroundLight}">
    <Grid RowDefinitions="*,36">
        <ContentView Grid.Row="0">
            <Grid
                RowDefinitions="Auto,Auto,Auto,Auto,*"
                Padding="12"
                RowSpacing="6">

                <Grid Grid.Row="0" VerticalOptions="Center">
                    <Label Text="Catálogos"
                           VerticalOptions="Center"
                           Style="{StaticResource CatalogPageTitle}"
                           FontSize="22" />
                </Grid>

                <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Catalogos}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="model:CatalogoMaster">
                                <Border Padding="12,6"
                                        BackgroundColor="{StaticResource White}"
                                        Stroke="{StaticResource BorderColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SeleccionarCatalogoCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding NombreMostrar}"
                                           FontFamily="InterSemiBold"
                                           FontSize="11"
                                           FontAttributes="None"
                                           TextColor="{StaticResource Primary}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource White}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" HeightRequest="56" Padding="5" Style="{StaticResource CatalogMetricCard}">
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Border WidthRequest="24" HeightRequest="24" Padding="5"
                                        BackgroundColor="{StaticResource ErrorSurface}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                    <Image Source="catalog_total_items.png" WidthRequest="14" HeightRequest="14" Aspect="AspectFit" />
                                </Border>
                                <Label Text="{Binding TotalItems}" FontFamily="InterSemiBold" FontSize="17" FontAttributes="None"
                                       TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Total de ítems" FontFamily="InterRegular" FontSize="9"
                                   TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" HeightRequest="56" Padding="5" Style="{StaticResource CatalogMetricCard}">
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Border WidthRequest="24" HeightRequest="24" Padding="5"
                                        BackgroundColor="{StaticResource SuccessSurface}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                    <Image Source="catalog_active.png" WidthRequest="14" HeightRequest="14" Aspect="AspectFit" />
                                </Border>
                                <Label Text="{Binding TotalActivos}" FontFamily="InterSemiBold" FontSize="17" FontAttributes="None"
                                       TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Activos" FontFamily="InterRegular" FontSize="9"
                                   TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" HeightRequest="56" Padding="5" Style="{StaticResource CatalogMetricCard}">
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Border WidthRequest="24" HeightRequest="24" Padding="5"
                                        BackgroundColor="{StaticResource Secondary}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                    <Image Source="catalog_inactive.png" WidthRequest="14" HeightRequest="14" Aspect="AspectFit" />
                                </Border>
                                <Label Text="{Binding TotalInactivos}" FontFamily="InterSemiBold" FontSize="17" FontAttributes="None"
                                       TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Inactivos" FontFamily="InterRegular" FontSize="9"
                                   TextColor="{StaticResource Error}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                    <Border Grid.Column="0" HeightRequest="32" Style="{StaticResource CatalogInputBorder}" Padding="6,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                            <Label Grid.Column="0" Text="⌕" FontFamily="InterRegular" FontSize="15"
                                   TextColor="{StaticResource TextLight}" VerticalTextAlignment="Center" />
                            <Entry Grid.Column="1"
                                   Text="{Binding Busqueda}"
                                   Placeholder="Buscar..."
                                   HeightRequest="30"
                                   MinimumHeightRequest="30"
                                   FontSize="10"
                                   Style="{StaticResource CatalogInput}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="0"
                            BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 9">
                        <Picker SelectedItem="{Binding FiltroEstado, Mode=TwoWay}"
                                WidthRequest="74"
                                HeightRequest="32"
                                MinimumHeightRequest="32"
                                FontSize="9"
                                Style="{StaticResource CatalogFilterPicker}">
                            <Picker.Items>
                                <x:String>Todos</x:String>
                                <x:String>Activos</x:String>
                                <x:String>Inactivos</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>

                    <Button Grid.Column="2" Text="+ Nuevo" Command="{Binding NuevoCommand}"
                            WidthRequest="64" HeightRequest="32" MinimumHeightRequest="32"
                            Padding="3,0" FontSize="10"
                            Style="{StaticResource PrimaryButton}" />
                </Grid>

                <CollectionView Grid.Row="4"
                                ItemsSource="{Binding Detalles}"
                                SelectionMode="None"
                                VerticalScrollBarVisibility="Never">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="30" Spacing="6"
                                             HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="Sin resultados" Style="{StaticResource CatalogHeadingText}" FontSize="16"
                                   TextColor="{StaticResource TextMain}" HorizontalTextAlignment="Center" />
                            <Label Text="No se encontraron registros para los filtros seleccionados."
                                   Style="{StaticResource CatalogPageSubtitle}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:CatalogoDetalle">
                            <Border Margin="0,0,0,6" Padding="0" Style="{StaticResource CatalogCard}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirDetalleCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="3,Auto">
                                    <BoxView Grid.Row="0" Color="{Binding ColorEstado}" />
                                    <Grid Grid.Row="1"
                                          Padding="12,7"
                                          RowDefinitions="Auto,Auto,Auto"
                                          ColumnDefinitions="*,Auto"
                                          RowSpacing="3">
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="1">
                                            <Label Text="CÓDIGO" Style="{StaticResource CatalogFieldLabel}" FontSize="9" />
                                            <Label Text="{Binding CodigoValor}" Style="{StaticResource CatalogFieldValueStrong}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Label Grid.Row="0" Grid.Column="1" Text="›" FontFamily="InterRegular" FontSize="24"
                                               TextColor="{StaticResource TextLight}" VerticalTextAlignment="Center" />
                                        <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="1">
                                            <Label Text="VALOR / NOMBRE" Style="{StaticResource CatalogFieldLabel}" FontSize="9" />
                                            <Label Text="{Binding Valor}" Style="{StaticResource CatalogFieldValue}" FontSize="12"
                                                   MaxLines="1" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2"
                                                             IsVisible="{Binding TieneDescripcion}" Spacing="1">
                                            <Label Text="DESCRIPCIÓN" Style="{StaticResource CatalogFieldLabel}" FontSize="9" />
                                            <Label Text="{Binding Descripcion}" FontFamily="InterRegular" FontSize="10"
                                                   TextColor="{StaticResource TextMuted}"
                                                   MaxLines="1" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid Grid.RowSpan="5" IsVisible="{Binding IsBusy}" BackgroundColor="{StaticResource WhiteTranslucent}">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Grid>
        </ContentView>
        <shared:BottomNavBar Grid.Row="1" />
    </Grid>
</ContentPage>
