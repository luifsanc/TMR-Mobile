<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.Configuracion.UsuariosPage"
             x:DataType="vm:UsuariosConfigViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="20">
            <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#F8FAFC">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Administración de usuarios" Style="{StaticResource PageHeaderTitleStyle}" />
                    <Label Text="Gestión de accesos, perfiles y estado de las cuentas del sistema" Style="{StaticResource PageHeaderSubtitleStyle}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource ListCardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Acciones principales" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="• Activar o desactivar cuentas" Style="{StaticResource PageSubtitleStyle}" />
                    <Label Text="• Asignar roles y permisos" Style="{StaticResource PageSubtitleStyle}" />
                    <Label Text="• Revisar el estado activo o inactivo" Style="{StaticResource PageSubtitleStyle}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
