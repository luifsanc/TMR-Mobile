<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Design system TMR -->
    <Color x:Key="CatalogPrimary">#163572</Color>
    <Color x:Key="CatalogPrimaryDark">#162056</Color>
    <Color x:Key="CatalogPrimaryLight">#EEF4FF</Color>
    <Color x:Key="CatalogSecondary">#F5F5F5</Color>
    <Color x:Key="CatalogAccent">#4CAF50</Color>
    <Color x:Key="CatalogWarn">#FF9800</Color>
    <Color x:Key="CatalogError">#F44336</Color>
    <Color x:Key="CatalogDanger">#F43F5E</Color>
    <Color x:Key="CatalogTextPrimary">#1A1A2E</Color>
    <Color x:Key="CatalogTextMain">#1E293B</Color>
    <Color x:Key="CatalogTextSecondary">#6B7280</Color>
    <Color x:Key="CatalogTextMuted">#5F6B7A</Color>
    <Color x:Key="CatalogTextLight">#94A3B8</Color>
    <Color x:Key="CatalogBorder">#E5E7EB</Color>
    <Color x:Key="CatalogBackground">#F8FAFC</Color>
    <Color x:Key="CatalogWhite">#FFFFFF</Color>
    <Color x:Key="CatalogActiveBackground">#EAF7EB</Color>
    <Color x:Key="CatalogInactiveBackground">#F3F4F6</Color>
    <Color x:Key="CatalogTotalIconBackground">#FFEFEF</Color>
    <Color x:Key="CatalogActiveIconBackground">#E6FDEE</Color>
    <Color x:Key="CatalogInactiveIconBackground">#F3F4F6</Color>

    <Style x:Key="CatalogPageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter SemiBold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value="{StaticResource CatalogTextPrimary}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="CatalogPageSubtitle" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource CatalogTextMuted}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="CatalogSectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="TextColor" Value="{StaticResource CatalogTextPrimary}" />
    </Style>

    <Style x:Key="CatalogBodyText" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource CatalogTextMain}" />
    </Style>

    <Style x:Key="CatalogHeadingText" TargetType="Label" BasedOn="{StaticResource CatalogBodyText}">
        <Setter Property="FontFamily" Value="Inter SemiBold" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value="{StaticResource CatalogTextPrimary}" />
    </Style>

    <Style x:Key="CatalogFieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource CatalogTextLight}" />
    </Style>

    <Style x:Key="CatalogFieldValue" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource CatalogTextMain}" />
    </Style>

    <Style x:Key="CatalogFieldValueStrong" TargetType="Label" BasedOn="{StaticResource CatalogFieldValue}">
        <Setter Property="FontFamily" Value="Inter SemiBold" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value="{StaticResource CatalogPrimary}" />
    </Style>

    <Style x:Key="CatalogBackLink" TargetType="Button">
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="FontFamily" Value="Inter SemiBold" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource CatalogPrimary}" />
    </Style>

    <Style x:Key="CatalogPrimaryButton" TargetType="Button">
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="FontFamily" Value="Inter SemiBold" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BackgroundColor" Value="{StaticResource CatalogPrimary}" />
        <Setter Property="TextColor" Value="{StaticResource CatalogWhite}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CatalogPrimaryDark}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.55" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="CatalogOutlineButton" TargetType="Button">
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontFamily" Value="Inter SemiBold" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BackgroundColor" Value="{StaticResource CatalogWhite}" />
        <Setter Property="TextColor" Value="{StaticResource CatalogTextMain}" />
        <Setter Property="BorderColor" Value="{StaticResource CatalogBorder}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="CatalogDangerButton" TargetType="Button" BasedOn="{StaticResource CatalogPrimaryButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource CatalogDanger}" />
    </Style>

    <Style x:Key="CatalogFilterButton" TargetType="Button" BasedOn="{StaticResource CatalogOutlineButton}">
        <Setter Property="HeightRequest" Value="38" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="CatalogSegmentButton" TargetType="Button">
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FontFamily" Value="Inter SemiBold" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource CatalogTextMain}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="CatalogFilterPicker" TargetType="Picker">
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="MinimumHeightRequest" Value="42" />
        <Setter Property="WidthRequest" Value="92" />
        <Setter Property="FontFamily" Value="Inter SemiBold" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource CatalogPrimary}" />
        <Setter Property="TitleColor" Value="{StaticResource CatalogPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="CatalogPaginationButton" TargetType="Button" BasedOn="{StaticResource CatalogOutlineButton}">
        <Setter Property="WidthRequest" Value="30" />
        <Setter Property="HeightRequest" Value="30" />
        <Setter Property="MinimumWidthRequest" Value="30" />
        <Setter Property="MinimumHeightRequest" Value="30" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="10" />
    </Style>

    <Style x:Key="CatalogCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CatalogWhite}" />
        <Setter Property="Stroke" Value="{StaticResource CatalogBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Shadow">
            <Shadow Brush="#14000000" Offset="0,2" Radius="8" Opacity="1" />
        </Setter>
    </Style>

    <Style x:Key="CatalogMetricCard" TargetType="Border" BasedOn="{StaticResource CatalogCard}">
        <Setter Property="Padding" Value="8" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Shadow">
            <Shadow Brush="#0A101828" Offset="0,1" Radius="2" Opacity="1" />
        </Setter>
    </Style>

    <Style x:Key="CatalogInputBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CatalogWhite}" />
        <Setter Property="Stroke" Value="{StaticResource CatalogBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
    </Style>

    <Style x:Key="CatalogTextAreaBorder" TargetType="Border" BasedOn="{StaticResource CatalogInputBorder}">
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="CatalogInput" TargetType="Entry">
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="TextColor" Value="{StaticResource CatalogTextMain}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource CatalogTextLight}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="CatalogEditor" TargetType="Editor">
        <Setter Property="MinimumHeightRequest" Value="96" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="TextColor" Value="{StaticResource CatalogTextMain}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource CatalogTextLight}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="CatalogDivider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource CatalogBorder}" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>

</ResourceDictionary>
