<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:tmr_mobile.Converters"
             x:Class="tmr_mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
            <converters:LiderInicialConverter x:Key="LiderInicialConverter" />
            <converters:EstadoColorConverter x:Key="EstadoColorConverter" />
            <converters:EstadoTextColorConverter x:Key="EstadoTextColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
