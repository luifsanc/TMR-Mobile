<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="tmr_mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:tmr_mobile.Views.Auth"
    xmlns:home="clr-namespace:tmr_mobile.Views.Home"
    xmlns:dash="clr-namespace:tmr_mobile.Views.Dashboard"
    xmlns:shared="clr-namespace:tmr_mobile.Views.Shared"
    Title="TMR Móvil"
    FlyoutBehavior="Disabled">

    <Shell.Resources>
        <ResourceDictionary>
            <Style TargetType="ContentPage">
                <Setter Property="Shell.NavBarIsVisible" Value="False" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Ruta de Autenticación -->
    <ShellItem Route="LoginPage">
        <ShellContent ContentTemplate="{DataTemplate auth:LoginPage}" />
    </ShellItem>

    <!-- Dashboard original -->
    <ShellContent Route="dashboard" ContentTemplate="{DataTemplate dash:DashboardPage}" />

    <!-- Home Principal (el Grid 2x4) -->
    <ShellContent Route="home" ContentTemplate="{DataTemplate home:HomePage}" />
    
</Shell>
