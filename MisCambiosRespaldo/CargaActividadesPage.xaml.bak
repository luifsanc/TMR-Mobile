<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:tmr_mobile.ViewModels"
             x:Class="tmr_mobile.Views.TimeReport.CargaActividadesPage"
             x:DataType="vm:CargaActividadesViewModel"
             Title="{Binding Title}">

    <VerticalStackLayout Spacing="20" Padding="24" VerticalOptions="Center">
        <Label Text="Carga de Actividades por Excel"
               FontSize="20"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Label Text="Selecciona una plantilla .xlsx para procesar masivamente los partes de horas."
               FontSize="14"
               TextColor="#64748B"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />

        <Button Text="ðŸ“ Seleccionar Archivo Excel"
                Command="{Binding SeleccionarArchivoCommand}"
                BackgroundColor="#0284C7"
                TextColor="White"
                HeightRequest="50"
                CornerRadius="8" />

        <Label Text="{Binding ArchivoSeleccionado}"
               FontSize="13"
               FontAttributes="Italic"
               HorizontalOptions="Center"
               TextColor="#475569" />
    </VerticalStackLayout>

</ContentPage>
